{{define "org_head"}}
<div class="page-head">
  <div>
    <div class="eyebrow" data-org-name>{{.Me.OrganizationName}}</div>
    <h1>Organização</h1>
    {{with .Org}}<p class="lede" data-org-summary {{if not .Summary}}hidden{{end}}>{{.Summary}}</p>{{end}}
  </div>
</div>
{{if .IsAdmin}}
<nav class="tabs" aria-label="Seções da organização">
  <a href="/orgs/{{.OrgID}}/about" {{if eq .Tab "about"}}aria-current="page"{{end}}>{{template "icon" "building"}} Sobre</a>
  <a href="/orgs/{{.OrgID}}/people" {{if eq .Tab "people"}}aria-current="page"{{end}}>{{template "icon" "users"}} Colaboradores</a>
  <a href="/orgs/{{.OrgID}}/customers" {{if eq .Tab "customers"}}aria-current="page"{{end}}>{{template "icon" "handshake"}} Clientes</a>
  <a href="/orgs/{{.OrgID}}/projects" {{if eq .Tab "projects"}}aria-current="page"{{end}}>{{template "icon" "diagram-project"}} Projetos</a>
</nav>
{{end}}
{{end}}
