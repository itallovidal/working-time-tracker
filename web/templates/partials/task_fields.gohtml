{{/* task_fields são os campos de uma tarefa nova, em duas etapas, no modal Nova tarefa: a etapa 1 é o nome e a
     descrição (em Markdown, com pré-visualização) e a etapa 2, o prazo, a prioridade, as etiquetas e o responsável
     (a etapa 3, Integrações, é de task_publish). As duas etapas ficam na página, e a que não está à vista só é
     escondida: o HTML inicial tem todos os campos. Pede o rascunho em `draft`, o mixin taskWizard (step, mdView,
     next, back...) e labelTools. Editar uma tarefa não passa por aqui: o nome e a descrição (task_text) e os
     detalhes (task_assignee, task_status...) têm cada um o seu modal, na página da tarefa. */}}
{{define "task_fields"}}
<ol class="wizard-steps" aria-label="{{.T "tasks.wizard.label"}}">
  <li :class="step === 1 && 'current'" :aria-current="step === 1 ? 'step' : false"><span class="n">1</span> {{.T "tasks.wizard.step_task"}}</li>
  <li :class="step === 2 && 'current'" :aria-current="step === 2 ? 'step' : false"><span class="n">2</span> {{.T "tasks.wizard.step_details"}}</li>
  {{/* A etapa Integrações só existe ao criar uma tarefa num projeto com integração ativa (publishStep). */}}
  <li x-cloak x-show="publishStep" :class="step === 3 && 'current'" :aria-current="step === 3 ? 'step' : false"><span class="n">3</span> {{.T "tasks.wizard.step_integrations"}}</li>
</ol>

<div class="stack" x-show="step === 1">
  {{template "task_text" .}}
</div>

<div class="stack" x-show="step === 2">
  <div class="field">
    {{template "field_label" (dict "D" . "For" "task-deadline" "Key" "tasks.col_deadline" "Optional" true)}}
    <span class="date-input"><input id="task-deadline" type="text" data-field="deadline" x-date="draft.deadline" @input="clearField('deadline')"
           :aria-invalid="fieldErrors.deadline ? 'true' : 'false'">{{template "date_picker" .}}</span>
    {{template "field_error" "deadline"}}
    <span class="hint">{{.T "tasks.deadline_hint"}}</span>
  </div>
  {{template "task_attrs" .}}
  {{/* No modo solo a organização é uma pessoa só: a tarefa nova é sua (openCreate começa em assign: 'me'), e não há
       o que escolher. */}}
  {{if not .Me.OrganizationSolo}}
  {{template "task_assignee" .}}
  {{end}}
</div>
{{end}}

{{/* task_text é o nome e a descrição de uma tarefa, esta em Markdown com Escrever e Pré-visualizar. Pede
     `draft` (name, description), o mixin WTT.form (fieldErrors) e o mixin mdTools (mdView, setMd, previewHTML). */}}
{{define "task_text"}}
<div class="field">
  <label for="task-name">{{.T "common.name"}}</label>
  <input id="task-name" type="text" maxlength="{{limit "task_name"}}" data-field="name" x-model="draft.name" @input="clearField('name')"
         data-autofocus :aria-invalid="fieldErrors.name ? 'true' : 'false'">
  {{template "field_error" "name"}}
</div>
<div class="field">
  <div class="md-head">
    {{template "field_label" (dict "D" . "For" "task-description" "Key" "common.description_label" "Optional" true)}}
    {{/* Escrever e Pré-visualizar: a mesma trilha das visões da aba Colaboradores. */}}
    <div class="segmented" role="tablist" aria-label="{{.T "tasks.md.label"}}"
         @keydown.arrow-right.prevent="setMd('preview', true)" @keydown.arrow-left.prevent="setMd('write', true)">
      <button type="button" role="tab" id="md-write-tab" aria-controls="task-description" x-ref="mdWrite"
              :aria-selected="(mdView === 'write').toString()" :tabindex="mdView === 'write' ? 0 : -1"
              @click="setMd('write')">{{template "icon" "pen"}} {{.T "tasks.md.write"}}</button>
      <button type="button" role="tab" id="md-preview-tab" aria-controls="task-preview" x-ref="mdPreview"
              :aria-selected="(mdView === 'preview').toString()" :tabindex="mdView === 'preview' ? 0 : -1"
              @click="setMd('preview')">{{template "icon" "eye"}} {{.T "tasks.md.preview"}}</button>
    </div>
  </div>
  {{/* Sem maxlength de propósito: ele cortaria em silêncio o que fosse colado. O contador mostra o tamanho
       como o servidor conta, e quem confere é a regra da descrição (taskDescriptionRule em project.js). */}}
  <textarea id="task-description" rows="8" data-field="description" x-show="mdView === 'write'"
            x-model="draft.description" @input="clearField('description')" :aria-invalid="fieldErrors.description ? 'true' : 'false'"></textarea>
  <span class="hint num" :class="{ 'is-bad': descriptionLength() > {{limit "task_description"}} }"
        x-text="descriptionLength() + '/{{limit "task_description"}}'"></span>
  {{template "field_error" "description"}}
  <div id="task-preview" class="md-preview" role="tabpanel" aria-labelledby="md-preview-tab" x-show="mdView === 'preview'">
    <div class="markdown" x-show="draft.description.trim()" x-html="previewHTML()"></div>
    <p class="muted small" x-show="!draft.description.trim()">{{.T "tasks.md.empty"}}</p>
  </div>
  <span class="hint">{{.T "tasks.md.hint"}}</span>
</div>
{{end}}

{{/* task_required é a trava dos responsáveis (Decisão 30): só quem tem conta na plataforma pode ser responsável. As
     caixas são as plataformas com conta das integrações do projeto; a tarefa importada de uma issue já vem com a dela
     marcada. Some sem integração do GitHub ou do GitLab, e no modo solo, em que a pessoa é uma só. Pede
     `draft.required_accounts` e requirablePlatforms() (requiredTools). */}}
{{define "task_required"}}
{{if not .Me.OrganizationSolo}}
<div class="field" role="group" aria-labelledby="task-required-label" x-show="requirablePlatforms().length > 0">
  <span class="field-label" id="task-required-label">{{.T "tasks.required.label"}}</span>
  <template x-for="p in requirablePlatforms()" :key="p">
    <label class="toggle"><input type="checkbox" :value="p" x-model="draft.required_accounts" @change="clearField('assignee_ids')">
      <span x-text="$t('tasks.required.only', { platform: WTT.accounts.name(p) })"></span></label>
  </template>
  {{template "field_error" "required_accounts"}}
  <span class="hint">{{.T "tasks.required.hint"}}</span>
</div>
{{end}}
{{end}}

{{/* task_assignee é o responsável de uma tarefa nova (e o do Editar detalhes no modo solo): atribuir a mim e sem
     responsável são o que quase sempre se quer. "Escolher pessoas" abre a lista do projeto e é só do admin dele: numa
     tarefa livre, os outros só a pegam para si (Decisão 31). No modo solo não há outra pessoa. Pede `draft` (assign,
     assignee_ids), fieldErrors (WTT.form), meMissing() (requiredTools) e os de assigneePicker. */}}
{{define "task_assignee"}}
{{template "task_required" .}}
<div class="field" role="radiogroup" aria-labelledby="task-assign-label">
  <span class="field-label" id="task-assign-label">{{.T "tasks.col_assignee"}}</span>
  <label class="toggle"><input type="radio" name="task-assign" value="me" x-model="draft.assign"> {{.T "tasks.assign_me"}}</label>
  <label class="toggle"><input type="radio" name="task-assign" value="none" x-model="draft.assign"> {{.T "tasks.unassigned"}}</label>
  {{if not .Me.OrganizationSolo}}
  <label class="toggle" x-show="manageAssignees()"><input type="radio" name="task-assign" value="people" x-model="draft.assign"> {{.T "tasks.assign_people"}}</label>
  <div x-show="draft.assign === 'people'">{{template "task_assignee_picker" .}}</div>
  <span class="hint" x-cloak x-show="draft.assign === 'me' && meMissing()" x-text="$t('tasks.required.me_without', { platforms: meMissing() })"></span>
  {{end}}
  {{template "field_error" "assignee_ids"}}
  <span class="hint" x-show="draft.assign === 'none'">{{if .Me.OrganizationSolo}}{{.T "tasks.unassigned_hint_solo"}}{{else}}{{.T "tasks.unassigned_hint"}}{{end}}</span>
</div>
{{end}}

{{/* task_assignees_edit são os responsáveis no Editar detalhes de uma tarefa da equipe: a trava e a lista de pessoas,
     cada uma com a caixa que a regra deixa mexer (assigneePicker.canPick). Quem não muda nada na lista só a vê. */}}
{{define "task_assignees_edit"}}
{{template "task_required" .}}
<div class="field">
  <span class="field-label">{{.T "tasks.assignees.label"}}</span>
  {{template "task_assignee_picker" .}}
  {{template "field_error" "assignee_ids"}}
  <span class="hint" x-show="pickHint()" x-text="pickHint()"></span>
</div>
{{end}}

{{/* task_assignee_picker é a lista de pessoas do projeto com uma caixa cada, e a busca quando são muitas. A caixa que
     não muda fica desligada, e quem não tem a conta da trava diz o que falta (memberLabel). */}}
{{define "task_assignee_picker"}}
<input type="search" placeholder="{{.T "collab.search_placeholder"}}" autocomplete="off" x-show="members.length > 6"
       x-model="pickSearch" @keydown.enter.prevent aria-label="{{.T "tasks.assignees.search"}}">
<ul class="list picker" role="group" aria-label="{{.T "tasks.assignees.label"}}" data-field="assignee_ids">
  <template x-for="m in pickPeople()" :key="m.id">
    <li>
      <label class="pick">
        <input type="checkbox" :checked="picked(m)" :disabled="!canPick(m)" @change="togglePick(m, $event.target.checked)">
        <span class="avatar" aria-hidden="true" x-text="WTT.fmt.initials(m.name)"></span>
        <span class="grow">
          <span><span x-text="memberLabel(m)"></span><span class="muted nowrap" x-show="m.id === WTT.boot.me.id"> · {{.T "tasks.assignees.you"}}</span></span>
          <span class="muted small" x-text="m.email"></span>
        </span>
      </label>
    </li>
  </template>
</ul>
<p class="muted small" x-show="pickPeople().length === 0">{{.T "collab.no_match_project"}}</p>
{{end}}
