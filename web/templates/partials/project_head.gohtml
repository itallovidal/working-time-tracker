{{define "project_head"}}
<div class="page-head">
  <div>
    <div class="eyebrow"><a href="/orgs/{{.OrgID}}">Projetos</a></div>
    <h1 data-project-name>{{.Project.Name}}</h1>
  </div>
</div>
<nav class="tabs" aria-label="Seções do projeto">
  <a href="/projects/{{.Project.ID}}/tasks" {{if eq .Tab "tasks"}}aria-current="page"{{end}}>{{template "icon" "list-check"}} Tarefas</a>
  <a href="/projects/{{.Project.ID}}/time-tracking" {{if eq .Tab "time"}}aria-current="page"{{end}}>{{template "icon" "clock"}} Ponto</a>
  <a href="/projects/{{.Project.ID}}/teams" {{if eq .Tab "teams"}}aria-current="page"{{end}}>{{template "icon" "people-group"}} Colaboradores</a>
  <a href="/projects/{{.Project.ID}}/integrations" {{if eq .Tab "integrations"}}aria-current="page"{{end}}>{{template "icon" "plug"}} Integrações</a>
  <a href="/projects/{{.Project.ID}}/settings" {{if eq .Tab "settings"}}aria-current="page"{{end}}>{{template "icon" "gear"}} Configurações</a>
</nav>
{{end}}
