{{define "project_head"}}
<div class="page-head">
  <div>
    <div class="eyebrow"><a href="/orgs/{{.OrgID}}/projects">{{.T "project.head.projects"}}</a></div>
    <h1 data-project-name>{{.Project.Name}}</h1>
  </div>
</div>
{{/* As abas vêm de page.Data.ProjectTabs, que decide num lugar só quais aparecem, onde cada uma mora (fora ou dentro
     da Gestão, conforme o modo) e qual está aberta. */}}
<nav class="tabs" aria-label="{{.T "project.head.sections"}}">
  {{- range .ProjectTabs}}
  <a {{if .End}}class="tabs-end" {{end}}href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{template "icon" .Icon}} {{$.T .Label}}</a>
  {{- end}}
</nav>
{{end}}
