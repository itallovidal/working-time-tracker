{{define "project_head"}}
<div class="page-head">
  <div>
    <div class="eyebrow"><a href="/orgs/{{.OrgID}}">Projetos</a></div>
    <h1 data-project-name>{{.Project.Name}}</h1>
  </div>
</div>
<nav class="tabs" aria-label="Seções do projeto">
  <a href="/projects/{{.Project.ID}}/teams" {{if eq .Tab "teams"}}aria-current="page"{{end}}>Times</a>
  <a href="/projects/{{.Project.ID}}/settings" {{if eq .Tab "settings"}}aria-current="page"{{end}}>Configurações</a>
</nav>
{{end}}
