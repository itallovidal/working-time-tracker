{{define "project_head"}}
<div class="page-head">
  <div>
    <div class="eyebrow"><a href="/orgs/{{.OrgID}}">{{.T "project.head.projects"}}</a></div>
    <h1 data-project-name>{{.Project.Name}}</h1>
  </div>
</div>
<nav class="tabs" aria-label="{{.T "project.head.sections"}}">
  {{if .Management}}
  {{/* A Gestão soma o dinheiro do projeto e mexe nas pessoas, nas integrações e nos dados dele: só admins entram. */}}
  <a href="/projects/{{.Project.ID}}/management/overview" {{if eq .Tab "overview"}}aria-current="page"{{end}}>{{template "icon" "chart-simple"}} {{.T "project.head.overview"}}</a>
  <a href="/projects/{{.Project.ID}}/management/teams" {{if eq .Tab "teams"}}aria-current="page"{{end}}>{{template "icon" "people-group"}} {{.T "project.head.teams"}}</a>
  <a href="/projects/{{.Project.ID}}/management/integrations" {{if eq .Tab "integrations"}}aria-current="page"{{end}}>{{template "icon" "plug"}} {{.T "project.head.integrations"}}</a>
  <a href="/projects/{{.Project.ID}}/management/settings" {{if eq .Tab "settings"}}aria-current="page"{{end}}>{{template "icon" "gear"}} {{.T "project.head.settings"}}</a>
  <a class="tabs-end" href="/projects/{{.Project.ID}}/overview">{{template "icon" "arrow-left"}} {{.T "project.head.back"}}</a>
  {{else}}
  <a href="/projects/{{.Project.ID}}/overview" {{if eq .Tab "overview"}}aria-current="page"{{end}}>{{template "icon" "house"}} {{.T "project.head.home"}}</a>
  <a href="/projects/{{.Project.ID}}/my-tasks" {{if eq .Tab "mine"}}aria-current="page"{{end}}>{{template "icon" "user-check"}} {{.T "project.head.my_tasks"}}</a>
  <a href="/projects/{{.Project.ID}}/tasks" {{if eq .Tab "tasks"}}aria-current="page"{{end}}>{{template "icon" "list-check"}} {{.T "project.head.tasks"}}</a>
  <a href="/projects/{{.Project.ID}}/collaborators" {{if eq .Tab "teams"}}aria-current="page"{{end}}>{{template "icon" "people-group"}} {{.T "project.head.teams"}}</a>
  {{if .Access.Manages}}<a class="tabs-end" href="/projects/{{.Project.ID}}/management">{{template "icon" "sliders"}} {{.T "project.head.management"}}</a>{{end}}
  {{end}}
</nav>
{{end}}
