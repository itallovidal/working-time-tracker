{{/* Os termos do cliente que valem para o período (modo solo): a mensalidade, a estimativa de horas e o contrato (só no mensal), o ciclo (só no
     por hora: mensal ou a cada 14 dias), o fechamento (o dia do mês no ciclo mensal, ou o último fechamento já pago no de
     14 dias), o prazo (nos dois modos) e, recolhidos, a multa, os juros e a tolerância (só no mensal). Aparecem no modal de cliente,
     junto com o modo e o valor por hora: a cobrança mora no cliente (Decisão 21). O componente que inclui traz o objeto
     dos termos (blankBilling/billingDraft em pages/org.js), lateOpen e o mixin WTT.form (fieldErrors, clearField).
     Parâmetros: Data (a página), Model (o nome do objeto dos termos no componente) e Id (o prefixo dos ids dos campos).
     Os data-field são os nomes da API, para o erro do servidor cair embaixo do campo. */}}
{{define "customer_contract"}}
{{/* Um campo por linha, cada um com a sua dica embaixo: em pares, os rótulos com "(opcional)" quebravam em alturas
     diferentes e os campos desalinhavam. */}}
{{$m := .Model}}{{$id := .Id}}
{{with .Data}}
<div class="stack" x-show="{{$m}}.billing_mode === 'monthly'">
  <div class="field">
    <label for="{{$id}}-monthly-fee"><span x-text="$t('customer.billing.monthly_fee', { unit: WTT.fmt.moneyUnit() })"></span></label>
    <input id="{{$id}}-monthly-fee" type="text" inputmode="decimal" class="num" data-field="monthly_fee_cents" x-model="{{$m}}.monthly_fee" @input="clearField('monthly_fee_cents')" :aria-invalid="fieldErrors.monthly_fee_cents ? 'true' : 'false'">
    {{template "field_error" "monthly_fee_cents"}}
  </div>
  {{/* Só acompanhamento (Decisão 26): as horas do período do contrato contra esta estimativa, sem mudar a cobrança. */}}
  <div class="field">
    {{template "field_label" (dict "D" . "For" (printf "%s-estimated-hours" $id) "Key" "customer.billing.estimated_hours" "Optional" true)}}
    <input id="{{$id}}-estimated-hours" type="number" inputmode="numeric" min="1" max="{{limit "monthly_hours"}}" step="1" class="num" data-field="estimated_monthly_hours" x-model="{{$m}}.estimated_hours" @input="clearField('estimated_monthly_hours')" :aria-invalid="fieldErrors.estimated_monthly_hours ? 'true' : 'false'">
    {{template "field_error" "estimated_monthly_hours"}}
    <span class="hint">{{.T "customer.billing.estimated_hours_hint"}}</span>
  </div>
  <div class="field">
    <label for="{{$id}}-contract-start">{{.T "customer.billing.contract_start"}}</label>
    <span class="date-input"><input id="{{$id}}-contract-start" type="text" data-field="contract_start" x-date="{{$m}}.contract_start" @input="clearField('contract_start')" :aria-invalid="fieldErrors.contract_start ? 'true' : 'false'">{{template "date_picker" .}}</span>
    {{template "field_error" "contract_start"}}
  </div>
  <div class="field">
    {{template "field_label" (dict "D" . "For" (printf "%s-contract-end" $id) "Key" "customer.billing.contract_end" "Optional" true)}}
    <span class="date-input"><input id="{{$id}}-contract-end" type="text" data-field="contract_end" x-date="{{$m}}.contract_end" @input="clearField('contract_end')" :aria-invalid="fieldErrors.contract_end ? 'true' : 'false'">{{template "date_picker" .}}</span>
    {{template "field_error" "contract_end"}}
    <span class="hint">{{.T "customer.billing.contract_end_hint"}}</span>
  </div>
</div>

{{/* O ciclo é do por hora: o contrato mensal fecha sempre no dia do mês. O de 14 dias é o bi-weekly dos EUA, contado a
     partir do último fechamento que o cliente já pagou; no lugar do dia do mês, a tela pede esse dia. */}}
<div class="field" x-show="{{$m}}.billing_mode === 'hourly'">
  <label for="{{$id}}-billing-cycle">{{.T "customer.billing.cycle"}}</label>
  <select id="{{$id}}-billing-cycle" data-field="billing_cycle" x-model="{{$m}}.billing_cycle" @change="clearField('billing_cycle'); clearField('cycle_anchor'); clearField('closing_day')" :aria-invalid="fieldErrors.billing_cycle ? 'true' : 'false'">
    <option value="monthly">{{.T "customer.billing.cycle_monthly"}}</option>
    <option value="biweekly">{{.T "customer.billing.cycle_biweekly"}}</option>
  </select>
  {{template "field_error" "billing_cycle"}}
</div>
<div class="field" x-show="{{$m}}.billing_mode === 'hourly' && {{$m}}.billing_cycle === 'biweekly'">
  <label for="{{$id}}-cycle-anchor">{{.T "customer.billing.cycle_anchor"}}</label>
  <span class="date-input"><input id="{{$id}}-cycle-anchor" type="text" data-field="cycle_anchor" x-date="{{$m}}.cycle_anchor" @input="clearField('cycle_anchor')" :aria-invalid="fieldErrors.cycle_anchor ? 'true' : 'false'">{{template "date_picker" .}}</span>
  {{template "field_error" "cycle_anchor"}}
  <span class="hint">{{.T "customer.billing.cycle_anchor_hint"}}</span>
</div>
<div class="field" x-show="{{$m}}.billing_mode === 'monthly' || {{$m}}.billing_cycle !== 'biweekly'">
  <label for="{{$id}}-closing-day">{{.T "customer.billing.closing_day"}}</label>
  <input id="{{$id}}-closing-day" type="number" min="1" max="31" step="1" class="num" data-field="closing_day" x-model="{{$m}}.closing_day" @input="clearField('closing_day')" :aria-invalid="fieldErrors.closing_day ? 'true' : 'false'">
  {{template "field_error" "closing_day"}}
  <span class="hint">{{.T "customer.billing.closing_day_hint"}}</span>
</div>
<div class="field">
  <label for="{{$id}}-payment-days">{{.T "customer.billing.payment_days"}}</label>
  <input id="{{$id}}-payment-days" type="number" min="0" max="{{limit "term_days"}}" step="1" class="num" data-field="payment_days" x-model="{{$m}}.payment_days" @input="clearField('payment_days')" :aria-invalid="fieldErrors.payment_days ? 'true' : 'false'">
  {{template "field_error" "payment_days"}}
  <span class="hint">{{.T "customer.billing.payment_days_hint"}}</span>
</div>

{{/* Multa, juros e tolerância ficam recolhidos: quase todo cliente é cobrado sem eles. */}}
<details class="form-fold" x-show="{{$m}}.billing_mode === 'monthly'" :open="lateOpen" @toggle="lateOpen = $event.target.open">
  <summary>{{.T "customer.billing.late_title"}}</summary>
  <div class="stack">
    <p class="hint">{{.T "customer.billing.late_hint"}}</p>
    <div class="field">
      {{template "field_label" (dict "D" . "For" (printf "%s-late-fee" $id) "Key" "customer.billing.late_fee" "Optional" true)}}
      <input id="{{$id}}-late-fee" type="text" inputmode="decimal" class="num" placeholder="0" data-field="late_fee_bp" x-model="{{$m}}.late_fee" @input="clearField('late_fee_bp')" :aria-invalid="fieldErrors.late_fee_bp ? 'true' : 'false'">
      {{template "field_error" "late_fee_bp"}}
    </div>
    <div class="field">
      {{template "field_label" (dict "D" . "For" (printf "%s-late-interest" $id) "Key" "customer.billing.late_interest" "Optional" true)}}
      <input id="{{$id}}-late-interest" type="text" inputmode="decimal" class="num" placeholder="0" data-field="late_interest_bp_month" x-model="{{$m}}.late_interest" @input="clearField('late_interest_bp_month')" :aria-invalid="fieldErrors.late_interest_bp_month ? 'true' : 'false'">
      {{template "field_error" "late_interest_bp_month"}}
    </div>
    <div class="field">
      {{template "field_label" (dict "D" . "For" (printf "%s-grace-days" $id) "Key" "customer.billing.grace_days" "Optional" true)}}
      <input id="{{$id}}-grace-days" type="number" min="0" max="{{limit "term_days"}}" step="1" class="num" placeholder="0" data-field="grace_days" x-model="{{$m}}.grace_days" @input="clearField('grace_days')" :aria-invalid="fieldErrors.grace_days ? 'true' : 'false'">
      {{template "field_error" "grace_days"}}
    </div>
  </div>
</details>
{{end}}
{{end}}
