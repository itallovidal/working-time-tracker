{{/* O formulário de novo projeto, da página Projetos. Aparece no modal do layout base e continua no escopo
   do componente que o inclui, que traz draft, customers, errors, pending, openCreate e create. */}}
{{define "project_form"}}
{{if .IsAdmin}}
  <template x-teleport="#modal-root">
    <form class="stack" novalidate x-show="$store.modal.name === 'project'" @submit.prevent="create()">
      <fieldset class="form-group">
        <legend>{{.T "project.groups.about"}}</legend>
        <div class="field">
          <label for="project-name">{{.T "common.name"}}</label>
          <input id="project-name" type="text" maxlength="{{limit "name"}}" data-field="name" x-model="draft.name" @input="clearField('name')"
                 :aria-invalid="fieldErrors.name ? 'true' : 'false'" data-autofocus>
          {{template "field_error" "name"}}
        </div>
        <div class="field">
          {{template "field_label" (dict "D" . "For" "project-description" "Key" "common.description_label" "Optional" true)}}
          <textarea id="project-description" maxlength="{{limit "description"}}" data-field="description" x-model="draft.description"
                    @input="clearField('description')" :aria-invalid="fieldErrors.description ? 'true' : 'false'"></textarea>
          <span class="hint num" x-text="Array.from(draft.description).length + '/{{limit "description"}}'"></span>
          {{template "field_error" "description"}}
        </div>
      </fieldset>
      {{/* O cliente e o acréscimo são dinheiro do dono: o admin cria só projeto interno, e o dono converte. */}}
      {{if .IsOwner}}
      <fieldset class="form-group">
        <legend>{{.T "project.groups.billing"}}</legend>
        <div class="field">
          <label for="project-customer">{{.T "org.projects.customer"}}</label>
          <select id="project-customer" data-field="customer_id" x-model="draft.customer_id" @change="customerChanged()"
                  :aria-invalid="fieldErrors.customer_id ? 'true' : 'false'">
            <option value="">{{.T "org.projects.internal"}}</option>
            <template x-for="c in customers || []" :key="c.id">
              <option :value="c.id" x-text="customerOption(c)"></option>
            </template>
          </select>
          {{template "field_error" "customer_id"}}
        </div>
        {{template "project_billing_fields" (dict "Data" . "Id" "project" "Customer" "customerOf()")}}
        {{template "project_customer_meeting" .}}
        <span class="hint">{{if .Me.OrganizationSolo}}{{.T "org.projects.admins_only_hint_solo"}}{{else}}{{.T "org.projects.admins_only_hint"}}{{end}}</span>
      </fieldset>
      {{end}}
      <fieldset class="form-group">
        <legend>{{if .Me.OrganizationSolo}}{{.T "project.groups.routine_solo"}}{{else}}{{.T "project.groups.routine"}}{{end}}</legend>
        <div class="field">
          <label for="project-sprint">{{.T "project.fields.sprint"}}</label>
          <select id="project-sprint" data-field="sprint_duration_days" x-model.number="draft.sprint_duration_days"
                  @change="clearField('sprint_duration_days')" :aria-invalid="fieldErrors.sprint_duration_days ? 'true' : 'false'">
            <template x-for="o in WTT.sprintOptions" :key="o.value">
              <option :value="o.value" x-text="o.label" :selected="o.value === draft.sprint_duration_days"></option>
            </template>
          </select>
          {{template "field_error" "sprint_duration_days"}}
        </div>
        {{template "project_routine" .}}
      </fieldset>
      <p class="form-error" x-show="errors.create" x-text="errors.create" role="alert"></p>
      <div class="row row-end">
        <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
        <button type="submit" class="btn" :disabled="pending">{{.T "org.projects.create"}}</button>
      </div>
    </form>
  </template>
  {{end}}
{{end}}

{{/* project_billing_fields é a cobrança de um projeto com cliente, no formulário de novo projeto e nas configurações. A
   cobrança mora no cliente (Decisão 21): aqui ela aparece só para leitura, com o link para Clientes, e o projeto só
   soma um acréscimo, por hora no cliente por hora e por mês no mensal, com o total ao vivo. O cliente por hora antigo,
   sem valor, mostra o aviso. O componente que inclui traz draft.extra, billing (WTT.billing) e o mixin WTT.form.
   Parâmetros: Data (a página), Id (o prefixo do id do campo) e Customer (a expressão do cliente escolhido). */}}
{{define "project_billing_fields"}}
{{$id := .Id}}{{$c := .Customer}}
{{with .Data}}
<div class="stack" x-cloak x-show="{{$c}}">
  <dl class="facts">
    <div class="fact">
      <dt>{{.T "project.billing.customer_terms"}}</dt>
      <dd><span x-text="billing.customer({{$c}})"></span> · <a href="/orgs/{{.OrgID}}/customers">{{.T "project.billing.edit_in_customers"}}</a></dd>
    </div>
  </dl>
  <p class="form-error" x-show="billing.withoutRate({{$c}})">{{.T "project.billing.customer_without_rate"}}</p>
  <div class="field" x-show="!billing.withoutRate({{$c}})">
    <label for="{{$id}}-bill-extra">
      <span x-text="billing.extraLabel({{$c}})"></span> <span class="optional">{{.T "common.optional_label"}}</span>
    </label>
    <input id="{{$id}}-bill-extra" type="text" inputmode="decimal" class="num" placeholder="0" data-field="bill_extra_cents" x-model="draft.extra"
           @input="clearField('bill_extra_cents')" :aria-invalid="fieldErrors.bill_extra_cents ? 'true' : 'false'">
    {{template "field_error" "bill_extra_cents"}}
    <span class="hint" x-text="billing.monthly({{$c}}) ? $t('project.billing.extra_monthly_hint') : $t('project.billing.extra_hourly_hint')"></span>
    <span class="hint num" x-text="billing.total({{$c}}, draft.extra)"></span>
  </div>
</div>
{{end}}
{{end}}
