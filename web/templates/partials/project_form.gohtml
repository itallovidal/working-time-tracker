{{/* O formulário de novo projeto, para a página inicial e para a aba Projetos. Aparece no modal do layout
   base e continua no escopo do componente que o inclui, que traz draft, customers, errors, pending,
   openCreate e create. */}}
{{define "project_form"}}
{{if .Can "projects.create"}}
  <template x-teleport="#modal-root">
    <form class="stack" x-show="$store.modal.name === 'project'" @submit.prevent="create()">
      <fieldset class="form-group">
        <legend>{{.T "project.groups.about"}}</legend>
        <div class="field">
          <label for="project-name">{{.T "common.name"}}</label>
          <input id="project-name" type="text" required x-model="draft.name" data-autofocus>
        </div>
        <div class="field">
          <label for="project-description">{{.T "common.description_label"}}</label>
          <textarea id="project-description" x-model="draft.description" placeholder="{{.T "common.optional"}}"></textarea>
        </div>
      </fieldset>
      <fieldset class="form-group">
        <legend>{{.T "project.groups.billing"}}</legend>
        <div class="fields">
          <div class="field">
            <label for="project-customer">{{.T "org.projects.customer"}}</label>
            <select id="project-customer" x-model="draft.customer_id">
              <option value="">{{.T "org.projects.internal"}}</option>
              <template x-for="c in customers || []" :key="c.id">
                <option :value="c.id" x-text="c.name"></option>
              </template>
            </select>
          </div>
          {{/* Projeto interno não tem quem pague: o valor só aparece com um cliente escolhido. */}}
          <div class="field" x-show="draft.customer_id">
            <label for="project-bill-rate" x-text="$t('project.fields.bill_rate', { unit: WTT.fmt.moneyUnit() })"></label>
            <input id="project-bill-rate" type="text" inputmode="decimal" class="num" placeholder="{{.T "common.optional"}}" x-model="draft.rate">
          </div>
        </div>
        {{template "project_customer_meeting" .}}
        <span class="hint">{{.T "org.projects.admins_only_hint"}}</span>
      </fieldset>
      <fieldset class="form-group">
        <legend>{{.T "project.groups.routine"}}</legend>
        <div class="field">
          <label for="project-sprint">{{.T "project.fields.sprint"}}</label>
          <select id="project-sprint" x-model.number="draft.sprint_duration_days">
            <template x-for="o in WTT.sprintOptions" :key="o.value">
              <option :value="o.value" x-text="o.label" :selected="o.value === draft.sprint_duration_days"></option>
            </template>
          </select>
        </div>
        {{template "project_routine" .}}
      </fieldset>
      <p class="form-error" x-show="errors.create" x-text="errors.create" role="alert"></p>
      <div class="row row-end">
        <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
        <button type="submit" class="btn" :disabled="pending">{{.T "org.projects.create"}}</button>
      </div>
    </form>
  </template>
  {{end}}
{{end}}
