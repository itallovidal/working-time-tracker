{{/* O formulário de novo projeto, da página Projetos. Aparece no modal do layout base e continua no escopo
   do componente que o inclui, que traz draft, customers, errors, pending, openCreate e create. */}}
{{define "project_form"}}
{{if .IsAdmin}}
  <template x-teleport="#modal-root">
    <form class="stack" novalidate x-show="$store.modal.name === 'project'" @submit.prevent="create()">
      <fieldset class="form-group">
        <legend>{{.T "project.groups.about"}}</legend>
        <div class="field">
          <label for="project-name">{{.T "common.name"}}</label>
          <input id="project-name" type="text" maxlength="{{limit "name"}}" data-field="name" x-model="draft.name" @input="clearField('name')"
                 :aria-invalid="fieldErrors.name ? 'true' : 'false'" data-autofocus>
          {{template "field_error" "name"}}
        </div>
        <div class="field">
          {{template "field_label" (dict "D" . "For" "project-description" "Key" "common.description_label" "Optional" true)}}
          <textarea id="project-description" maxlength="{{limit "description"}}" data-field="description" x-model="draft.description"
                    @input="clearField('description')" :aria-invalid="fieldErrors.description ? 'true' : 'false'"></textarea>
          <span class="hint num" x-text="Array.from(draft.description).length + '/{{limit "description"}}'"></span>
          {{template "field_error" "description"}}
        </div>
      </fieldset>
      {{/* O cliente e o valor cobrado são dinheiro do dono: o admin cria só projeto interno, e o dono converte. */}}
      {{if .IsOwner}}
      <fieldset class="form-group">
        <legend>{{.T "project.groups.billing"}}</legend>
        <div class="fields">
          <div class="field">
            <label for="project-customer">{{.T "org.projects.customer"}}</label>
            <select id="project-customer" data-field="customer_id" x-model="draft.customer_id" @change="customerChanged()"
                    :aria-invalid="fieldErrors.customer_id ? 'true' : 'false'">
              <option value="">{{.T "org.projects.internal"}}</option>
              <template x-for="c in customers || []" :key="c.id">
                <option :value="c.id" x-text="customerOption(c)"></option>
              </template>
            </select>
            {{template "field_error" "customer_id"}}
          </div>
          {{if .Me.OrganizationSolo}}
          {{/* No modo solo a cobrança se escolhe aqui, mas o modo e o contrato ficam no cliente e valem para todos os
               projetos dele: o rádio começa no modo do cliente, e o do outro modo só se escolhe enquanto o cliente não
               tem projetos (depois disso o servidor trava o modo, customer.mode_locked). */}}
          <div class="field" role="radiogroup" aria-labelledby="project-billing-label" x-cloak x-show="draft.customer_id">
            <span class="field-label" id="project-billing-label">{{.T "customer.billing.title"}}</span>
            <label class="toggle"><input type="radio" name="project-billing" value="hourly" data-field="billing_mode" x-model="billing.billing_mode"
                   :disabled="customerLocked() && billingMode() !== 'hourly'" @change="modeSwitched()"> {{.T "customer.billing.hourly"}}</label>
            <label class="toggle"><input type="radio" name="project-billing" value="monthly" x-model="billing.billing_mode"
                   :disabled="customerLocked() && billingMode() !== 'monthly'" @change="modeSwitched()"> {{.T "customer.billing.monthly_contract"}}</label>
            {{template "field_error" "billing_mode"}}
            <span class="hint" x-show="customerLocked()">{{.T "customer.billing.mode_locked"}}</span>
            <span class="hint" x-show="!customerLocked()">{{.T "customer.billing.project_mode_hint"}}</span>
          </div>
          {{else}}
          {{template "project_rate_field" .}}
          {{end}}
        </div>
        {{if .Me.OrganizationSolo}}
        {{template "project_rate_field" .}}
        {{/* O cliente já é mensal: o contrato dele vale para este projeto e se edita em Clientes. */}}
        <div class="stack" x-cloak x-show="monthlyCustomer() && !modeChanged()">
          <dl class="facts">
            <div class="fact"><dt>{{.T "customer.billing.monthly_contract"}}</dt><dd><span x-text="customerOf() ? billingLabel(customerOf()) : ''"></span><br><span class="muted small" x-text="customerOf() ? billingTerms(customerOf()) : ''"></span></dd></div>
          </dl>
          <a class="small" href="/orgs/{{.OrgID}}/customers">{{.T "customer.billing.project_contract_edit"}}</a>
        </div>
        {{/* O cliente ainda não tem projetos e muda de modo aqui: para mensal, o contrato é preenchido agora e gravado
             no cliente antes de o projeto ser criado (create, em pages/org.js). */}}
        <div class="stack" x-cloak x-show="modeChanged() && billing.billing_mode === 'monthly'">
          <p class="muted small" x-text="$t('customer.billing.project_contract_new', { name: customerOf() ? customerOf().name : '' })"></p>
          {{template "customer_contract" (dict "Data" . "Model" "billing" "Id" "project")}}
        </div>
        <p class="muted small" x-cloak x-show="modeChanged() && billing.billing_mode === 'hourly'" x-text="$t('customer.billing.project_to_hourly', { name: customerOf() ? customerOf().name : '' })"></p>
        {{end}}
        <p class="muted small" x-cloak x-show="monthlyCustomer()" x-text="$t('customer.billing.project_monthly_note')"></p>
        {{template "project_customer_meeting" .}}
        <span class="hint">{{if .Me.OrganizationSolo}}{{.T "org.projects.admins_only_hint_solo"}}{{else}}{{.T "org.projects.admins_only_hint"}}{{end}}</span>
      </fieldset>
      {{end}}
      <fieldset class="form-group">
        <legend>{{if .Me.OrganizationSolo}}{{.T "project.groups.routine_solo"}}{{else}}{{.T "project.groups.routine"}}{{end}}</legend>
        <div class="field">
          <label for="project-sprint">{{.T "project.fields.sprint"}}</label>
          <select id="project-sprint" data-field="sprint_duration_days" x-model.number="draft.sprint_duration_days"
                  @change="clearField('sprint_duration_days')" :aria-invalid="fieldErrors.sprint_duration_days ? 'true' : 'false'">
            <template x-for="o in WTT.sprintOptions" :key="o.value">
              <option :value="o.value" x-text="o.label" :selected="o.value === draft.sprint_duration_days"></option>
            </template>
          </select>
          {{template "field_error" "sprint_duration_days"}}
        </div>
        {{template "project_routine" .}}
      </fieldset>
      <p class="form-error" x-show="errors.create" x-text="errors.create" role="alert"></p>
      <div class="row row-end">
        <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
        <button type="submit" class="btn" :disabled="pending">{{.T "org.projects.create"}}</button>
      </div>
    </form>
  </template>
  {{end}}
{{end}}

{{/* project_rate_field é o valor cobrado por hora do projeto novo. Projeto interno não tem quem pague, e o cliente
     mensal paga o contrato, não as horas: o campo só aparece com um cliente cobrado por hora (hasRate). Ele vem
     preenchido com o valor padrão do cliente (o projeto guarda o seu). */}}
{{define "project_rate_field"}}
<div class="field" x-show="hasRate()">
  <label for="project-bill-rate"><span x-text="$t('project.fields.bill_rate', { unit: WTT.fmt.moneyUnit() })"></span></label>
  <input id="project-bill-rate" type="text" inputmode="decimal" class="num" data-field="bill_rate_cents" x-model="draft.rate"
         @input="rateTouched = true; clearField('bill_rate_cents')" :aria-invalid="fieldErrors.bill_rate_cents ? 'true' : 'false'">
  {{template "field_error" "bill_rate_cents"}}
  <span class="hint" x-cloak x-show="rateFromDefault()" x-text="$t('customer.billing.project_rate_default')"></span>
</div>
{{end}}
