{{/* O cartão de uma tarefa da pessoa, usado nas Suas tarefas do Início e, em andamento, dentro do painel do
     timer (partials/clock_card.gohtml). Vai dentro de um `<template x-for="t in ...">`, e a página tem de ter o
     `taskClock()` de project.js (as cores, o prazo, o Iniciar). O cartão inteiro abre a tarefa; o nome continua um
     link para o teclado e para abrir em outra aba, e o botão Iniciar não abre. De cima para baixo: o nome; o status
     e a prioridade; um respiro; o prazo (só quando há) e o Iniciar, ou o "Em andamento" no lugar dele; uma
     divisória; e as etiquetas. */}}
{{define "task_card"}}
<div class="task-card card-link" @click="if (!$event.target.closest('a, button')) location.href = '/tasks/' + t.id">
  <a class="task-card-name" :href="'/tasks/' + t.id" x-text="t.name"></a>
  <div class="task-card-badges">
    <span class="badge" :class="statusClass(t.status)" x-text="WTT.fmt.taskStatus(t.status)"></span>
    <span class="badge" :class="priorityClass(t.priority)" x-text="WTT.fmt.priority(t.priority)"></span>
    <span class="badge" x-show="hasExternal(t)" x-text="externalLabel(t)"></span>
  </div>
  <div class="task-card-bottom">
    <span class="badge num" :class="cardDeadlineClass(t)" x-show="hasDeadline(t)">{{template "icon" "calendar-day"}} <span x-text="cardDeadlineLabel(t)"></span></span>
    {{/* Em andamento (só dentro do painel do timer, que já diz "Em andamento"), o botão para só esta tarefa ocupa o lugar do Iniciar. */}}
    <button type="button" class="btn btn-secondary btn-sm task-card-go" x-show="isRunning(t)"
            :disabled="pending" :aria-label="$t('session.stop_task_label', { name: t.name })" title="{{.T "session.stop_task_hint"}}" @click="stopTask(t)">{{template "icon" "stop"}} {{.T "session.stop_task"}}</button>
    {{/* Com o ponto aberto neste projeto, o botão põe a tarefa na sessão; com ele aberto em outro, fica desabilitado. */}}
    <button type="button" class="btn btn-sm task-card-go" x-show="!isRunning(t)"
            :disabled="pending || noRate() || !$store.clock.ready || (!!$store.clock.session && !sessionHere())" @click="startTask(t)">{{template "icon" "play"}} <span x-text="sessionHere() ? $t('session.add_to_session') : $t('time.start')"></span></button>
  </div>
  <div class="task-card-foot">
    <div class="label-list" x-show="t.labels && t.labels.length > 0">
      <template x-for="l in t.labels" :key="l.id"><span class="badge" x-text="l.name"></span></template>
    </div>
    <span class="muted small" x-show="!t.labels || t.labels.length === 0">{{.T "time.no_labels"}}</span>
  </div>
</div>
{{end}}
