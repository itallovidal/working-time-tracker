{{/* A barra superior: o nome da organização, uma página por assunto e, no canto, o menu da conta. Cada item só
     aparece para quem pode abrir a página dele. No modo solo (Me.OrganizationSolo, uma pessoa só) somem Colaboradores e
     Pagamentos, que são de equipe, e entra A receber. */}}
{{define "topbar"}}
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/orgs/{{.OrgID}}"><span data-org-name>{{.Me.OrganizationName}}</span></a>
    <nav class="mainnav" aria-label="{{.T "nav.label"}}">
      <a href="/orgs/{{.OrgID}}" {{if eq .Section "home"}}aria-current="page"{{end}}>{{.T "nav.home"}}</a>
      {{/* Clientes e Projetos é de todos (cada um vê os seus projetos) e fica marcado também dentro de um projeto. */}}
      <a href="/orgs/{{.OrgID}}/projects" {{if eq .Section "projects"}}aria-current="page"{{end}}>{{.T "nav.customers_projects"}}</a>
      {{if and (not .Me.OrganizationSolo) (.Can "people.manage")}}<a href="/orgs/{{.OrgID}}/people" {{if eq .Section "people"}}aria-current="page"{{end}}>{{.T "nav.people"}}</a>{{end}}
      {{/* Os pagamentos da equipe são dinheiro de todos: só do dono. Cada pessoa vê os dela no perfil. */}}
      {{if and (not .Me.OrganizationSolo) (.Can "payments.manage")}}<a href="/orgs/{{.OrgID}}/payments" {{if eq .Section "payments"}}aria-current="page"{{end}}>{{.T "nav.payments"}}</a>{{end}}
      {{/* O que o dono tem a receber dos clientes: só no modo solo, e só para quem gerencia os recebíveis. */}}
      {{if and .Me.OrganizationSolo (.Can "receivables.manage")}}<a href="/orgs/{{.OrgID}}/receivables" {{if eq .Section "receivables"}}aria-current="page"{{end}}>{{.T "nav.receivables"}}</a>{{end}}
      <a href="/orgs/{{.OrgID}}/about" {{if eq .Section "organization"}}aria-current="page"{{end}}>{{.T "nav.settings"}}</a>
    </nav>
    <div class="topbar-right">
      {{template "user_menu" .}}
    </div>
  </div>
</header>
{{end}}
