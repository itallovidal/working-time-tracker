{{define "topbar"}}
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/orgs/{{.OrgID}}">
      <span class="brand-mark" aria-hidden="true"></span>
      <span data-org-name>{{.Me.OrganizationName}}</span>
    </a>
    <nav class="mainnav" aria-label="Organização">
      <a href="/orgs/{{.OrgID}}" {{if eq .Section "projects"}}aria-current="page"{{end}}>Projetos</a>
      {{if .IsAdmin}}<a href="/orgs/{{.OrgID}}/settings" {{if eq .Section "organization"}}aria-current="page"{{end}}>Organização</a>{{end}}
    </nav>
    <div class="topbar-right">
      {{template "active_session" .}}
      <a class="me" href="/profile" title="{{.Me.Email}}" {{if eq .Section "profile"}}aria-current="page"{{end}}>
        <span class="sr-only">Seu perfil:</span>
        <span class="avatar" aria-hidden="true">{{.Initials}}</span>
        <span class="name" data-me-name>{{.Me.Name}}</span>
        {{if .IsAdmin}}<span class="badge badge-accent">Admin</span>{{end}}
      </a>
      <span x-data="logoutButton">
        <button type="button" class="btn btn-ghost btn-sm" @click="logout()" :disabled="busy">Sair</button>
      </span>
    </div>
  </div>
</header>
{{end}}
