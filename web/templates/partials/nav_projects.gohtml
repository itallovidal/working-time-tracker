{{/* O menu Projetos da barra superior: os projetos da pessoa (todos, para os admins), para achar e abrir um deles de
     qualquer página. A lista vem do window.BOOT (nav_projects), então não há requisição; com mais de sete, ganha
     uma busca. O botão fica marcado quando a página é de um projeto, e o projeto aberto, marcado na lista.
     Fecha com Esc, ao clicar fora ou ao escolher. */}}
{{define "nav_projects"}}
<div class="nav-menu" x-data="navProjects" @keydown.escape.window="close()" @click.outside="close()">
  <button type="button" class="nav-menu-btn" :class="open && 'is-open'" aria-haspopup="true" aria-controls="nav-projects-panel"
          :aria-expanded="open.toString()" {{if eq .Section "projects"}}aria-current="true"{{end}} @click="toggle()">
    {{.T "nav.projects"}} {{template "icon" "chevron-down"}}
  </button>
  <div class="nav-menu-panel" id="nav-projects-panel" x-cloak x-show="open">
    <input type="search" class="nav-menu-search" x-ref="q" x-model="q" x-show="items.length > 7" autocomplete="off"
           placeholder="{{.T "nav.projects_search"}}" aria-label="{{.T "nav.projects_search"}}">
    <ul class="nav-menu-list" x-show="shown.length > 0">
      <template x-for="p in shown" :key="p.id">
        <li><a class="nav-project" :href="'/projects/' + p.id" :aria-current="p.id === currentId ? 'page' : null" @click="close()" x-text="p.name"></a></li>
      </template>
    </ul>
    <p class="nav-menu-empty muted small" x-show="items.length === 0">{{if .IsAdmin}}{{.T "org.projects.empty"}}{{else}}{{.T "org.projects.empty_member"}}{{end}}</p>
    <p class="nav-menu-empty muted small" x-show="items.length > 0 && shown.length === 0">{{.T "nav.projects_no_match"}}</p>
    <a class="nav-menu-all" href="/orgs/{{.OrgID}}#home-projects-title" @click="close()">{{.T "nav.projects_all"}}</a>
  </div>
</div>
{{end}}
