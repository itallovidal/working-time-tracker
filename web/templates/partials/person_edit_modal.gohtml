{{/* person_edit_modal é o modal Editar colaborador, em abas: a jornada (e, para o dono, a regra de pagamento) e os
     projetos com o valor por hora. Cada aba só existe para quem pode usá-la, e a faixa de abas só
     aparece com duas ou mais. Nada vai para o servidor antes de Salvar, e um Salvar só aplica o rascunho de todas
     as abas. Abre na lista de colaboradores e no perfil de um deles; fica no escopo do componente que o inclui,
     que espalha personEditor() (org.js). */}}
{{define "person_edit_modal"}}
<template x-teleport="#modal-root">
  <form class="stack" novalidate x-show="$store.modal.name === 'person-edit'" @submit.prevent="savePerson()">
    <div class="row" x-show="editing">
      <span class="avatar" aria-hidden="true" x-text="WTT.fmt.initials(editing && editing.name)"></span>
      <div>
        <div><strong x-text="editing && editing.name"></strong> <span class="badge" x-show="editing && editing.id === me.id">{{.T "common.you"}}</span></div>
        <div class="muted small" x-text="editing && editing.email"></div>
      </div>
    </div>

    <div class="segmented segmented-tabs" role="tablist" aria-label="{{.T "org.people.tabs_label"}}" x-cloak x-show="tabs.length > 1"
         @keydown.arrow-right.prevent="moveTab('next')" @keydown.arrow-left.prevent="moveTab('prev')"
         @keydown.home.prevent="moveTab('first')" @keydown.end.prevent="moveTab('last')">
      {{if .Can "people.manage"}}
      <button type="button" role="tab" id="person-tab-payment" aria-controls="person-panel-payment" x-ref="tab-payment"
              :aria-selected="(tab === 'payment').toString()" :tabindex="tab === 'payment' ? 0 : -1"
              @click="tab = 'payment'">{{template "icon" "hand-holding-dollar"}} {{.T "org.people.tab_payment"}}</button>
      {{end}}
      {{if .IsAdmin}}
      <button type="button" role="tab" id="person-tab-projects" aria-controls="person-panel-projects" x-ref="tab-projects"
              :aria-selected="(tab === 'projects').toString()" :tabindex="tab === 'projects' ? 0 : -1"
              @click="tab = 'projects'">{{template "icon" "folder-open"}} {{.T "org.people.tab_projects"}}</button>
      {{end}}
    </div>

    {{if .Can "people.manage"}}
    <div class="field" id="person-panel-payment" role="tabpanel" aria-labelledby="person-tab-payment" x-show="tab === 'payment'">
      {{template "field_label" (dict "D" . "For" "person-weekly-hours" "Key" "org.people.weekly_hours_label" "Optional" true)}}
      <select id="person-weekly-hours" data-field="weekly_hours" x-model="draft.weekly_hours" @change="clearField('weekly_hours')" data-autofocus>
        <option value="">{{.T "labels.weekly_hours_none"}}</option>
        {{/* 20, 30 e 40, e a carga atual da pessoa quando é outra (uma carga antiga some da lista se não entrar aqui). */}}
        <template x-for="h in weeklyHourOptions()" :key="h">
          <option :value="String(h)" x-text="h" :selected="String(h) === String(draft.weekly_hours)"></option>
        </template>
      </select>
      {{template "field_error" "weekly_hours"}}

      {{/* A regra de pagamento é dinheiro: só o dono a vê e a define. */}}
      {{if .Can "payments.manage"}}
      {{template "field_label" (dict "D" . "For" "person-payment-frequency" "Key" "org.people.payment_label" "Optional" true)}}
      <select id="person-payment-frequency" data-field="frequency" x-model="draft.payment.frequency" @change="clearField('frequency'); clearField('day'); clearField('start')">
        <option value="">{{.T "org.people.payment_none"}}</option>
        <option value="monthly">{{.T "org.people.payment_monthly"}}</option>
        <option value="biweekly">{{.T "org.people.payment_biweekly"}}</option>
      </select>
      <template x-if="draft.payment.frequency === 'monthly'">
        <div class="field">
          <label for="person-payment-day">{{.T "org.people.payment_day_label"}}</label>
          <input id="person-payment-day" type="number" min="1" max="31" step="1" class="num" data-field="day" x-model="draft.payment.day" @input="clearField('day')" :aria-invalid="fieldErrors.day ? 'true' : 'false'">
          {{template "field_error" "day"}}
          <span class="hint">{{.T "org.people.payment_day_hint"}}</span>
        </div>
      </template>
      <template x-if="draft.payment.frequency === 'biweekly'">
        <div class="field">
          <label for="person-payment-start">{{.T "org.people.payment_start_label"}}</label>
          <input id="person-payment-start" type="date" data-field="start" x-model="draft.payment.start" @input="clearField('start')" :aria-invalid="fieldErrors.start ? 'true' : 'false'">
          {{template "field_error" "start"}}
          <span class="hint">{{.T "org.people.payment_start_hint"}}</span>
        </div>
      </template>
      {{end}}
    </div>
    {{end}}

    {{/* Os projetos da pessoa e o valor que ela recebe por hora em cada um. Só admins: o valor é uma permissão de projeto
         (rates.manage), e eles têm todas. Entrar num projeto ou sair dele só acontece ao Salvar. */}}
    {{if .IsAdmin}}
    <div class="stack" id="person-panel-projects" role="tabpanel" aria-labelledby="person-tab-projects" x-cloak x-show="tab === 'projects'">
      <p class="muted small" x-show="projectsState === 'loading'">{{.T "org.people.projects_loading"}}</p>
      <div class="stack" x-cloak x-show="projectsState === 'error'">
        <p class="form-error" x-text="errors.projects" role="alert"></p>
        <div><button type="button" class="btn btn-secondary btn-sm" @click="loadProjects(editing)">{{.T "org.people.projects_retry"}}</button></div>
      </div>

      <div class="stack" x-cloak x-show="projectsState === 'ready'">
        <p class="muted small" x-show="editing && editing.is_owner">{{.T "collab.owner_rate_hint"}}</p>
        <p class="muted small" x-show="draft.projects.length === 0">{{.T "org.people.projects_empty"}}</p>
        <ul class="list project-rates" x-show="draft.projects.length > 0">
          <template x-for="row in draft.projects" :key="row.project_id">
            <li>
              <span class="grow">
                <span class="project-name" :class="row.removed && 'is-removed'" x-text="row.name"></span>
                <span class="badge" x-show="row.isNew">{{.T "org.people.joins_on_save"}}</span>
                <span class="muted small note" x-show="row.removed">{{.T "collab.remove_confirm"}}</span>
              </span>
              <span class="rate-input" x-show="!row.removed && editing && !editing.is_owner">
                <span class="muted small" aria-hidden="true" x-text="WTT.fmt.moneyUnit()"></span>
                <input type="text" inputmode="decimal" class="num" placeholder="{{.T "project_settings.rate_placeholder"}}"
                       :aria-label="$t('org.people.rate_of', { project: row.name, unit: WTT.fmt.moneyUnit() })" x-model="row.rate"
                       @input="row.error = ''" :aria-invalid="row.error ? 'true' : 'false'" :data-rate-row="row.project_id">
              </span>
              <button type="button" class="btn btn-ghost btn-sm" @click="toggleRemove(row)"
                      :class="!row.removed && !row.isNew && 'btn-danger-ghost'"
                      x-text="row.removed ? $t('org.people.undo_leave') : (row.isNew ? $t('org.people.discard_join') : $t('collab.leave'))"></button>
              <p class="form-error" style="flex-basis: 100%" x-cloak x-show="row.error && !row.removed" x-text="row.error" role="alert"></p>
            </li>
          </template>
        </ul>
        <p class="muted small">{{.T "org.people.projects_hint"}}</p>

        <div class="field" x-show="addableProjects().length > 0">
          <label for="person-add-project">{{.T "org.people.add_project"}}</label>
          <div class="row project-add">
            <select id="person-add-project" x-model="addForm.project_id">
              <option value="">{{.T "org.people.choose_project"}}</option>
              <template x-for="p in addableProjects()" :key="p.id">
                <option :value="p.id" x-text="p.name"></option>
              </template>
            </select>
            <span class="rate-input" x-show="editing && !editing.is_owner">
              <span class="muted small" aria-hidden="true" x-text="WTT.fmt.moneyUnit()"></span>
              <input type="text" inputmode="decimal" class="num" placeholder="{{.T "project_settings.rate_placeholder"}}"
                     :aria-label="$t('org.people.new_rate_of', { unit: WTT.fmt.moneyUnit() })" x-model="addForm.rate"
                     @input="errors.addRate = ''" :aria-invalid="errors.addRate ? 'true' : 'false'" data-rate-add @keydown.enter.prevent="addProject()">
            </span>
            <button type="button" class="btn btn-secondary btn-sm" @click="addProject()">{{template "icon" "plus"}} {{.T "org.people.add_project_button"}}</button>
          </div>
        </div>
        <p class="form-error" x-cloak x-show="errors.addRate" x-text="errors.addRate" role="alert"></p>
        <p class="muted small" x-show="allProjects && allProjects.length === 0">{{.T "org.people.projects_none_in_org"}}</p>
      </div>
    </div>
    {{end}}

    <p class="form-error" x-show="errors.edit" x-text="errors.edit" role="alert"></p>
    <div class="row row-end">
      <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
      <button type="submit" class="btn" :disabled="pending">{{.T "common.save"}}</button>
    </div>
  </form>
</template>
{{end}}
