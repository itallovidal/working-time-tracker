{{/* As boas-vindas do primeiro acesso: um modal em quatro etapas que abre na página inicial do dono que acabou de criar
     a organização (o servidor só inclui este parcial enquanto Me.NeedsOnboarding). Etapa 1, os dados mais importantes
     da organização; 2, o primeiro cliente (o formulário inteiro do modal de cliente, em duas partes); 3, o primeiro
     convite; 4, onde ajustar cada coisa e a documentação. Cada uma das três primeiras pode ser pulada. No modo solo
     (Me.OrganizationSolo) não há convite: o modal tem três etapas (organização, primeiro cliente e fim), e a etapa 3
     não existe; o fim segue sendo a "4" por dentro (veja next() em onboarding, em pages/org.js). O estado e as chamadas
     estão lá. */}}
{{define "onboarding"}}
<div x-data="onboarding" hidden>
  <template x-teleport="#modal-root">
    {{/* As etapas em cima e os botões de cada uma embaixo ficam parados; só o meio rola (.modal-split, em app.css). */}}
    <div class="modal-split" x-show="$store.modal.name === 'onboarding'">
      <div class="modal-split-head">
        <ol class="wizard-steps" aria-label="{{.T "onboarding.steps_label"}}">
          <li :class="step === 1 && 'current'" :aria-current="step === 1 ? 'step' : false"><span class="n">1</span> {{.T "onboarding.step_org"}}</li>
          <li :class="step === 2 && 'current'" :aria-current="step === 2 ? 'step' : false"><span class="n">2</span> {{.T "onboarding.step_customers"}}</li>
          {{if not .Me.OrganizationSolo}}
          <li :class="step === 3 && 'current'" :aria-current="step === 3 ? 'step' : false"><span class="n">3</span> {{.T "onboarding.step_people"}}</li>
          {{end}}
          <li :class="step === 4 && 'current'" :aria-current="step === 4 ? 'step' : false"><span class="n">{{if .Me.OrganizationSolo}}3{{else}}4{{end}}</span> {{.T "onboarding.step_done"}}</li>
        </ol>
      </div>

      {{/* Etapa 1: a organização. Só o que mais importa; o resto fica na edição, em Organização › Sobre. */}}
      <form class="modal-split" novalidate x-show="step === 1" @submit.prevent="saveOrg()">
        <div class="modal-split-body stack">
          <p class="muted small" x-text="$t('onboarding.org.lead', { name: orgName })"></p>
          <div class="field">
            {{template "field_label" (dict "D" . "For" "ob-summary" "Key" "org.settings.summary" "Optional" true)}}
            <input id="ob-summary" type="text" data-field="summary" maxlength="{{limit "summary"}}" x-model="orgDraft.summary" @input="clearField('summary')" :aria-invalid="fieldErrors.summary ? 'true' : 'false'" data-autofocus data-step="1">
            {{template "field_error" "summary"}}
            <span class="hint">{{.T "org.settings.summary_hint"}} <span class="num" x-text="summaryLength() + '/{{limit "summary"}}'"></span></span>
          </div>
          {{/* No modo solo o regime e a moeda não se aplicam (a moeda é a do país escolhido no cadastro): fica só o fuso. */}}
          <div class="fields">
            {{if not .Me.OrganizationSolo}}
            <div class="field">
              {{template "field_label" (dict "D" . "For" "ob-work-mode" "Key" "org.settings.work_mode" "Optional" true)}}
              <select id="ob-work-mode" x-model="orgDraft.work_mode">
                <option value="">{{.T "labels.not_informed"}}</option>
                <template x-for="m in WTT.workModes" :key="m.value">
                  <option :value="m.value" x-text="m.label" :selected="m.value === orgDraft.work_mode"></option>
                </template>
              </select>
            </div>
            {{end}}
            <div class="field">
              <label for="ob-timezone">{{.T "org.fields.timezone"}}</label>
              <select id="ob-timezone" x-model="orgDraft.timezone">
                <template x-for="tz in timezones" :key="tz">
                  <option :value="tz" x-text="tz" :selected="tz === orgDraft.timezone"></option>
                </template>
              </select>
            </div>
            {{if not .Me.OrganizationSolo}}
            <div class="field">
              <label for="ob-currency">{{.T "org.fields.currency"}}</label>
              <select id="ob-currency" x-model="orgDraft.currency">
                <template x-for="c in WTT.currencies" :key="c.value">
                  <option :value="c.value" x-text="c.label" :selected="c.value === orgDraft.currency"></option>
                </template>
              </select>
            </div>
            {{end}}
          </div>
          <p class="muted small">{{if .Me.OrganizationSolo}}{{.T "onboarding.org.timezone_note"}}{{else}}{{.T "onboarding.org.money_note"}}{{end}}</p>
        </div>
        <div class="modal-split-foot stack">
          <p class="form-error" x-cloak x-show="errors.org" x-text="errors.org" role="alert"></p>
          <div class="row row-end">
            <button type="button" class="btn btn-secondary" :disabled="pending" @click="next()">{{.T "onboarding.later"}}</button>
            <button type="submit" class="btn" :disabled="pending">{{.T "common.save"}}</button>
          </div>
        </div>
      </form>

      {{/* Etapa 2: o primeiro cliente, com o mesmo formulário do modal de cliente (o parcial customer_fields), nas mesmas
           duas partes: os dados e a cobrança, que no modo solo também cria o cliente por contrato mensal. A faixa do
           topo não muda; as duas partes aparecem numa linha menor, embaixo do texto, que fica parado com ela. Salvar cria
           o cliente e segue para a etapa seguinte. */}}
      <form class="modal-split" novalidate x-cloak x-show="step === 2" @submit.prevent="customerStep === 1 ? customerNext(customer) : saveCustomer()">
        <div class="modal-split-head">
          <p class="muted small">{{if .Me.OrganizationSolo}}{{.T "onboarding.customers.lead_solo"}}{{else}}{{.T "onboarding.customers.lead"}}{{end}}</p>
          <ol class="wizard-substeps" aria-label="{{.T "customer.wizard.label"}}">
            <li :class="customerStep === 1 && 'current'" :aria-current="customerStep === 1 ? 'step' : false">{{.T "customer.wizard.step_data"}}</li>
            <li :class="customerStep === 2 && 'current'" :aria-current="customerStep === 2 ? 'step' : false">{{.T "customer.wizard.step_billing"}}</li>
          </ol>
        </div>
        <div class="modal-split-body stack">
          {{template "customer_fields" (dict "Data" . "Model" "customer" "Id" "ob-customer" "Step" "2")}}
        </div>
        <div class="modal-split-foot stack">
          <p class="form-error" x-cloak x-show="errors.customer" x-text="errors.customer" role="alert"></p>
          <div class="row row-end">
            <button type="button" class="btn btn-secondary" x-show="customerStep === 1" :disabled="pending" @click="next()">{{.T "onboarding.customers.later"}}</button>
            <button type="button" class="btn btn-secondary" x-cloak x-show="customerStep === 2" :disabled="pending" @click="customerBack()">{{template "icon" "arrow-left"}} {{.T "customer.wizard.back"}}</button>
            <button type="submit" class="btn" x-show="customerStep === 1">{{.T "customer.wizard.next"}} {{template "icon" "arrow-right"}}</button>
            <button type="submit" class="btn" x-cloak x-show="customerStep === 2" :disabled="pending">{{.T "common.save"}}</button>
          </div>
        </div>
      </form>

      {{if not .Me.OrganizationSolo}}
      {{/* Etapa 3: o primeiro convite. Igual ao modal da aba Colaboradores: com o Clerk e um e-mail, o convite sai por
           e-mail; sem e-mail, ou sem o Clerk, é um link para copiar, que só aparece agora. */}}
      <form class="modal-split" novalidate x-cloak x-show="step === 3" @submit.prevent="createInvite()">
        <div class="modal-split" x-show="!lastLink">
          <div class="modal-split-body stack">
            <p class="muted small">{{.T "onboarding.people.lead"}}</p>
            <p class="muted small">{{if .Props.emailInvites}}{{.T "org.people.invite_intro_email"}}{{else}}{{.T "org.people.invite_intro"}}{{end}}</p>
            <div class="field">
              {{template "field_label" (dict "D" . "For" "ob-invite-email" "Key" "common.email" "Optional" true)}}
              <input id="ob-invite-email" type="email" data-field="email" maxlength="{{limit "email"}}" x-model="invite.email" @input="clearField('email')" :aria-invalid="fieldErrors.email ? 'true' : 'false'" data-autofocus data-step="3">
              {{template "field_error" "email"}}
              <span class="hint">{{if .Props.emailInvites}}{{.T "org.people.invite_email_hint_email"}}{{else}}{{.T "org.people.invite_email_hint"}}{{end}}</span>
            </div>
            <div class="field">
              <label for="ob-invite-role">{{.T "common.role"}}</label>
              <select id="ob-invite-role" data-field="role" x-model="invite.role" @change="clearField('role')">
                <option value="member">{{.T "roles.member"}}</option>
                {{if .IsOwner}}<option value="admin">{{.T "roles.admin"}}</option>{{end}}
              </select>
              {{template "field_error" "role"}}
            </div>
          </div>
          <div class="modal-split-foot stack">
            <p class="form-error" x-cloak x-show="errors.invite" x-text="errors.invite" role="alert"></p>
            <div class="row row-end">
              <button type="button" class="btn btn-secondary" :disabled="pending" @click="next()">{{.T "onboarding.people.later"}}</button>
              {{- if .Props.emailInvites}}
              <button type="submit" class="btn" :disabled="pending">
                <span x-cloak x-show="invite.email">{{template "icon" "paper-plane"}} {{.T "org.people.send_by_email"}}</span>
                <span x-show="!invite.email">{{template "icon" "link"}} {{.T "org.people.generate"}}</span>
              </button>
              {{- else}}
              <button type="submit" class="btn" :disabled="pending">{{template "icon" "link"}} {{.T "org.people.generate"}}</button>
              {{- end}}
            </div>
          </div>
        </div>

        <div class="modal-split" x-cloak x-show="lastLink" x-transition.opacity>
          <div class="modal-split-body stack">
            <p class="muted small" x-cloak x-show="lastDelivery === 'email'" x-text="$t('org.people.sent_to', { email: lastEmail })"></p>
            <p class="muted small" x-cloak x-show="lastDelivery === 'terminal'">{{.T "org.people.terminal_note"}}</p>
            <div class="field">
              <label for="ob-invite-link">{{.T "org.people.link_label"}}</label>
              <input id="ob-invite-link" type="text" readonly :value="lastLink" x-ref="link" @focus="$event.target.select()">
              <span class="hint" x-show="lastDelivery === 'link'">{{.T "org.people.link_hint"}}</span>
              <span class="hint" x-cloak x-show="lastDelivery !== 'link'">{{.T "org.people.link_hint_email"}}</span>
            </div>
          </div>
          <div class="modal-split-foot">
            <div class="row row-end">
              <button type="button" class="btn btn-ghost" @click="anotherInvite()">{{.T "onboarding.people.another"}}</button>
              <button type="button" class="btn btn-secondary" @click="copyLink()">{{template "icon" "copy"}} {{.T "org.people.copy"}}</button>
              <button type="button" class="btn" @click="next()">{{.T "onboarding.people.next"}} {{template "icon" "arrow-right"}}</button>
            </div>
          </div>
        </div>
      </form>
      {{end}}

      {{/* Etapa 4: onde ajustar cada coisa, o que ficou para depois e a documentação. */}}
      <div class="modal-split" x-cloak x-show="step === 4">
        <div class="modal-split-body stack">
          <p class="muted small">{{.T "onboarding.done.lead"}}</p>
          <ul class="onboarding-links">
            <li>
              <a class="onboarding-link" href="/orgs/{{.OrgID}}/settings">
                <span class="onboarding-ico" aria-hidden="true">{{template "icon" "building"}}</span>
                <span class="onboarding-text"><strong>{{.T "onboarding.done.org"}}</strong><span class="muted small">{{if .Me.OrganizationSolo}}{{.T "onboarding.done.org_text_solo"}}{{else}}{{.T "onboarding.done.org_text"}}{{end}}</span></span>
                <span class="badge" :class="saved.org ? 'badge-ok' : ''" x-text="saved.org ? $t('onboarding.done.saved') : $t('onboarding.done.pending')"></span>
              </a>
            </li>
            <li>
              <a class="onboarding-link" href="/orgs/{{.OrgID}}/projects">
                <span class="onboarding-ico" aria-hidden="true">{{template "icon" "handshake"}}</span>
                <span class="onboarding-text"><strong>{{.T "onboarding.done.customers"}}</strong><span class="muted small">{{.T "onboarding.done.customers_text"}}</span></span>
                <span class="badge" :class="saved.customer ? 'badge-ok' : ''" x-text="saved.customer ? $t('onboarding.done.saved') : $t('onboarding.done.pending')"></span>
              </a>
            </li>
            {{if not .Me.OrganizationSolo}}
            <li>
              <a class="onboarding-link" href="/orgs/{{.OrgID}}/people">
                <span class="onboarding-ico" aria-hidden="true">{{template "icon" "users"}}</span>
                <span class="onboarding-text"><strong>{{.T "onboarding.done.people"}}</strong><span class="muted small">{{.T "onboarding.done.people_text"}}</span></span>
                <span class="badge" :class="invited > 0 ? 'badge-ok' : ''" x-text="invited > 0 ? $t('onboarding.done.invited', { count: invited }) : $t('onboarding.done.pending')"></span>
              </a>
            </li>
            {{end}}
            <li>
              <a class="onboarding-link" href="/orgs/{{.OrgID}}/projects">
                <span class="onboarding-ico" aria-hidden="true">{{template "icon" "diagram-project"}}</span>
                <span class="onboarding-text"><strong>{{.T "onboarding.done.projects"}}</strong><span class="muted small">{{if .Me.OrganizationSolo}}{{.T "onboarding.done.projects_text_solo"}}{{else}}{{.T "onboarding.done.projects_text"}}{{end}}</span></span>
              </a>
            </li>
            <li>
              <a class="onboarding-link" href="/help#getting-started" target="_blank" rel="noopener">
                <span class="onboarding-ico" aria-hidden="true">{{template "icon" "book"}}</span>
                <span class="onboarding-text"><strong>{{.T "onboarding.done.docs"}}</strong><span class="muted small">{{.T "onboarding.done.docs_text"}}</span></span>
              </a>
            </li>
          </ul>
        </div>
        <div class="modal-split-foot">
          <div class="row row-end">
            <button type="button" class="btn" data-autofocus data-step="4" @click="finish()">{{.T "onboarding.done.finish"}}</button>
          </div>
        </div>
      </div>
    </div>
  </template>
</div>
{{end}}
