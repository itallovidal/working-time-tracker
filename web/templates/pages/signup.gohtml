{{define "content"}}
<main class="auth-page">
  <form class="auth-card" x-data="signupForm" @submit.prevent="submit()" novalidate>
    <span class="brand"><span class="brand-mark" aria-hidden="true"></span>Working Time Tracker</span>
    <div class="stack">
      <h1>Criar organização</h1>
      <p class="muted">Você entra como admin e depois convida o time.</p>
    </div>
    <div class="field">
      <label for="signup-org">Nome da organização</label>
      <input id="signup-org" type="text" autocomplete="organization" required x-model="organization_name" autofocus>
    </div>
    <div class="field">
      <label for="signup-name">Seu nome</label>
      <input id="signup-name" type="text" autocomplete="name" required x-model="name">
    </div>
    <div class="field">
      <label for="signup-email">Email</label>
      <input id="signup-email" type="email" autocomplete="email" required x-model="email">
    </div>
    <div class="field">
      <label for="signup-password">Senha</label>
      <input id="signup-password" type="password" autocomplete="new-password" minlength="8" required x-model="password">
      <span class="hint">Pelo menos 8 caracteres.</span>
    </div>
    <p class="form-error" x-cloak x-show="errors.signup" x-text="errors.signup" role="alert"></p>
    <button class="btn btn-block" type="submit" :disabled="pending">
      <span x-text="pending ? 'Criando…' : 'Criar conta'">Criar conta</span>
    </button>
    <p class="auth-foot">Já tem conta? <a href="/login">Entrar</a></p>
  </form>
</main>
{{end}}
