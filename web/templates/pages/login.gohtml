{{define "content"}}
<main class="auth-page">
  <div class="auth-card" x-data="loginForm">
    <span class="brand"><span class="brand-mark" aria-hidden="true"></span>Working Time Tracker</span>
    <div class="stack">
      <h1>{{.T "auth.login.title"}}</h1>
      <p class="muted">{{.T "auth.login.subtitle"}}</p>
    </div>
    <form class="stack" @submit.prevent="submit()">
      <div class="field">
        <label for="login-email">{{.T "common.email"}}</label>
        <input id="login-email" type="email" autocomplete="email" required x-model="email" autofocus>
      </div>
      <div class="field">
        <label for="login-password">{{.T "auth.password"}}</label>
        <input id="login-password" type="password" autocomplete="current-password" required x-model="password">
      </div>
      <p class="form-error" x-cloak x-show="errors.login" x-text="errors.login" role="alert"></p>
      <button class="btn btn-block" type="submit" :disabled="pending">
        <span x-text="pending ? $t('auth.login.pending') : $t('auth.login.submit')">{{.T "auth.login.submit"}}</span>
      </button>
    </form>
    {{- if .Props.clerk}}
    {{/* O email e a senha do sistema são o jeito de entrar; o Google entra pelo Clerk, logo abaixo. */}}
    <div class="auth-divider"><span>{{.T "auth.clerk.or"}}</span></div>
    <div class="stack">
      <p class="muted" x-show="loading">{{.T "auth.clerk.loading"}}</p>
      <div class="stack" x-cloak x-show="stuck">
        <p class="muted">{{.T "auth.clerk.stuck"}}</p>
        <button class="btn btn-block" type="button" @click="retry()">{{.T "auth.clerk.try_again"}}</button>
        <button class="btn btn-secondary btn-block" type="button" @click="otherAccount()">{{.T "auth.clerk.other_account"}}</button>
      </div>
      <div class="clerk-mount" x-ref="clerk" x-show="!stuck"></div>
      <p class="form-error" x-cloak x-show="errors.clerk" x-text="errors.clerk" role="alert"></p>
    </div>
    {{- end}}
    <p class="auth-foot">{{.T "auth.login.no_account"}} <a href="/signup">{{.T "auth.login.create_org"}}</a></p>
  </div>
</main>
{{end}}
