{{define "content"}}
<main class="page" x-data="orgHome">
  {{if .IsAdmin}}
  {{/* Os números são só dos admins: são o dinheiro de todos os projetos e as horas de cada pessoa.
       Valem para a hora em "Atualizado às" e são relidos pelo botão. */}}
  <section class="stack" aria-labelledby="home-stats-title">
    <div class="toolbar">
      <div class="section-head">
        <h2 id="home-stats-title">{{.T "home.stats.title"}}</h2>
        <p class="muted small" x-text="scopeText()"></p>
      </div>
      <div class="row">
        <div class="segmented" role="group" aria-label="{{.T "home.stats.period"}}">
          <template x-for="o in periods" :key="o.key">
            <button type="button" :aria-pressed="period === o.key" @click="setPeriod(o.key)" x-text="o.label"></button>
          </template>
        </div>
        <span class="muted small" x-cloak x-show="stats" x-text="stats ? $t('home.stats.updated', { time: WTT.fmt.time(stats.generated_at) }) : ''"></span>
        <button type="button" class="btn btn-secondary btn-sm" :disabled="statsLoading" @click="loadStats()">{{template "icon" "rotate"}} {{.T "home.stats.refresh"}}</button>
      </div>
    </div>

    <p class="muted" x-show="statsLoading && !stats">{{.T "home.stats.loading"}}</p>
    <p class="form-error" x-cloak x-show="errors.stats" x-text="errors.stats" role="alert"></p>

    <template x-if="stats">
      <div class="stack">
        <div class="kpis">
          <div class="kpi hue-teal">
            <span class="kpi-icon">{{template "icon" "user-clock"}}</span>
            <div class="kpi-body">
              <span class="kpi-label">{{.T "home.stats.mine"}}</span>
              <span class="kpi-value" x-text="WTT.fmt.hours(current().my_seconds)"></span>
              <span class="kpi-hint" x-text="mineShare() === null ? $t('home.stats.no_hours') : $t('home.stats.mine_hint', { percent: mineShare() })"></span>
            </div>
          </div>
          <div class="kpi hue-purple">
            <span class="kpi-icon">{{template "icon" "people-group"}}</span>
            <div class="kpi-body">
              <span class="kpi-label">{{.T "home.stats.team"}}</span>
              <span class="kpi-value" x-text="WTT.fmt.hours(teamSeconds())"></span>
              <span class="kpi-hint" x-text="$t('home.stats.team_hint', { time: WTT.fmt.hours(current().seconds) })"></span>
            </div>
          </div>
          <div class="kpi hue-green">
            <span class="kpi-icon">{{template "icon" "circle-play"}}</span>
            <div class="kpi-body">
              <span class="kpi-label">{{.T "home.stats.working_now"}}</span>
              <span class="kpi-value" x-text="stats.people.working_now"></span>
              <span class="kpi-hint" x-text="workingNames() || $t('home.stats.nobody_open')"></span>
            </div>
          </div>
          <div class="kpi hue-blue">
            <span class="kpi-icon">{{template "icon" "hand-holding-dollar"}}</span>
            <div class="kpi-body">
              <span class="kpi-label">{{.T "home.stats.revenue"}}</span>
              <span class="kpi-value" x-text="WTT.fmt.money(current().money.bill_amount_cents)"></span>
              <span class="kpi-hint" x-text="current().money.bill_amount_cents === null ? $t('home.stats.no_revenue') : $t('home.stats.revenue_hint')"></span>
            </div>
          </div>
          <div class="kpi hue-orange">
            <span class="kpi-icon">{{template "icon" "wallet"}}</span>
            <div class="kpi-body">
              <span class="kpi-label">{{.T "home.stats.cost"}}</span>
              <span class="kpi-value" x-text="WTT.fmt.money(current().money.pay_amount_cents)"></span>
              <span class="kpi-hint" x-text="current().money.pay_amount_cents === null ? $t('home.stats.no_cost') : $t('home.stats.cost_hint')"></span>
            </div>
          </div>
          <div class="kpi" :class="marginNegative() ? 'hue-orange' : 'hue-green'">
            <span class="kpi-icon">{{template "icon" "chart-line"}}</span>
            <div class="kpi-body">
              <span class="kpi-label">{{.T "home.stats.margin"}}</span>
              <span class="kpi-value" :class="marginNegative() && 'text-danger'" x-text="WTT.fmt.money(current().money.margin_cents)"></span>
              <span class="kpi-hint" x-text="marginShare() === null ? $t('home.stats.no_revenue') : $t('home.stats.margin_share', { percent: marginShare() })"></span>
            </div>
          </div>
        </div>

        {{/* A equipe: quem está com o ponto aberto agora e em que tarefa, quem trabalha agora primeiro e
             depois por nome. De propósito não há horas, barras nem ordem por tempo: veja partials/team_hours. */}}
        <section class="stack" aria-labelledby="home-team-title">
          <div class="toolbar">
            <div class="section-head">
              <h3 id="home-team-title">{{.T "home.team.title"}}</h3>
              <p class="muted small">{{.T "home.team.intro"}}</p>
            </div>
            {{template "team_actions" .}}
          </div>
          <p class="muted" x-show="stats.people.working_now === 0">{{.T "home.team.nobody_working"}}</p>
          <ul class="team-list">
            <template x-for="p in teamView().rows" :key="p.person.id">
              {{/* Cada pessoa é um cartão de ponta a ponta: o avatar e o nome de um lado e, do outro, o ícone que abre a tarefa. */}}
              <li class="team-row team-card" :class="p.working_now ? 'hue-green' : 'tone'">
                <span class="avatar" aria-hidden="true" x-text="initialsOf(p.person.name)"></span>
                <div class="team-who">
                  <div class="team-name">
                    <span x-text="p.person.name"></span>
                    <span class="badge badge-ok" x-show="p.working_now">{{.T "home.team.working"}}</span>
                  </div>
                  <template x-if="p.working_now && p.working_on.length > 0">
                    <p class="team-doing">
                      <span class="muted">{{.T "home.team.on_task"}}</span>
                      <strong x-text="p.working_on[0].task.name"></strong>
                      <span class="muted">· <span x-text="p.working_on[0].project.name"></span></span>
                      <span class="muted" x-show="p.working_on.length > 1" :title="moreTasks(p)" x-text="$t('home.team.more_tasks', { count: p.working_on.length - 1 })"></span>
                    </p>
                  </template>
                  <p class="team-doing muted" x-show="p.working_now && p.working_on.length === 0">{{.T "home.team.no_task"}}</p>
                  <p class="team-doing muted" x-show="!p.working_now">{{.T "home.team.idle"}}</p>
                </div>
                <template x-if="p.working_now && p.working_on.length > 0">
                  <a class="btn btn-ghost btn-icon team-open" :href="'/tasks/' + p.working_on[0].task.id" :aria-label="$t('home.team.open_task', { name: p.working_on[0].task.name })" :title="$t('home.team.open_task', { name: p.working_on[0].task.name })">{{template "icon" "arrow-up-right-from-square"}}</a>
                </template>
              </li>
            </template>
          </ul>
          <nav class="pager" aria-label="{{.T "home.team.pager"}}" x-show="teamView().pages > 1">
            <span class="muted small" x-text="$t('home.team.range', { from: teamView().from, to: teamView().to, total: teamView().total })"></span>
            <div class="row row-tight">
              <button type="button" class="btn btn-secondary btn-sm" :disabled="teamView().page <= 1" @click="teamAt = teamView().page - 1">{{template "icon" "chevron-left"}} {{.T "home.team.prev"}}</button>
              <button type="button" class="btn btn-secondary btn-sm" :disabled="teamView().page >= teamView().pages" @click="teamAt = teamView().page + 1">{{.T "home.team.next"}} {{template "icon" "chevron-right"}}</button>
            </div>
          </nav>
        </section>
      </div>
    </template>
  </section>
  {{end}}

  {{/* O painel de quem abriu a página, para todos os papéis: as horas de hoje e da semana e as tarefas dela em todos os
       projetos. Os números vêm de /me/overview e a lista de /me/tasks; só o que é da própria pessoa. */}}
  <section class="stack" aria-labelledby="home-me-title">
    <div class="section-head">
      <h2 id="home-me-title">{{.T "home.me.title"}}</h2>
      <p class="muted small">{{.T "home.me.intro"}}</p>
    </div>

    <p class="muted" x-show="!mine && !errors.mine">{{.T "home.me.loading"}}</p>
    <p class="form-error" x-cloak x-show="errors.mine" x-text="errors.mine" role="alert"></p>

    <template x-if="mine">
      <div class="stack">
        <div class="kpis kpis-4">
          <div class="kpi hue-teal">
            <span class="kpi-icon">{{template "icon" "clock"}}</span>
            <div class="kpi-body">
              <span class="kpi-label">{{.T "home.me.today"}}</span>
              <span class="kpi-value" x-text="hoursText(mine.hours.today_seconds)"></span>
              <span class="kpi-hint" x-text="todayHint()"></span>
            </div>
          </div>
          <div class="kpi hue-purple">
            <span class="kpi-icon">{{template "icon" "calendar-week"}}</span>
            <div class="kpi-body">
              <span class="kpi-label">{{.T "home.me.week"}}</span>
              <span class="kpi-value" x-text="hoursText(mine.hours.week_seconds)"></span>
              <span class="kpi-hint" x-text="weekHint()"></span>
            </div>
          </div>
          <div class="kpi" :class="mine.tasks.overdue > 0 ? 'hue-orange' : 'hue-blue'">
            <span class="kpi-icon">{{template "icon" "list-check"}}</span>
            <div class="kpi-body">
              <span class="kpi-label">{{.T "home.me.open"}}</span>
              <span class="kpi-value" x-text="mine.tasks.open"></span>
              <span class="kpi-hint" :class="mine.tasks.overdue > 0 && 'text-danger'" x-text="openHint()"></span>
            </div>
          </div>
          <div class="kpi hue-green">
            <span class="kpi-icon">{{template "icon" "circle-check"}}</span>
            <div class="kpi-body">
              <span class="kpi-label">{{.T "home.me.done"}}</span>
              <span class="kpi-value" x-text="mine.tasks.closed"></span>
              <span class="kpi-hint" x-text="doneHint()"></span>
            </div>
          </div>
        </div>

        <div class="grid-aside home-me">
          <section class="stack" aria-labelledby="home-tasks-title">
            <div class="toolbar">
              <h3 id="home-tasks-title">{{.T "home.me.tasks_title"}}</h3>
              <div class="segmented" role="group" aria-label="{{.T "home.me.tasks_state"}}">
                <button type="button" :aria-pressed="myState === 'open'" @click="setMyState('open')">{{.T "home.me.tab_open"}} <span class="badge num" x-text="mine.tasks.open"></span></button>
                <button type="button" :aria-pressed="myState === 'closed'" @click="setMyState('closed')">{{.T "home.me.tab_closed"}} <span class="badge num" x-text="mine.tasks.closed"></span></button>
              </div>
            </div>

            <p class="muted" x-show="myLoading">{{.T "home.me.tasks_loading"}}</p>
            <p class="form-error" x-cloak x-show="errors.myTasks" x-text="errors.myTasks" role="alert"></p>

            <div class="empty" x-cloak x-show="!myLoading && !errors.myTasks && myTotal === 0">
              {{template "icon" "list-check"}}
              <strong x-text="myEmpty().title"></strong>
              <span x-text="myEmpty().text"></span>
            </div>

            <div class="table-wrap" x-cloak x-show="myTasks.length > 0">
              <table>
                <thead>
                  <tr><th>{{.T "tasks.col_task"}}</th><th>{{.T "tasks.col_status"}}</th><th>{{.T "tasks.col_priority"}}</th><th>{{.T "tasks.col_deadline"}}</th></tr>
                </thead>
                <tbody>
                  <template x-for="t in myTasks" :key="t.id">
                    {{/* A linha inteira abre a tarefa; o nome continua um link, para o teclado e para abrir em outra aba. */}}
                    <tr class="row-link" @click="if (!$event.target.closest('a, button')) location.href = '/tasks/' + t.id">
                      <td>
                        <a :href="'/tasks/' + t.id" x-text="t.name"></a>
                        <div class="muted small" x-text="t.project.name"></div>
                      </td>
                      <td><span class="badge" :class="statusClass(t.status)" x-text="WTT.fmt.taskStatus(t.status)"></span></td>
                      <td><span class="badge" :class="priorityClass(t.priority)" x-text="WTT.fmt.priority(t.priority)"></span></td>
                      <td><span class="badge num" :class="taskDeadlineClass(t)" x-text="taskDeadlineLabel(t)"></span></td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>

            <nav class="pager" aria-label="{{.T "home.me.pager"}}" x-cloak x-show="myTotal > 0">
              <span class="muted small" x-text="myRange()"></span>
              <div class="row row-tight" x-show="myPages() > 1">
                <button type="button" class="btn btn-secondary btn-sm" :disabled="myPage <= 1" @click="goMyPage(myPage - 1)">{{template "icon" "chevron-left"}} {{.T "home.team.prev"}}</button>
                <button type="button" class="btn btn-secondary btn-sm" :disabled="myPage >= myPages()" @click="goMyPage(myPage + 1)">{{.T "home.team.next"}} {{template "icon" "chevron-right"}}</button>
              </div>
            </nav>
          </section>

          {{/* A semana em sete colunas, de segunda a domingo. Cada dia é um item da lista com o valor por extenso
               (o rótulo curto em cima da barra e o nome do dia são só para os olhos), e o do dia de hoje vai em negrito. */}}
          <section class="card hue-teal" aria-labelledby="home-week-title">
            <div class="card-head"><h3 id="home-week-title">{{.T "home.me.week_title"}}</h3></div>
            <p class="muted small" x-text="mine.hours.week_seconds > 0 ? $t('home.me.week_chart') : $t('home.me.week_empty')"></p>
            <ol class="week-bars" aria-label="{{.T "home.me.week_chart"}}">
              <template x-for="b in bars()" :key="b.date">
                <li class="week-day" :class="b.today && 'is-today'" :title="b.label" :aria-label="b.label" :aria-current="b.today ? 'date' : null">
                  <div class="week-track">
                    <span class="week-bar" x-show="b.height > 0" :style="'height:' + b.height + '%'"><span class="week-value" aria-hidden="true" x-text="b.value"></span></span>
                  </div>
                  <span class="week-name" aria-hidden="true" x-text="b.short"></span>
                </li>
              </template>
            </ol>
            {{/* Onde as horas da semana foram: o tempo da própria pessoa em cada projeto, do que mais teve para o que menos. */}}
            <div class="stack stack-tight" x-cloak x-show="mine.hours.projects.length > 0">
              <h4 class="week-projects-title">{{.T "home.me.by_project"}}</h4>
              <ul class="week-projects">
                <template x-for="p in mine.hours.projects" :key="p.project.id">
                  <li><span class="name" x-text="p.project.name"></span><span class="time" x-text="WTT.fmt.hours(p.seconds)"></span></li>
                </template>
              </ul>
            </div>
          </section>
        </div>
      </div>
    </template>
  </section>

  <section class="stack" aria-labelledby="home-projects-title">
    <div class="toolbar">
      <div class="row row-tight">
        <h2 id="home-projects-title">{{.T "home.projects.title"}}</h2>
        <span class="badge num" x-cloak x-show="!loading" x-text="total"></span>
      </div>
      {{if .Can "projects.create"}}
      <button type="button" class="btn" @click="openCreate()">{{template "icon" "plus"}} {{.T "org.projects.new"}}</button>
      {{end}}
    </div>

    <p class="muted" x-show="loading">{{.T "org.projects.loading"}}</p>
    <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load" role="alert"></p>

    <div class="empty" x-cloak x-show="!loading && !errors.load && total === 0">
      {{template "icon" "diagram-project"}}
      <strong>{{.T "org.projects.empty"}}</strong>
      {{if .Can "projects.create"}}
      <span>{{.T "org.projects.empty_admin"}}</span>
      {{else}}
      <span>{{.T "org.projects.empty_member"}}</span>
      {{end}}
    </div>

    <div class="project-grid" x-cloak x-show="projects.length > 0">
      <template x-for="p in projects" :key="p.id">
        <a class="project-card" :class="'hue-' + hueOf(p.id)" :href="'/projects/' + p.id">
          <div class="project-top">
            <span class="project-mark" aria-hidden="true" x-text="markOf(p.name)"></span>
            <div class="project-title">
              <h3 x-text="p.name"></h3>
              <p class="project-customer" x-text="p.customer ? p.customer.name : $t('org.projects.internal')"></p>
            </div>
          </div>
          <p class="project-desc" x-show="p.description" x-text="p.description"></p>
          <div class="project-stats">
            <span class="project-stat">{{template "icon" "users"}} <span x-text="$t('home.projects.people', { count: p.member_count })"></span></span>
            <span class="project-stat">{{template "icon" "list-check"}} <span x-text="$t('home.projects.tasks', { count: p.task_count })"></span></span>
          </div>
        </a>
      </template>
    </div>

    <nav class="pager" aria-label="{{.T "home.projects.pager"}}" x-cloak x-show="total > 0">
      <span class="muted small" x-text="summary()"></span>
      <div class="row row-tight" x-show="pages() > 1">
        <button type="button" class="btn btn-secondary btn-sm" :disabled="page <= 1 || pending === 'page'" @click="go(page - 1)">{{template "icon" "chevron-left"}} {{.T "home.projects.prev"}}</button>
        <button type="button" class="btn btn-secondary btn-sm" :disabled="page >= pages() || pending === 'page'" @click="go(page + 1)">{{.T "home.projects.next"}} {{template "icon" "chevron-right"}}</button>
      </div>
    </nav>
  </section>

  {{template "project_form" .}}
  {{if and .Me .Me.NeedsOnboarding}}{{template "onboarding" .}}{{end}}
</main>
{{end}}
