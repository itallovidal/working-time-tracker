{{define "content"}}
<main class="page" x-data="projectSettings">
  {{template "project_head" .}}

  <p class="muted" x-show="loading">{{.T "common.loading"}}</p>
  <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load"></p>

  {{/* A aba só mostra o projeto, como a aba Sobre da organização. Quem altera é o modal
       Editar projeto, aberto pelo botão Editar. */}}
  <div class="stack" x-cloak x-show="!loading && !errors.load">
    <div class="toolbar">
      {{if .CanDoAny "project.edit" "billing.manage"}}
      <span class="flex-1"></span>
      <button type="button" class="btn btn-secondary" @click="openEdit()">{{template "icon" "pen"}} {{.T "common.edit"}}</button>
      {{else}}
      <p class="muted flex-1">{{.T "project_settings.intro_member"}}</p>
      {{end}}
    </div>

    <section class="card">
      <div class="card-head"><h2>{{.T "project_settings.title"}}</h2></div>
      <p class="prose" x-show="current.description" x-text="current.description"></p>
      <dl class="facts">
        <div class="fact" x-show="!current.description"><dt>{{.T "common.description_label"}}</dt><dd class="muted" x-text="WTT.notInformed"></dd></div>
        <template x-for="f in routine()" :key="f.label">
          <div class="fact"><dt x-text="f.label"></dt><dd :class="f.empty && 'muted'" x-text="f.value"></dd></div>
        </template>
      </dl>
    </section>

    <section class="card">
      <div class="card-head"><h2>{{if .CanDo "billing.view"}}{{.T "project_settings.billing_title"}}{{else}}{{.T "org.projects.customer"}}{{end}}</h2></div>
      <dl class="facts">
        <div class="fact">
          <dt>{{.T "org.projects.customer"}}</dt>
          <dd :class="!current.customer && 'muted'" x-text="current.customer ? current.customer.name : $t('project_settings.internal')"></dd>
        </div>
        <div class="fact" x-show="current.customer">
          <dt>{{.T "project.fields.meeting"}}</dt>
          <dd :class="!current.customer_meeting_day && 'muted'" x-text="meeting()"></dd>
        </div>
        {{if .CanDo "billing.view"}}
        {{/* A cobrança mora no cliente (Decisão 21): a do cliente, o acréscimo do projeto e o valor por hora que sai dos
             dois (no mensal, o contrato não tem valor por hora). */}}
        <div class="fact" x-show="current.customer">
          <dt>{{.T "project.billing.customer_terms"}}</dt>
          <dd><span x-text="billing.customer(currentCustomer())"></span>{{if .Can "customers.manage"}} · <a :href="'/orgs/{{.OrgID}}/projects?customer=' + current.customer.id">{{.T "project.billing.edit_in_customers"}}</a>{{end}}</dd>
        </div>
        <div class="fact" x-show="current.customer">
          <dt>{{.T "project.billing.extra_fact"}}</dt>
          <dd class="num" :class="!billExtraCents && 'muted'" x-text="extraFact()"></dd>
        </div>
        <div class="fact">
          <dt>{{.T "project_settings.bill_rate_fact"}}</dt>
          <dd class="num" :class="billRateCents === null && 'muted'" x-text="billRateCents !== null ? WTT.fmt.money(billRateCents) : (billingMode === 'monthly' ? $t('customer.billing.project_rate_monthly') : WTT.notInformed)"></dd>
        </div>
        {{end}}
      </dl>
      {{if .CanDo "billing.view"}}
      <p class="muted small">{{if .Me.OrganizationSolo}}{{.T "project_settings.bill_rate_note_solo"}}{{else}}{{.T "project_settings.bill_rate_note"}}{{end}}</p>
      {{end}}
    </section>
  </div>

  {{if .CanDoAny "project.edit" "billing.manage"}}
  {{/* Editar projeto: nada vai para o servidor antes de Salvar, então Cancelar desfaz tudo.
       Os campos seguem a ordem do modal Novo projeto. */}}
  <template x-teleport="#modal-root">
    <form class="stack" novalidate x-show="$store.modal.name === 'project-edit'" @submit.prevent="save()">
      {{if .CanDo "project.edit"}}
      <fieldset class="form-group">
        <legend>{{.T "project.groups.about"}}</legend>
        <div class="field">
          <label for="ps-name">{{.T "common.name"}}</label>
          <input id="ps-name" type="text" maxlength="{{limit "name"}}" data-field="name" x-model="draft.name" @input="clearField('name')"
                 :aria-invalid="fieldErrors.name ? 'true' : 'false'" data-autofocus>
          {{template "field_error" "name"}}
        </div>
        <div class="field">
          {{template "field_label" (dict "D" . "For" "ps-description" "Key" "common.description_label" "Optional" true)}}
          <textarea id="ps-description" maxlength="{{limit "description"}}" data-field="description" x-model="draft.description"
                    @input="clearField('description')" :aria-invalid="fieldErrors.description ? 'true' : 'false'"></textarea>
          <span class="hint num" x-text="Array.from(draft.description).length + '/{{limit "description"}}'"></span>
          {{template "field_error" "description"}}
        </div>
      </fieldset>
      {{end}}
      {{/* O cliente: o seletor, para quem cuida da cobrança e dos clientes, e a reunião, para quem edita o projeto. Sem o
           seletor, o grupo some num projeto interno, que não tem reunião com cliente. */}}
      {{$picksCustomer := and (.CanDo "billing.manage") (.Can "customers.manage")}}
      {{if or $picksCustomer (.CanDo "project.edit")}}
      <fieldset class="form-group"{{if not $picksCustomer}} x-cloak x-show="draft.customer_id"{{end}}>
        <legend>{{.T "project.groups.customer"}}</legend>
        {{if $picksCustomer}}
        <div class="field">
          <label for="ps-customer">{{.T "org.projects.customer"}}</label>
          <select id="ps-customer" data-field="customer_id" x-model="draft.customer_id" @change="customerChanged()"
                  :aria-invalid="fieldErrors.customer_id ? 'true' : 'false'">
            <option value="">{{.T "project_settings.internal"}}</option>
            <template x-for="c in customers" :key="c.id">
              <option :value="c.id" x-text="customerOption(c)" :selected="c.id === draft.customer_id"></option>
            </template>
          </select>
          {{template "field_error" "customer_id"}}
          <span class="hint">{{.T "project_settings.customers_hint"}} <a href="/orgs/{{.OrgID}}/projects">{{.T "nav.customers_projects"}}</a>.</span>
        </div>
        {{end}}
        {{if .CanDo "project.edit"}}
        {{template "project_customer_meeting" .}}
        {{end}}
      </fieldset>
      {{end}}
      {{/* A cobrança do cliente, só para leitura, e o acréscimo do projeto em Avançado: o mesmo grupo do Novo projeto. */}}
      {{if .CanDo "billing.manage"}}
      {{template "project_billing_group" (dict "Data" . "Id" "ps" "Customer" "draftCustomer()")}}
      {{end}}
      {{if .CanDo "project.edit"}}
      <fieldset class="form-group">
        <legend>{{.T "project.groups.routine"}}</legend>
        <div class="field">
          <label for="ps-sprint">{{.T "project.fields.sprint"}}</label>
          <select id="ps-sprint" data-field="sprint_duration_days" x-model.number="draft.sprint_duration_days"
                  @change="clearField('sprint_duration_days')" :aria-invalid="fieldErrors.sprint_duration_days ? 'true' : 'false'">
            <template x-for="o in sprintChoices()" :key="o.value">
              <option :value="o.value" x-text="o.label" :selected="o.value === draft.sprint_duration_days"></option>
            </template>
          </select>
          {{template "field_error" "sprint_duration_days"}}
        </div>
        {{template "project_routine" .}}
      </fieldset>
      {{end}}
      <p class="form-error" x-show="errors.save" x-text="errors.save" role="alert"></p>
      <p class="form-error" x-show="errors.delete" x-text="errors.delete" role="alert"></p>
      {{if .CanDo "project.delete"}}
      <div class="confirm" x-cloak x-show="confirmDelete">
        <span>{{if .Me.OrganizationSolo}}{{.T "project_settings.delete_confirm_solo"}}{{else}}{{.T "project_settings.delete_confirm"}}{{end}}</span>
        <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="remove()">{{.T "common.delete"}}</button>
        <button type="button" class="btn btn-ghost btn-sm" @click="confirmDelete = false">{{.T "common.cancel"}}</button>
      </div>
      {{end}}
      <div class="toolbar" x-show="!confirmDelete">
        {{if .CanDo "project.delete"}}
        <button type="button" class="btn btn-danger-ghost" @click="confirmDelete = true">{{template "icon" "trash"}} {{.T "project_settings.delete_title"}}</button>
        {{end}}
        <div class="row">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
          <button type="submit" class="btn" :disabled="pending">{{.T "common.save"}}</button>
        </div>
      </div>
    </form>
  </template>
  {{end}}
</main>
{{end}}
