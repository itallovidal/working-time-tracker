{{define "content"}}
<main class="page" x-data="orgAbout">
  {{/* A página Configurações é o perfil da organização, que todos leem; o resumo dela, quando há, é a frase do
       cabeçalho. Só o dono tem o Editar. */}}
  <div class="page-head">
    <div>
      <div class="eyebrow" data-org-name>{{.Me.OrganizationName}}</div>
      <h1>{{.T "nav.settings"}}</h1>
      {{$summary := ""}}{{with .Org}}{{$summary = .Summary}}{{end}}
      <p class="lede">{{if $summary}}{{$summary}}{{else}}{{.T "org.about.intro"}}{{end}}</p>
    </div>
    {{if .IsOwner}}<a class="btn btn-secondary" href="/orgs/{{.OrgID}}/settings">{{template "icon" "pen"}} {{.T "common.edit"}}</a>{{end}}
  </div>

  {{/* Os cartões ficam um embaixo do outro, na largura toda. */}}
  <div class="stack" x-cloak>
    {{if .IsOwner}}
    <p class="alert" x-show="isEmpty()">
      {{.T "org.about.empty_profile"}} <a href="/orgs/{{.OrgID}}/settings">{{.T "org.about.fill_profile"}}</a>
    </p>
    {{end}}

    <section class="card">
      <div class="card-head"><h2>{{template "icon" "id-card"}} {{.T "org.about.identity"}}</h2></div>
      <p class="prose" x-show="org.description" x-text="org.description"></p>
      <dl class="facts">
        <div class="fact" x-show="!org.description"><dt>{{.T "common.description_label"}}</dt><dd class="muted" x-text="WTT.notInformed"></dd></div>
        <template x-for="f in identity()" :key="f.label">
          <div class="fact"><dt x-text="f.label"></dt><dd :class="f.empty && 'muted'" x-text="f.value"></dd></div>
        </template>
      </dl>
    </section>

    <section class="card">
      <div class="card-head"><h2>{{template "icon" "briefcase"}} {{.T "org.about.how_we_work"}}</h2></div>
      <dl class="facts">
        <template x-for="f in defaults()" :key="f.label">
          <div class="fact"><dt x-text="f.label"></dt><dd :class="f.empty && 'muted'" x-text="f.value"></dd></div>
        </template>
      </dl>
    </section>

    <section class="card">
      <div class="card-head"><h2>{{template "icon" "address-book"}} {{.T "org.about.contact"}}</h2></div>
      <dl class="facts">
        <template x-for="f in contact()" :key="f.label">
          <div class="fact">
            <dt x-text="f.label"></dt>
            <dd>
              <a x-show="f.href" :href="f.href" :target="f.external ? '_blank' : null" :rel="f.external ? 'noopener noreferrer' : null" x-text="f.value"></a>
              <span x-show="!f.href" :class="f.empty && 'muted'" x-text="f.value"></span>
            </dd>
          </div>
        </template>
      </dl>
    </section>

    <section class="card">
      <div class="card-head"><h2>{{template "icon" "scale-balanced"}} {{.T "org.about.company"}}</h2></div>
      <dl class="facts">
        <template x-for="f in legal()" :key="f.label">
          <div class="fact"><dt x-text="f.label"></dt><dd :class="{ mono: f.mono, muted: f.empty }" x-text="f.value"></dd></div>
        </template>
      </dl>
    </section>
  </div>
</main>
{{end}}
