{{define "content"}}
<main class="page" x-data="orgAbout">
  {{template "org_head" .}}

  {{/* Os cartões ficam um embaixo do outro, na largura toda, como nas outras abas. */}}
  <div class="stack" x-cloak>
    {{if .IsAdmin}}
    <div class="toolbar">
      <p class="muted flex-1">O que todos os membros leem sobre a organização.</p>
      <a class="btn btn-secondary" href="/orgs/{{.OrgID}}/settings">{{template "icon" "pen"}} Editar</a>
    </div>
    <p class="alert" x-show="isEmpty()">
      O perfil da organização ainda está vazio. <a href="/orgs/{{.OrgID}}/settings">Preencha os dados</a> para o time ver aqui.
    </p>
    {{end}}

    <section class="card">
      <div class="card-head"><h2>Sobre</h2></div>
      <p class="prose" x-show="org.description" x-text="org.description"></p>
      <dl class="facts">
        <div class="fact" x-show="!org.description"><dt>Descrição</dt><dd class="muted" x-text="WTT.notInformed"></dd></div>
        <template x-for="f in identity()" :key="f.label">
          <div class="fact"><dt x-text="f.label"></dt><dd :class="f.empty && 'muted'" x-text="f.value"></dd></div>
        </template>
      </dl>
    </section>

    <section class="card">
      <div class="card-head"><h2>Como trabalhamos</h2></div>
      <dl class="facts">
        <template x-for="f in defaults()" :key="f.label">
          <div class="fact"><dt x-text="f.label"></dt><dd :class="f.empty && 'muted'" x-text="f.value"></dd></div>
        </template>
      </dl>
    </section>

    <section class="card">
      <div class="card-head"><h2>Contato</h2></div>
      <dl class="facts">
        <template x-for="f in contact()" :key="f.label">
          <div class="fact">
            <dt x-text="f.label"></dt>
            <dd>
              <a x-show="f.href" :href="f.href" :target="f.external ? '_blank' : null" :rel="f.external ? 'noopener noreferrer' : null" x-text="f.value"></a>
              <span x-show="!f.href" :class="f.empty && 'muted'" x-text="f.value"></span>
            </dd>
          </div>
        </template>
      </dl>
    </section>

    <section class="card">
      <div class="card-head"><h2>Dados da empresa</h2></div>
      <dl class="facts">
        <template x-for="f in legal()" :key="f.label">
          <div class="fact"><dt x-text="f.label"></dt><dd :class="{ mono: f.mono, muted: f.empty }" x-text="f.value"></dd></div>
        </template>
      </dl>
    </section>
  </div>
</main>
{{end}}
