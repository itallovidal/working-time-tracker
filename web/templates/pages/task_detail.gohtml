{{define "content"}}
<main class="page" x-data="taskDetail">
  {{/* A tarefa é uma tela própria, e não uma aba do projeto: sem a barra de abas, com um cabeçalho que
       diz de onde se veio (o projeto e o quadro) e leva de volta. O título vem do servidor e passa a
       ser o da tarefa carregada, para o cabeçalho não pular quando a página termina de carregar. */}}
  <header class="task-head">
    <a class="btn btn-ghost btn-sm self-start" href="/projects/{{.Project.ID}}/tasks" :href="backHref()">{{template "icon" "arrow-left"}} {{.T "task_detail.back"}}</a>
    <div class="page-head">
      <div>
        <nav class="eyebrow" aria-label="{{.T "task_detail.breadcrumb"}}">
          <a href="/orgs/{{.OrgID}}">{{.T "project.head.projects"}}</a> /
          <a href="/projects/{{.Project.ID}}/overview">{{.Project.Name}}</a>
        </nav>
        <h1 class="task-title" x-text="task ? task.name : $el.textContent">{{.Task.Name}}</h1>
      </div>
      <div class="row" x-cloak x-show="task">
        <span class="badge badge-ok" x-show="isRunning()">{{.T "tasks.running"}}</span>
        <button type="button" class="btn btn-secondary btn-sm" x-show="isRunning()" @click="openSession()">{{template "icon" "list-check"}} {{.T "session.details"}}</button>
        {{/* Parado, inicia o ponto; com o ponto aberto neste projeto, põe a tarefa na sessão; num outro projeto, fica de fora. */}}
        <button type="button" class="btn btn-secondary btn-sm" x-show="!isRunning() && !sessionHere()" :disabled="pending || otherProject()" @click="start()">{{template "icon" "play"}} {{.T "tasks.start"}}</button>
        <button type="button" class="btn btn-secondary btn-sm" x-show="!isRunning() && sessionHere()" :disabled="pending" @click="addToSession()">{{template "icon" "plus"}} {{.T "session.add_to_session"}}</button>
        <button type="button" class="btn btn-ghost btn-sm" aria-label="{{.T "task_detail.edit_title"}}" title="{{.T "task_detail.edit_title"}}" @click="openEdit()">{{template "icon" "pen"}}</button>
      </div>
    </div>
    <p class="form-error" x-show="errors.clock" x-text="errors.clock" role="alert"></p>
    <p class="muted small" x-cloak x-show="otherProject()">{{.T "time.other_project"}}</p>
  </header>

  <p class="muted" x-show="loading">{{.T "task_detail.loading"}}</p>
  <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load"></p>

  {{/* Quatro cartões em duas colunas: a descrição e o tempo registrado, de um lado;
       os detalhes e o item externo, do outro. Em tela estreita a coluna some e os cartões seguem a
       ordem do `order`: a descrição, os detalhes, o tempo e o item externo. */}}
  <div class="task-layout" x-cloak x-show="!loading && task">
    <div class="task-col">
      {{/* A página só mostra. Quem altera é o modal Editar tarefa, aberto pelo lápis do cabeçalho. */}}
      <section class="card task-main">
        <div class="card-head"><h2>{{.T "common.description_label"}}</h2></div>
        <div class="task-description">
          <div class="markdown" x-show="task && task.description" x-html="WTT.markdown(task && task.description)"></div>
          <p class="muted small" x-show="task && !task.description">{{.T "task_detail.no_description"}}</p>
        </div>
      </section>

      <section class="card task-time">
        <div class="card-head">
          <h2>{{.T "task_detail.time_title"}}</h2>
          <span class="mono num" x-text="WTT.fmt.hours(totalSeconds())"></span>
        </div>
        <p class="muted small" x-show="sessions.length === 0">{{.T "task_detail.no_time"}}</p>
        <ul class="list" x-show="sessions.length > 0">
          <template x-for="s in sessions" :key="s.id">
            <li>
              <div class="grow">
                <div x-text="s.person ? s.person.name : ''"></div>
                <div class="muted small">
                  <span x-text="WTT.fmt.dateTime(s.start_at)"></span>
                  <span x-text="s.end_at ? '– ' + WTT.fmt.time(s.end_at) : $t('task_detail.in_progress')"></span>
                </div>
                {{/* O tempo da tarefa na sessão, que pode ser parte dela; e o que mais se fez junto. */}}
                <div class="muted small" x-show="otherTasks(s)" x-text="$t('task_detail.with_tasks', { names: otherTasks(s) }) + ' · ' + $t('task_detail.session_total', { time: WTT.fmt.hours($store.clock.elapsed(s)) })"></div>
              </div>
              <span class="mono num" x-text="WTT.fmt.clock(taskTime(s))"></span>
              <button type="button" class="btn btn-ghost btn-sm" aria-label="{{.T "session.details"}}" title="{{.T "session.details"}}" @click="openSession(s)">{{template "icon" "eye"}}</button>
            </li>
          </template>
        </ul>
      </section>
    </div>

    <div class="task-col">
      {{/* Os detalhes ficam num cartão à parte do nome e da descrição: cada linha é um atributo da tarefa. */}}
      <section class="card task-details" aria-labelledby="task-details-title">
        <div class="card-head"><h2 id="task-details-title">{{.T "task_detail.details_title"}}</h2></div>
        <dl class="detail-list">
          <div class="detail-row">
            <dt>{{.T "tasks.col_status"}}</dt>
            <dd><span class="badge" :class="statusClass(task && task.status)" x-text="task && WTT.fmt.taskStatus(task.status)"></span></dd>
          </div>
          <div class="detail-row">
            <dt>{{.T "tasks.col_priority"}}</dt>
            <dd>
              <span class="badge" :class="priorityClass(task && task.priority)" x-text="task && WTT.fmt.priority(task.priority)"></span>
            </dd>
          </div>
          <div class="detail-row">
            <dt>{{.T "tasks.col_assignee"}}</dt>
            <dd>
              <div class="person-line" x-show="task && task.assignee">
                <span class="avatar" aria-hidden="true" x-text="task && task.assignee ? WTT.fmt.initials(task.assignee.name) : ''"></span>
                <span class="grow">
                  <span class="person-name" x-text="task && task.assignee ? task.assignee.name : ''"></span>
                  <span class="muted small person-email" x-text="task && task.assignee ? task.assignee.email : ''"></span>
                </span>
              </div>
              <div x-show="task && !task.assignee">
                <span class="badge">{{.T "tasks.unassigned"}}</span>
                <p class="muted small hint-line">{{.T "tasks.unassigned_hint"}}</p>
              </div>
            </dd>
          </div>
          <div class="detail-row">
            <dt>{{.T "tasks.col_deadline"}}</dt>
            <dd><span class="badge num" :class="deadlineClass()" x-text="deadlineLabel()"></span></dd>
          </div>
          <div class="detail-row">
            <dt>{{.T "tasks.labels"}}</dt>
            <dd>
              <div class="label-list label-list-flush" x-show="task && task.labels && task.labels.length > 0">
                <template x-for="l in (task ? task.labels : [])" :key="l.id"><span class="badge" x-text="l.name"></span></template>
              </div>
              <span class="muted" x-show="task && (!task.labels || task.labels.length === 0)">{{.T "tasks.no_labels"}}</span>
            </dd>
          </div>
          <div class="detail-row">
            <dt>{{.T "task_detail.created"}}</dt>
            <dd class="num" x-text="task ? WTT.fmt.date(task.created_at) : ''"></dd>
          </div>
        </dl>
      </section>

      <section class="card task-external">
        <div class="card-head"><h2>{{.T "task_detail.external"}}</h2></div>
        <template x-if="task && task.external_item_id">
          <div class="stack">
            <div>
              <span class="badge badge-accent" x-text="externalLabel()"></span>
            </div>
            <p class="muted small" x-show="external.loading">{{.T "task_detail.loading_details"}}</p>
            <template x-if="external.details">
              <div class="stack">
                <a :href="external.details.url" target="_blank" rel="noopener" x-text="external.details.title"></a>
                <span class="badge" :class="external.details.state === 'open' || external.details.state === 'opened' ? 'badge-ok' : ''"
                      x-text="$t('task_detail.state', { state: external.details.state })"></span>
              </div>
            </template>
            <p class="alert alert-warn" x-show="external.error">
              {{.T "task_detail.fetch_failed"}} <span x-text="external.error"></span>
              <a :href="task.external_item_url" target="_blank" rel="noopener">{{.T "task_detail.open_link"}}</a>
            </p>
            <p class="form-error" x-show="errors.unlink" x-text="errors.unlink" role="alert"></p>
            <div class="row"><button type="button" class="btn btn-danger-ghost" :disabled="pending" @click="unlink()">{{.T "task_detail.unlink"}}</button></div>
          </div>
        </template>
        <template x-if="task && !task.external_item_id">
          <form class="stack" @submit.prevent="link()">
            <p class="muted small" x-show="integrations.length === 0">
              {{.T "task_detail.no_integrations"}}
              {{if .Can "integrations.manage"}}<a href="/projects/{{.Project.ID}}/management/integrations">{{.T "task_detail.configure"}}</a>{{else}}{{.T "task_detail.ask_admin"}}{{end}}
            </p>
            <template x-if="integrations.length > 0">
              <div class="stack">
                <div class="field">
                  <label for="td-integration">{{.T "task_detail.integration"}}</label>
                  <select id="td-integration" x-model="linkForm.integration_id">
                    <template x-for="i in integrations" :key="i.id">
                      <option :value="i.id" x-text="i.display_name + ' (' + typeLabel(i.type) + ')'" :selected="i.id === linkForm.integration_id"></option>
                    </template>
                  </select>
                </div>
                {{/* O que identifica o item muda com a plataforma: o número da issue, o cartão. */}}
                <div class="field">
                  <label for="td-item" x-text="linkType().item_label || $t('tasks.item')">{{.T "tasks.item"}}</label>
                  <input id="td-item" type="text" autocomplete="off" :inputmode="linkType().item_numeric ? 'numeric' : 'text'"
                         :placeholder="linkType().item_placeholder || ''" x-model="linkForm.external_item_id">
                </div>
                <div class="field">
                  <label for="td-url">{{.T "task_detail.link"}}</label>
                  <input id="td-url" type="url" placeholder="https://…" x-model="linkForm.external_item_url">
                </div>
                <p class="form-error" x-show="errors.link" x-text="errors.link" role="alert"></p>
                <button type="submit" class="btn btn-secondary" :disabled="pending">{{.T "task_detail.link_action"}}</button>
              </div>
            </template>
          </form>
        </template>
      </section>
    </div>
  </div>

  {{/* Editar tarefa: nada vai para o servidor antes de Salvar, então Cancelar desfaz tudo. */}}
  <template x-teleport="#modal-root">
    <form class="stack" novalidate x-show="$store.modal.name === 'task-edit'" @submit.prevent="submitStep('save')">
      {{template "task_fields" .}}
      <p class="form-error" x-show="errors.save" x-text="errors.save" role="alert"></p>
      <p class="form-error" x-show="errors.delete" x-text="errors.delete" role="alert"></p>
      <div class="row row-end" x-show="step === 1">
        <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
        <button type="submit" class="btn">{{.T "tasks.wizard.next"}} {{template "icon" "arrow-right"}}</button>
      </div>
      <div class="confirm" x-cloak x-show="step === 2 && confirmDelete">
        <span>{{.T "task_detail.delete_confirm"}}</span>
        <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="remove()">{{.T "common.delete"}}</button>
        <button type="button" class="btn btn-ghost btn-sm" @click="confirmDelete = false">{{.T "common.cancel"}}</button>
      </div>
      <div class="toolbar" x-show="step === 2 && !confirmDelete">
        <button type="button" class="btn btn-danger-ghost" @click="confirmDelete = true">{{template "icon" "trash"}} {{.T "task_detail.delete_title"}}</button>
        <div class="row">
          <button type="button" class="btn btn-secondary" @click="back()">{{template "icon" "arrow-left"}} {{.T "tasks.wizard.back"}}</button>
          <button type="submit" class="btn" :disabled="pending">{{.T "common.save"}}</button>
        </div>
      </div>
    </form>
  </template>
</main>
{{end}}
