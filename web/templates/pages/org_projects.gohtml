{{define "content"}}
<main class="page" x-data="orgProjects">
  {{template "org_head" .}}

  <div class="toolbar">
    <p class="muted">{{.T "org.projects.intro"}}</p>
    <button type="button" class="btn" @click="openCreate()">{{template "icon" "plus"}} {{.T "org.projects.new"}}</button>
  </div>

  {{template "project_form" .}}

  <p class="muted" x-show="loading">{{.T "org.projects.loading"}}</p>
  <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load"></p>

  <div class="empty" x-cloak x-show="!loading && !errors.load && projects.length === 0">
    {{template "icon" "diagram-project"}}
    <strong>{{.T "org.projects.empty"}}</strong>
    <span>{{.T "org.projects.empty_admin"}}</span>
  </div>

  {{/* A aba do admin é uma tabela de gestão; os cartões ficam na página inicial, para quem
       entra para trabalhar num projeto. */}}
  <div class="table-wrap" x-cloak x-show="projects.length > 0">
    <table>
      <thead>
        <tr><th>{{.T "org.projects.col_project"}}</th><th>{{.T "org.projects.col_customer"}}</th><th title="{{.T "org.projects.col_people_title"}}">{{.T "org.projects.col_people"}}</th><th>{{.T "org.projects.col_tasks"}}</th></tr>
      </thead>
      <tbody>
        <template x-for="p in projects" :key="p.id">
          {{/* A linha inteira abre o projeto; o clique no link fica com o navegador. */}}
          <tr class="row-link" @click="if (!$event.target.closest('a')) location.href = '/projects/' + p.id">
            <td><a :href="'/projects/' + p.id" x-text="p.name"></a></td>
            <td>
              <span x-show="p.customer" x-text="p.customer && p.customer.name"></span>
              <span class="muted" x-show="!p.customer">{{.T "org.projects.internal"}}</span>
            </td>
            <td class="num" x-text="p.member_count"></td>
            <td class="num" x-text="p.task_count"></td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</main>
{{end}}
