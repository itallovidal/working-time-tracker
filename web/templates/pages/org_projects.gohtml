{{define "content"}}
<main class="page" x-data="orgProjects">
  {{if .Tab}}
  {{template "org_head" .}}

  <div class="toolbar">
    <p class="muted">Cada projeto tem seus times, tarefas e registro de tempo.</p>
    <button type="button" class="btn" @click="openCreate()" x-show="!creating">Novo projeto</button>
  </div>
  {{else}}
  <div class="page-head">
    <div>
      <div class="eyebrow">{{.Me.OrganizationName}}</div>
      <h1>Projetos</h1>
      <p class="lede">Cada projeto tem seus times, tarefas e registro de tempo.</p>
    </div>
    {{if .IsAdmin}}
    <button type="button" class="btn" @click="openCreate()" x-show="!creating">Novo projeto</button>
    {{end}}
  </div>
  {{end}}

  {{if .IsAdmin}}
  <form class="card" x-cloak x-show="creating" @submit.prevent="create()">
    <div class="card-head"><h2>Novo projeto</h2></div>
    <div class="fields">
      <div class="field">
        <label for="project-name">Nome</label>
        <input id="project-name" type="text" required x-model="draft.name" x-ref="name">
      </div>
      <div class="field">
        <label for="project-sprint">Duração da sprint (dias)</label>
        <input id="project-sprint" type="number" min="1" max="90" x-model.number="draft.sprint_duration_days">
      </div>
      <div class="field">
        <label for="project-daily">Horário da daily</label>
        <input id="project-daily" type="time" x-model="draft.daily_time">
      </div>
      <div class="field">
        <label for="project-weekly">Dia da weekly</label>
        <select id="project-weekly" x-model="draft.weekly_sync_day">
          <option value="">Sem weekly</option>
          <template x-for="d in WTT.weekdays" :key="d.value">
            <option :value="d.value" x-text="d.label"></option>
          </template>
        </select>
      </div>
    </div>
    <div class="field">
      <label for="project-description">Descrição</label>
      <textarea id="project-description" x-model="draft.description" placeholder="Opcional"></textarea>
    </div>
    <p class="form-error" x-show="errors.create" x-text="errors.create" role="alert"></p>
    <div class="row row-end">
      <button type="button" class="btn btn-secondary" @click="creating = false">Cancelar</button>
      <button type="submit" class="btn" :disabled="pending">Criar projeto</button>
    </div>
  </form>
  {{end}}

  <p class="muted" x-show="loading">Carregando projetos…</p>
  <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load"></p>

  <div class="empty" x-cloak x-show="!loading && !errors.load && projects.length === 0">
    <strong>Nenhum projeto ainda</strong>
    {{if .IsAdmin}}
    <span>Crie o primeiro projeto para montar os times e começar a registrar tempo.</span>
    {{else}}
    <span>Quando um admin criar um projeto, ele aparece aqui.</span>
    {{end}}
  </div>

  <div class="project-grid" x-show="projects.length > 0">
    <template x-for="p in projects" :key="p.id">
      <a class="project-card" :href="'/projects/' + p.id">
        <h3 x-text="p.name"></h3>
        <p class="muted small" x-show="p.description" x-text="p.description"></p>
        <div class="project-meta">
          <span class="badge num" x-text="'Sprint de ' + p.sprint_duration_days + ' dias'"></span>
          <span class="badge num" x-show="p.daily_time" x-text="'Daily ' + p.daily_time"></span>
          <span class="badge" x-show="p.weekly_sync_day" x-text="'Weekly ' + WTT.fmt.weekday(p.weekly_sync_day)"></span>
        </div>
      </a>
    </template>
  </div>
</main>
{{end}}
