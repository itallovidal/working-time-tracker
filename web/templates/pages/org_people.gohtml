{{define "content"}}
<main class="page" x-data="orgPeople">
  {{template "org_head" .}}

  <section class="stack">
    <div class="toolbar">
      <div class="stack stack-tight flex-1">
        <h2>{{.T "org.people.title"}}</h2>
        <p class="muted">{{.T "org.people.intro"}}</p>
      </div>
      <button type="button" class="btn" @click="openInvite()">{{template "icon" "user-plus"}} {{.T "org.people.add"}}</button>
    </div>

    <p class="muted" x-show="loading">{{.T "org.people.loading"}}</p>
    <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load"></p>
    <div class="table-wrap" x-show="people.length > 0">
      <table>
        <thead>
          <tr><th>{{.T "common.name"}}</th><th>{{.T "common.email"}}</th><th>{{.T "common.role"}}</th><th>{{.T "org.people.weekly_hours"}}</th><th class="actions"><span class="sr-only">{{.T "common.actions"}}</span></th></tr>
        </thead>
        <tbody>
          <template x-for="p in people" :key="p.id">
            {{/* O papel muda direto na linha. A jornada semanal muda no modal, pelo lápis. */}}
            <tr>
              <td>
                <span x-text="p.name"></span>
                <span class="badge" x-show="p.id === me.id">{{.T "common.you"}}</span>
              </td>
              <td class="muted" x-text="p.email"></td>
              <td><span class="badge" :class="p.role === 'admin' && 'badge-accent'" x-text="p.is_owner ? $t('roles.owner') : WTT.fmt.role(p.role)"></span></td>
              <td class="nowrap num" :class="!p.weekly_hours && 'muted'" x-text="WTT.fmt.weeklyHours(p.weekly_hours) || $t('labels.weekly_hours_none')"></td>
              <td class="actions">
                {{/* O papel só muda pelo dono, e o dono é sempre admin. */}}
                <button type="button" class="btn btn-ghost btn-sm" :disabled="pending" x-show="me.is_owner && !p.is_owner"
                        @click="setRole(p, p.role === 'admin' ? 'member' : 'admin')"
                        x-text="p.role === 'admin' ? $t('org.people.make_member') : $t('org.people.make_admin')"></button>
                <button type="button" class="btn btn-ghost btn-sm btn-icon" title="{{.T "org.people.edit_title"}}"
                        :aria-label="$t('org.people.edit_label', { name: p.name })" @click="openEdit(p)">{{template "icon" "pen"}}</button>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </section>

  <section class="stack">
    <div class="stack stack-tight">
      <h2>{{.T "org.people.pending_title"}}</h2>
      <p class="muted">{{.T "org.people.pending_intro"}}</p>
    </div>

    <p class="form-error" x-cloak x-show="errors.revoke" x-text="errors.revoke" role="alert"></p>

    <div class="empty" x-cloak x-show="!loading && !errors.load && invites.length === 0">
      {{template "icon" "envelope-open-text"}}
      <strong>{{.T "org.people.no_invites"}}</strong>
      <span>{{.T "org.people.no_invites_text"}}</span>
    </div>

    <div class="table-wrap" x-cloak x-show="invites.length > 0">
      <table>
        <thead>
          <tr><th>{{.T "common.email"}}</th><th>{{.T "common.role"}}</th><th>{{.T "org.people.col_project"}}</th><th>{{.T "org.people.expires"}}</th><th class="actions"><span class="sr-only">{{.T "common.actions"}}</span></th></tr>
        </thead>
        <tbody>
          <template x-for="inv in invites" :key="inv.id">
            <tr>
              <td>
                <span x-show="inv.email" x-text="inv.email"></span>
                <span class="muted" x-show="!inv.email">{{.T "org.people.any_email"}}</span>
              </td>
              <td><span class="badge" :class="inv.role === 'admin' && 'badge-accent'" x-text="WTT.fmt.role(inv.role)"></span></td>
              <td>
                <span x-show="inv.project" x-text="inv.project && inv.project.project_name"></span>
                <span class="muted" x-show="!inv.project">{{.T "org.people.no_project"}}</span>
              </td>
              <td class="nowrap num" x-text="WTT.fmt.date(inv.expires_at)"></td>
              <td class="actions">
                <button type="button" class="btn btn-danger-ghost btn-sm" :disabled="pending" @click="revoke(inv)">{{template "icon" "ban"}} {{.T "org.people.revoke"}}</button>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </section>

  {{/* Jornada semanal da pessoa. Nada vai para o servidor antes de Salvar. */}}
  <template x-teleport="#modal-root">
    <form class="stack" x-show="$store.modal.name === 'person-edit'" @submit.prevent="savePerson()">
      <div class="row" x-show="editing">
        <span class="avatar" aria-hidden="true" x-text="WTT.fmt.initials(editing && editing.name)"></span>
        <div>
          <div><strong x-text="editing && editing.name"></strong> <span class="badge" x-show="editing && editing.id === me.id">{{.T "common.you"}}</span></div>
          <div class="muted small" x-text="editing && editing.email"></div>
        </div>
      </div>
      {{if .Can "people.manage"}}
      <div class="field">
        <label for="person-weekly-hours">{{.T "org.people.weekly_hours_label"}}</label>
        <input id="person-weekly-hours" type="number" min="1" max="168" step="1" class="num" placeholder="{{.T "labels.weekly_hours_none"}}"
               x-model="draft.weekly_hours" data-autofocus>
        <span class="hint">{{.T "org.people.weekly_hours_hint"}}</span>
      </div>
      {{end}}
      {{/* As permissões da organização: só o dono libera, e só a quem não é admin. */}}
      {{if .IsOwner}}
      <div class="field" role="group" aria-labelledby="person-permissions-label" x-show="editing">
        <span class="field-label" id="person-permissions-label">{{.T "org.people.permissions_title"}}</span>
        <p class="muted small" x-show="editing && editing.is_owner">{{.T "org.people.permissions_owner"}}</p>
        <p class="muted small" x-show="editing && !editing.is_owner && editing.role === 'admin'">{{.T "org.people.permissions_admin"}}</p>
        <ul class="list picker" x-show="canGrant(editing)">
          <template x-for="k in orgKeys" :key="k">
            <li>
              <label class="pick">
                <input type="checkbox" :value="k" x-model="draft.permissions">
                <span class="grow">
                  <span x-text="$t('permissions.keys.' + k.replace('.', '_') + '.name')"></span>
                  <span class="muted small" x-text="$t('permissions.keys.' + k.replace('.', '_') + '.about')"></span>
                </span>
              </label>
            </li>
          </template>
        </ul>
        <span class="hint" x-show="canGrant(editing)">{{.T "org.people.permissions_hint"}}</span>
      </div>
      {{end}}
      <p class="form-error" x-show="errors.edit" x-text="errors.edit" role="alert"></p>
      <div class="row row-end">
        <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
        <button type="submit" class="btn" :disabled="pending">{{.T "common.save"}}</button>
      </div>
    </form>
  </template>

  {{/* O formulário aparece no modal do layout base, mas continua no escopo de orgPeople. Com o Clerk ligado
       (emailInvites) o convite com email sai por email; sem email, ou sem o Clerk, é o link para copiar. */}}
  <template x-teleport="#modal-root">
    <form class="stack" x-show="$store.modal.name === 'invite'" @submit.prevent="createInvite()">
      <div class="stack" x-show="!lastLink">
        <p class="muted small">{{if .Props.emailInvites}}{{.T "org.people.invite_intro_email"}}{{else}}{{.T "org.people.invite_intro"}}{{end}}</p>
        <div class="field">
          <label for="invite-email">{{.T "common.email"}}</label>
          <input id="invite-email" type="email" placeholder="{{.T "common.optional"}}" x-model="invite.email" data-autofocus>
          <span class="hint">{{if .Props.emailInvites}}{{.T "org.people.invite_email_hint_email"}}{{else}}{{.T "org.people.invite_email_hint"}}{{end}}</span>
        </div>
        <div class="field">
          <label for="invite-role">{{.T "common.role"}}</label>
          <select id="invite-role" x-model="invite.role">
            <option value="member">{{.T "roles.member"}}</option>
            {{if .IsOwner}}<option value="admin">{{.T "roles.admin"}}</option>{{end}}
          </select>
        </div>
        <p class="form-error" x-show="errors.invite" x-text="errors.invite" role="alert"></p>
        <div class="row row-end">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
          {{- if .Props.emailInvites}}
          <button type="submit" class="btn" :disabled="pending">
            <span x-cloak x-show="invite.email">{{template "icon" "paper-plane"}} {{.T "org.people.send_by_email"}}</span>
            <span x-show="!invite.email">{{template "icon" "link"}} {{.T "org.people.generate"}}</span>
          </button>
          {{- else}}
          <button type="submit" class="btn" :disabled="pending">{{template "icon" "link"}} {{.T "org.people.generate"}}</button>
          {{- end}}
        </div>
      </div>

      <div class="stack" x-cloak x-show="lastLink" x-transition.opacity>
        <p class="muted small" x-cloak x-show="lastDelivery === 'email'" x-text="$t('org.people.sent_to', { email: lastEmail })"></p>
        <p class="muted small" x-cloak x-show="lastDelivery === 'terminal'">{{.T "org.people.terminal_note"}}</p>
        <div class="field">
          <label for="invite-link">{{.T "org.people.link_label"}}</label>
          <input id="invite-link" type="text" readonly :value="lastLink" x-ref="link" @focus="$event.target.select()">
          <span class="hint" x-show="lastDelivery === 'link'">{{.T "org.people.link_hint"}}</span>
          <span class="hint" x-cloak x-show="lastDelivery !== 'link'">{{.T "org.people.link_hint_email"}}</span>
        </div>
        <div class="row row-end">
          <button type="button" class="btn btn-secondary" @click="copyLink()">{{template "icon" "copy"}} {{.T "org.people.copy"}}</button>
          <button type="button" class="btn" @click="$store.modal.dismiss()">{{.T "org.people.done"}}</button>
        </div>
      </div>
    </form>
  </template>
</main>
{{end}}
