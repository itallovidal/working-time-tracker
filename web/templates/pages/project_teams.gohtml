{{define "content"}}
<main class="page" x-data="projectTeams">
  {{template "project_head" .}}

  <p class="muted" x-show="loading">{{.T "collab.loading"}}</p>
  <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load"></p>

  <div class="totals" x-cloak x-show="!loading && !errors.load">
    <div class="total">
      <div class="v" x-text="summary().people"></div>
      <div class="k" x-text="$t('collab.collaborators', { count: summary().people })"></div>
    </div>
    <div class="total">
      <div class="v" x-text="summary().noTeam"></div>
      <div class="k">{{.T "collab.no_team"}}</div>
    </div>
    <div class="total">
      <div class="v" x-text="summary().teams"></div>
      <div class="k" x-text="$t('collab.teams_count', { count: summary().teams })"></div>
    </div>
    {{if .CanManage}}
    {{/* O dinheiro do projeto, só para admins: o que ele ganha por hora hoje, com todo mundo
         trabalhando, e o que as horas já fechadas valem. A conta de cada um fica na dica. */}}
    <div class="total has-tip" x-data="tip" @keydown.escape="open = false" @click.outside="open = false" @resize.window="open = false">
      <div class="v" :class="summary().margin < 0 && 'text-danger'" x-text="WTT.fmt.money(summary().margin)"></div>
      <div class="k">
        {{.T "collab.margin_total"}}
        <button type="button" class="tip-btn" aria-label="{{.T "collab.margin_total_label"}}" aria-controls="tip-margin"
                :aria-expanded="open.toString()" @click="toggle()">{{template "icon" "circle-info"}}</button>
      </div>
      <p class="tip-pop" id="tip-margin" role="note" x-ref="pop" x-cloak x-show="open">
        {{.T "collab.margin_total_tip"}}
        <span x-show="billing.bill_rate_cents === null">{{.T "collab.margin_total_no_bill"}}</span>
      </p>
    </div>
    <div class="total has-tip" x-data="tip" @keydown.escape="open = false" @click.outside="open = false" @resize.window="open = false">
      <div class="v" x-text="WTT.fmt.money(recorded().cents)"></div>
      <div class="k">
        {{.T "collab.recorded"}}
        <button type="button" class="tip-btn" aria-label="{{.T "collab.recorded_label"}}" aria-controls="tip-recorded"
                :aria-expanded="open.toString()" @click="toggle()">{{template "icon" "circle-info"}}</button>
      </div>
      <p class="tip-pop" id="tip-recorded" role="note" x-ref="pop" x-cloak x-show="open">
        {{.T "collab.recorded_tip"}}
        <span x-show="recorded().seconds > 0" x-text="$t('collab.recorded_so_far', { hours: WTT.fmt.hours(recorded().seconds) })"></span>
      </p>
    </div>
    {{end}}
  </div>

  {{if .CanManage}}
  {{/* Só aparece para quem entrou num time antes de o valor por hora ser obrigatório. */}}
  <p class="alert alert-warn" x-cloak x-show="!loading && missing().length > 0">
    <strong x-text="$t('collab.missing_count', { count: missing().length })"></strong>
    {{.T "collab.missing_text"}}
    <span x-text="missing().map((c) => c.person.name).join(', ')"></span>.
    {{.T "collab.missing_blocked"}}
  </p>
  {{end}}

  <div class="stack" x-cloak x-show="!loading && !errors.load">
    {{/* As mesmas pessoas em duas visões: a lista de todas, que serve a um projeto pequeno, e os
         times, onde se acha alguém mais rápido num projeto grande. A escolha fica na URL. */}}
    <div class="toolbar">
      <div class="segmented" role="tablist" aria-label="{{.T "collab.view_label"}}"
           @keydown.arrow-right.prevent="focusView('teams')" @keydown.arrow-left.prevent="focusView('people')">
        <button type="button" role="tab" id="view-people-tab" aria-controls="view-people" x-ref="tabPeople"
                :aria-selected="(view === 'people').toString()" :tabindex="view === 'people' ? 0 : -1"
                @click="setView('people')">{{template "icon" "users"}} {{.T "collab.people_title"}}</button>
        <button type="button" role="tab" id="view-teams-tab" aria-controls="view-teams" x-ref="tabTeams"
                :aria-selected="(view === 'teams').toString()" :tabindex="view === 'teams' ? 0 : -1"
                @click="setView('teams')">{{template "icon" "people-group"}} {{.T "collab.teams_title"}}</button>
      </div>
      <div class="row filters">
        <input type="search" placeholder="{{.T "collab.search_placeholder"}}" aria-label="{{.T "collab.search_label"}}"
               x-model="search" x-show="view === 'people' && collaborators.length > 0">
        {{if .CanManage}}
        <button type="button" class="btn" x-show="view === 'people'" @click="openAdd()">{{template "icon" "user-plus"}} {{.T "collab.add_person"}}</button>
        <button type="button" class="btn" x-show="view === 'teams'" @click="openTeam()">{{template "icon" "plus"}} {{.T "collab.new_team"}}</button>
        {{end}}
      </div>
    </div>

    <section class="stack" id="view-people" role="tabpanel" aria-labelledby="view-people-tab" x-show="view === 'people'">
      <p class="muted">{{.T "collab.people_intro"}}</p>

      <div class="empty" x-show="collaborators.length === 0">
        {{template "icon" "users"}}
        <strong>{{.T "collab.none"}}</strong>
        {{if .CanManage}}
        <span>{{.T "collab.none_admin"}}</span>
        {{else}}
        <span>{{.T "collab.none_member"}}</span>
        {{end}}
      </div>
      <div class="empty" x-show="collaborators.length > 0 && rows().length === 0">
        <strong>{{.T "collab.no_match"}}</strong>
        <button type="button" class="btn btn-secondary btn-sm" @click="search = ''">{{.T "collab.clear_search"}}</button>
      </div>

      {{/* Cinco pessoas por página. A linha não tem campo nem ação direta: tudo de uma pessoa
           muda no modal do colaborador. */}}
      <div class="table-wrap" x-show="rows().length > 0">
        <table>
          <thead>
            <tr>
              <th>{{.T "collab.col_person"}}</th>
              <th>{{.T "collab.col_teams"}}</th>
              {{if .CanManage}}
              <th x-text="$t('collab.col_rate', { unit: WTT.fmt.moneyUnit() })"></th>
              <th>{{.T "collab.col_margin"}}</th>
              <th class="actions"><span class="sr-only">{{.T "common.actions"}}</span></th>
              {{end}}
            </tr>
          </thead>
          <tbody>
            <template x-for="c in peoplePage().rows" :key="c.person.id">
              {{/* Para o admin a linha inteira abre o colaborador; o lápis faz o mesmo pelo teclado. */}}
              <tr {{if .CanManage}}class="row-link" @click="if (!$event.target.closest('button')) openPerson(c)"{{end}}>
                <td>
                  <div>
                    <span x-text="c.person.name"></span>
                    <span class="badge" x-show="c.person.id === meId">{{.T "common.you"}}</span>
                  </div>
                  <div class="muted small" x-text="c.person.email"></div>
                </td>
                <td>
                  <div class="row row-tight">
                    <template x-for="t in c.teams" :key="t.id">
                      <span class="badge" x-text="t.name"></span>
                    </template>
                    <span class="muted" x-show="c.teams.length === 0">{{.T "collab.no_team"}}</span>
                  </div>
                </td>
                {{if .CanManage}}
                <td class="num">
                  <span class="badge badge-accent" x-show="c.person.is_owner" title="{{.T "collab.owner_rate_hint"}}">{{.T "collab.owner_badge"}}</span>
                  <span x-show="!c.person.is_owner && c.pay_rate_cents !== null" x-text="WTT.fmt.money(c.pay_rate_cents)"></span>
                  <span class="badge badge-warn" x-show="!c.person.is_owner && c.pay_rate_cents === null">{{.T "collab.no_rate_badge"}}</span>
                </td>
                <td class="num">
                  <span :class="margin(c) < 0 && 'text-danger'" x-text="WTT.fmt.money(margin(c))"></span>
                </td>
                <td class="actions">
                  <button type="button" class="btn btn-ghost btn-sm btn-icon" title="{{.T "collab.edit_person"}}"
                          :aria-label="$t('collab.edit_person_label', { name: c.person.name })" @click="openPerson(c)">{{template "icon" "pen"}}</button>
                </td>
                {{end}}
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <nav class="pager" aria-label="{{.T "collab.pager"}}" x-show="rows().length > 0">
        <span class="muted small" x-text="peopleSummary()"></span>
        <div class="row row-tight" x-show="peoplePage().pages > 1">
          <button type="button" class="btn btn-secondary btn-sm" :disabled="peoplePage().page <= 1" @click="page = peoplePage().page - 1">{{template "icon" "chevron-left"}} {{.T "collab.prev"}}</button>
          <button type="button" class="btn btn-secondary btn-sm" :disabled="peoplePage().page >= peoplePage().pages" @click="page = peoplePage().page + 1">{{.T "collab.next"}} {{template "icon" "chevron-right"}}</button>
        </div>
      </nav>

      {{if .CanManage}}
      <p class="muted small" x-show="collaborators.length > 0">
        <span x-show="billing.bill_rate_cents !== null">{{.T "collab.bill_info_before"}} <strong class="num" x-text="WTT.fmt.money(billing.bill_rate_cents)"></strong> {{.T "collab.bill_info_after"}}</span>
        <span x-show="billing.bill_rate_cents === null">{{.T "collab.no_bill"}}</span>
        <a href="/projects/{{.Project.ID}}/management/settings">{{.T "collab.change_in_settings"}}</a>
      </p>
      {{end}}
    </section>

    <section class="stack" id="view-teams" role="tabpanel" aria-labelledby="view-teams-tab" x-show="view === 'teams'">
      <p class="muted">{{.T "collab.teams_intro"}}</p>

      <div class="empty" x-show="teams.length === 0">
        {{template "icon" "people-group"}}
        <strong>{{.T "collab.no_teams"}}</strong>
        {{if .CanManage}}
        <span>{{.T "collab.no_teams_admin"}}</span>
        {{else}}
        <span>{{.T "collab.no_teams_member"}}</span>
        {{end}}
      </div>

      <div class="grid-2" x-show="teams.length > 0">
        <template x-for="team in teams" :key="team.id">
          {{/* O cartão só mostra o time, cinco integrantes por vez. O lápis edita o time, e clicar
               numa pessoa abre o colaborador. */}}
          <section class="card">
            <div class="card-head">
              <h3 x-text="team.name"></h3>
              {{if .CanManage}}
              <button type="button" class="btn btn-ghost btn-sm btn-icon" title="{{.T "collab.edit_team"}}"
                      :aria-label="$t('collab.edit_team_label', { name: team.name })" @click="openEdit(team)">{{template "icon" "pen"}}</button>
              {{end}}
            </div>

            <p class="muted small" x-show="membersOf(team).length === 0">{{.T "collab.no_members"}}</p>
            <ul class="list" x-show="membersOf(team).length > 0">
              <template x-for="m in teamPage(team).rows" :key="m.person.id">
                <li>
                  {{if .CanManage}}
                  <button type="button" class="list-btn" title="{{.T "collab.edit_person"}}" @click="openPerson(m)">
                    <span class="avatar" aria-hidden="true" x-text="WTT.fmt.initials(m.person.name)"></span>
                    <span class="grow">
                      <span x-text="m.person.name"></span>
                      <span class="muted small" x-text="m.person.email"></span>
                    </span>
                    {{template "icon" "chevron-right"}}
                  </button>
                  {{else}}
                  <span class="avatar" aria-hidden="true" x-text="WTT.fmt.initials(m.person.name)"></span>
                  <div class="grow">
                    <div x-text="m.person.name"></div>
                    <div class="muted small" x-text="m.person.email"></div>
                  </div>
                  {{end}}
                </li>
              </template>
            </ul>
            <nav class="pager" :aria-label="$t('collab.team_pager', { name: team.name })" x-show="teamPage(team).pages > 1">
              <span class="muted small" x-text="$t('collab.team_range', { from: teamPage(team).from, to: teamPage(team).to, total: teamPage(team).total })"></span>
              <div class="row row-tight">
                <button type="button" class="btn btn-ghost btn-sm btn-icon" title="{{.T "collab.members_prev"}}"
                        :aria-label="$t('collab.members_prev_label', { name: team.name })"
                        :disabled="teamPage(team).page <= 1" @click="teamPages[team.id] = teamPage(team).page - 1">{{template "icon" "chevron-left"}}</button>
                <button type="button" class="btn btn-ghost btn-sm btn-icon" title="{{.T "collab.members_next"}}"
                        :aria-label="$t('collab.members_next_label', { name: team.name })"
                        :disabled="teamPage(team).page >= teamPage(team).pages" @click="teamPages[team.id] = teamPage(team).page + 1">{{template "icon" "chevron-right"}}</button>
              </div>
            </nav>
          </section>
        </template>
      </div>
    </section>
  </div>

  {{if .CanManage}}
  {{/* Os quatro formulários aparecem no modal do layout base e continuam no escopo de projectTeams. */}}
  <template x-teleport="#modal-root">
    <form class="stack" x-show="$store.modal.name === 'collab-add'" @submit.prevent="addPerson()">
      <div class="field">
        <label for="collab-search">{{.T "collab.person"}}</label>
        <input id="collab-search" type="search" placeholder="{{.T "collab.search_placeholder"}}" autocomplete="off"
               x-model="add.search" @input="pruneAdd()" data-autofocus>
      </div>
      <ul class="list picker" role="radiogroup" aria-label="{{.T "collab.picker_label"}}" x-show="addCandidates().length > 0">
        <template x-for="p in addCandidates()" :key="p.id">
          <li>
            <label class="pick">
              <input type="radio" name="collab-person" :value="p.id" x-model="add.person_id">
              <span class="avatar" aria-hidden="true" x-text="WTT.fmt.initials(p.name)"></span>
              <span class="grow">
                <span x-text="p.name"></span>
                <span class="muted small" x-text="p.email"></span>
              </span>
            </label>
          </li>
        </template>
      </ul>
      <p class="muted small" x-show="addCandidates().length === 0 && add.search.trim()">{{.T "collab.none_outside_search"}}</p>
      <p class="muted small" x-show="addCandidates().length === 0 && !add.search.trim()">
        {{.T "collab.all_in"}}
        <a href="/orgs/{{.OrgID}}/people">{{.T "collab.invite_link"}}</a>
      </p>
      <p class="muted small" x-show="addIsOwner()">{{.T "collab.owner_rate_hint"}}</p>
      <div class="field" x-show="!addIsOwner()">
        <label for="collab-rate" x-text="$t('collab.col_rate', { unit: WTT.fmt.moneyUnit() })"></label>
        <input id="collab-rate" type="text" inputmode="decimal" class="num" placeholder="{{.T "project_settings.rate_placeholder"}}" :required="!addIsOwner()" x-model="add.rate">
        <span class="hint">{{.T "collab.rate_hint"}}</span>
      </div>
      <div class="field">
        <label for="collab-team">{{.T "collab.team"}}</label>
        <select id="collab-team" x-model="add.team_id">
          <option value="">{{.T "collab.no_team_yet"}}</option>
          <template x-for="t in teams" :key="t.id">
            <option :value="t.id" x-text="t.name"></option>
          </template>
        </select>
        <span class="hint">{{.T "collab.team_hint"}}</span>
      </div>
      <p class="form-error" x-show="errors.add" x-text="errors.add" role="alert"></p>
      <div class="row row-end">
        <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
        <button type="submit" class="btn" :disabled="pending || !add.person_id">{{template "icon" "user-plus"}} {{.T "collab.add_submit"}}</button>
      </div>
    </form>
  </template>

  <template x-teleport="#modal-root">
    <form class="stack" x-show="$store.modal.name === 'team-new'" @submit.prevent="createTeam()">
      <div class="field">
        <label for="team-name">{{.T "collab.team_name"}}</label>
        <input id="team-name" type="text" placeholder="{{.T "collab.team_name_placeholder"}}" x-model="newTeam" data-autofocus>
      </div>
      <p class="form-error" x-show="errors.create" x-text="errors.create" role="alert"></p>
      <div class="row row-end">
        <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
        <button type="submit" class="btn" :disabled="pending">{{.T "collab.create_team"}}</button>
      </div>
    </form>
  </template>

  {{/* Editar time: nada vai para o servidor antes de Salvar, então Cancelar desfaz tudo. */}}
  <template x-teleport="#modal-root">
    <form class="stack" x-show="$store.modal.name === 'team-edit'" @submit.prevent="saveTeam()">
      <div class="field">
        <label for="team-edit-name">{{.T "collab.team_name"}}</label>
        <input id="team-edit-name" type="text" x-model="edit.name" data-autofocus>
      </div>
      <div class="field">
        <label for="team-edit-search">{{.T "collab.members_label"}} <span class="muted" x-text="'(' + edit.member_ids.length + ')'"></span></label>
        {{/* Enter na busca não salva: quem digita ali ainda está escolhendo as pessoas. */}}
        <input id="team-edit-search" type="search" placeholder="{{.T "collab.search_placeholder"}}" autocomplete="off"
               x-model="edit.search" @keydown.enter.prevent>
      </div>
      <ul class="list picker" role="group" aria-label="{{.T "collab.members_aria"}}" x-ref="editList" x-show="editCandidates().length > 0">
        <template x-for="p in editCandidates()" :key="p.id">
          <li>
            <label class="pick">
              <input type="checkbox" :value="p.id" x-model="edit.member_ids">
              <span class="avatar" aria-hidden="true" x-text="WTT.fmt.initials(p.name)"></span>
              <span class="grow">
                <span x-text="p.name"></span>
                <span class="muted small" x-text="p.email"></span>
              </span>
            </label>
          </li>
        </template>
      </ul>
      <p class="muted small" x-show="edit.people.length > 0 && editCandidates().length === 0">{{.T "collab.no_match_project"}}</p>
      <p class="muted small" x-show="edit.people.length === 0">{{.T "collab.none"}}</p>
      <p class="muted small">{{.T "collab.edit_hint"}}</p>
      <p class="form-error" x-show="errors.team" x-text="errors.team" role="alert"></p>
      <div class="confirm" x-cloak x-show="confirming === 'team-' + edit.id">
        <span>{{.T "collab.delete_team_confirm"}}</span>
        <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="removeTeam()">{{.T "common.delete"}}</button>
        <button type="button" class="btn btn-ghost btn-sm" @click="confirming = null">{{.T "common.cancel"}}</button>
      </div>
      <div class="toolbar" x-show="confirming !== 'team-' + edit.id">
        <button type="button" class="btn btn-danger-ghost" @click="confirming = 'team-' + edit.id">{{template "icon" "trash"}} {{.T "collab.delete_team"}}</button>
        <div class="row">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
          <button type="submit" class="btn" :disabled="pending">{{.T "common.save"}}</button>
        </div>
      </div>
    </form>
  </template>

  {{/* O colaborador: o valor por hora, os times e a saída do projeto num lugar só. Como no
       Editar time, nada vai para o servidor antes de Salvar. */}}
  <template x-teleport="#modal-root">
    <form class="stack" x-show="$store.modal.name === 'collab-edit'" @submit.prevent="savePerson()">
      <div class="row">
        <span class="avatar" aria-hidden="true" x-text="WTT.fmt.initials(person.name)"></span>
        <div class="grow">
          <div><strong x-text="person.name"></strong></div>
          <div class="muted small" x-text="person.email"></div>
        </div>
      </div>
      <p class="muted small" x-show="person.is_owner">{{.T "collab.owner_rate_hint"}}</p>
      <div class="field" x-show="!person.is_owner">
        <label for="collab-edit-rate" x-text="$t('collab.col_rate', { unit: WTT.fmt.moneyUnit() })"></label>
        <input id="collab-edit-rate" type="text" inputmode="decimal" class="num" placeholder="{{.T "project_settings.rate_placeholder"}}" :required="!person.is_owner" x-model="person.rate" data-autofocus>
        <span class="hint">
          {{.T "collab.person_rate_hint"}}
          <span x-show="personMargin() !== null">{{.T "collab.margin_before"}} <strong class="num" :class="personMargin() < 0 && 'text-danger'" x-text="WTT.fmt.money(personMargin())"></strong> {{.T "collab.margin_after"}}</span>
        </span>
      </div>
      <div class="field" role="group" aria-labelledby="collab-edit-teams-label">
        <span class="field-label" id="collab-edit-teams-label">{{.T "collab.teams_title"}} <span class="muted" x-text="'(' + person.team_ids.length + ')'"></span></span>
        <ul class="list picker" x-show="teams.length > 0">
          <template x-for="t in teams" :key="t.id">
            <li>
              <label class="pick">
                <input type="checkbox" :value="t.id" x-model="person.team_ids">
                <span class="grow" x-text="t.name"></span>
              </label>
            </li>
          </template>
        </ul>
        <span class="hint" x-show="teams.length > 0">{{.T "collab.team_tasks_hint"}}</span>
        <span class="hint" x-show="teams.length === 0">{{.T "collab.no_teams_yet"}}</span>
      </div>
      <p class="form-error" x-show="errors.person" x-text="errors.person" role="alert"></p>
      <div class="confirm" x-cloak x-show="confirming === 'person-' + person.id">
        <span>{{.T "collab.remove_confirm"}}</span>
        <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="removePerson()">{{.T "collab.leave"}}</button>
        <button type="button" class="btn btn-ghost btn-sm" @click="confirming = null">{{.T "common.cancel"}}</button>
      </div>
      <div class="toolbar" x-show="confirming !== 'person-' + person.id">
        <button type="button" class="btn btn-danger-ghost" @click="confirming = 'person-' + person.id">{{template "icon" "user-minus"}} {{.T "collab.leave_project"}}</button>
        <div class="row">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
          <button type="submit" class="btn" :disabled="pending">{{.T "common.save"}}</button>
        </div>
      </div>
    </form>
  </template>
  {{end}}
</main>
{{end}}
