{{define "content"}}
{{/* O perfil é para ler: quem eu sou, o que fiz e quando sou pago (o mesmo conteúdo que um admin vê ao abrir um
     colaborador). O nome, o email e a senha se alteram pelo Editar perfil, num modal. */}}
<main class="page" x-data="profileSettings">
  {{template "person_profile" .}}

  {{/* Conectar ao Claude: o claude.ai (e com ele o Claude Desktop e o celular) e o Claude Code entram no servidor MCP
       (/mcp) e agem como a pessoa. Com o OAuth ligado, o caminho principal é colar o endereço no Claude e autorizar; a
       lista "Apps conectados" mostra o que está ligado. O token pessoal continua para o Claude Code: ele aparece uma vez
       só, no modal, junto com o comando pronto, e a lista mostra só o começo dele. */}}
  <section class="card stack" aria-labelledby="claude-title">
    <div class="card-head">
      <h2 id="claude-title">{{template "icon" "robot"}} {{.T "profile.claude.title"}}</h2>
    </div>
    <p class="muted">{{.T "profile.claude.intro"}}</p>

    {{- if .Props.oauth}}
    <div class="stack" x-data="claudeConnections">
      <h3 id="claude-app-title">{{.T "profile.claude.app_title"}}</h3>
      <p class="muted">{{.T "profile.claude.app_steps"}}</p>
      <div class="field">
        <label for="claude-mcp-url">{{.T "profile.claude.app_url"}}</label>
        <div class="row">
          <input id="claude-mcp-url" class="flex-1" type="text" readonly :value="WTT.boot.mcpURL" @focus="$event.target.select()">
          <button type="button" class="btn btn-secondary" @click="copy(WTT.boot.mcpURL)">{{template "icon" "copy"}} {{.T "profile.claude.copy_url"}}</button>
        </div>
      </div>
      <div class="field">
        <label for="claude-code-oauth">{{.T "profile.claude.app_code_command"}}</label>
        <input id="claude-code-oauth" type="text" readonly :value="command()" @focus="$event.target.select()">
        <span class="hint">{{.T "profile.claude.app_code"}}</span>
      </div>

      <h3 id="claude-connections-title">{{.T "profile.claude.connections_title"}}</h3>
      <p class="muted" x-show="loading && connections.length === 0">{{.T "profile.claude.connections_loading"}}</p>
      <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load" role="alert"></p>
      <p class="form-error" x-cloak x-show="errors.disconnect" x-text="errors.disconnect" role="alert"></p>
      <div class="empty" x-cloak x-show="!loading && !errors.load && connections.length === 0">
        {{template "icon" "plug"}}
        <strong>{{.T "profile.claude.connections_empty"}}</strong>
        <span>{{.T "profile.claude.connections_empty_text"}}</span>
      </div>
      <div class="table-wrap" x-cloak x-show="connections.length > 0">
        <table aria-labelledby="claude-connections-title">
          <thead>
            <tr>
              <th>{{.T "profile.claude.col_app"}}</th><th>{{.T "profile.claude.col_connected"}}</th>
              <th>{{.T "profile.claude.col_last_used"}}</th><th>{{.T "profile.claude.col_drops"}}</th>
              <th class="actions"><span class="sr-only">{{.T "common.actions"}}</span></th>
            </tr>
          </thead>
          <tbody>
            <template x-for="conn in connections" :key="conn.id">
              <tr>
                <td><strong x-text="conn.name"></strong></td>
                <td class="nowrap" x-text="WTT.fmt.date(conn.created_at)"></td>
                <td class="nowrap" x-text="conn.last_used_at ? WTT.fmt.date(conn.last_used_at) : $t('profile.claude.never_used')"></td>
                <td class="nowrap" x-text="WTT.fmt.date(conn.expires_at)"></td>
                <td class="actions">
                  <button type="button" class="btn btn-danger-ghost btn-sm" x-show="confirming !== conn.id" @click="confirming = conn.id">{{template "icon" "plug-circle-xmark"}} {{.T "profile.claude.disconnect"}}</button>
                  <span class="confirm" x-cloak x-show="confirming === conn.id">
                    <span>{{.T "profile.claude.disconnect_question"}}</span>
                    <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="disconnect(conn)">{{.T "profile.claude.disconnect"}}</button>
                    <button type="button" class="btn btn-ghost btn-sm" @click="confirming = null">{{.T "common.cancel"}}</button>
                  </span>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
      <p class="muted small">{{.T "profile.claude.connections_note"}}</p>
    </div>
    {{- end}}

    <div class="stack" x-data="claudeTokens">
    <div class="card-head">
      <h3 id="claude-tokens-title">{{.T "profile.claude.tokens_title"}}</h3>
      <button type="button" class="btn btn-secondary btn-sm" @click="openNew()">{{template "icon" "plus"}} {{.T "profile.claude.new"}}</button>
    </div>
    <p class="muted">{{.T "profile.claude.tokens_intro"}}</p>

    <p class="muted" x-show="loading && tokens.length === 0">{{.T "profile.claude.loading"}}</p>
    <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load" role="alert"></p>
    <p class="form-error" x-cloak x-show="errors.revoke" x-text="errors.revoke" role="alert"></p>

    <div class="empty" x-cloak x-show="!loading && !errors.load && tokens.length === 0">
      {{template "icon" "key"}}
      <strong>{{.T "profile.claude.empty"}}</strong>
      <span>{{.T "profile.claude.empty_text"}}</span>
    </div>

    <div class="table-wrap" x-cloak x-show="tokens.length > 0">
      <table>
        <thead>
          <tr>
            <th>{{.T "profile.claude.col_name"}}</th><th>{{.T "profile.claude.col_token"}}</th>
            <th>{{.T "profile.claude.col_last_used"}}</th><th>{{.T "profile.claude.col_expires"}}</th>
            <th class="actions"><span class="sr-only">{{.T "common.actions"}}</span></th>
          </tr>
        </thead>
        <tbody>
          <template x-for="tok in tokens" :key="tok.id">
            <tr>
              <td><strong x-text="tok.name"></strong></td>
              <td><code x-text="tok.prefix + '…'"></code></td>
              <td class="nowrap" x-text="tok.last_used_at ? WTT.fmt.date(tok.last_used_at) : $t('profile.claude.never_used')"></td>
              <td class="nowrap">
                <span x-show="!expired(tok)" x-text="WTT.fmt.date(tok.expires_at)"></span>
                <span class="badge" x-cloak x-show="expired(tok)">{{.T "profile.claude.expired"}}</span>
              </td>
              <td class="actions">
                <button type="button" class="btn btn-danger-ghost btn-sm" x-show="confirming !== tok.id" @click="confirming = tok.id">{{template "icon" "ban"}} {{.T "profile.claude.revoke"}}</button>
                <span class="confirm" x-cloak x-show="confirming === tok.id">
                  <span>{{.T "profile.claude.revoke_question"}}</span>
                  <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="revoke(tok)">{{.T "profile.claude.revoke"}}</button>
                  <button type="button" class="btn btn-ghost btn-sm" @click="confirming = null">{{.T "common.cancel"}}</button>
                </span>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
    <p class="muted small">{{.T "profile.claude.password_note"}}</p>

    <template x-teleport="#modal-root">
      <form class="stack" novalidate x-show="$store.modal.name === 'claude-token'" @submit.prevent="create()">
        <div class="stack" x-show="!created">
          <div class="field">
            <label for="claude-token-name">{{.T "profile.claude.name"}}</label>
            <input id="claude-token-name" type="text" maxlength="{{limit "name"}}" data-field="name" x-model="draft.name" @input="clearField('name')" :aria-invalid="fieldErrors.name ? 'true' : 'false'" data-autofocus>
            <span class="hint">{{.T "profile.claude.name_hint"}}</span>
            {{template "field_error" "name"}}
          </div>
          <div class="field">
            <label for="claude-token-days">{{.T "profile.claude.days"}}</label>
            <select id="claude-token-days" data-field="days" x-model.number="draft.days" @change="clearField('days')">
              <option value="30">{{.T "profile.claude.days_30"}}</option>
              <option value="90">{{.T "profile.claude.days_90"}}</option>
              <option value="365">{{.T "profile.claude.days_365"}}</option>
            </select>
            {{template "field_error" "days"}}
          </div>
          <p class="form-error" x-show="errors.create" x-text="errors.create" role="alert"></p>
          <div class="row row-end">
            <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
            <button type="submit" class="btn" :disabled="pending">{{template "icon" "key"}} {{.T "profile.claude.submit"}}</button>
          </div>
        </div>

        <div class="stack" x-cloak x-show="created" x-transition.opacity>
          <div class="alert" role="status"><p>{{.T "profile.claude.copy_now"}}</p></div>
          <div class="field">
            <label for="claude-token-command">{{.T "profile.claude.command"}}</label>
            <textarea id="claude-token-command" rows="4" readonly :value="command()" x-ref="command" @focus="$event.target.select()"></textarea>
            <span class="hint">{{.T "profile.claude.command_hint"}}</span>
          </div>
          <div class="field">
            <label for="claude-token-value">{{.T "profile.claude.token"}}</label>
            <input id="claude-token-value" type="text" readonly :value="created ? created.token : ''" @focus="$event.target.select()">
            <span class="hint">{{.T "profile.claude.token_hint"}}</span>
          </div>
          <div class="row row-end">
            <button type="button" class="btn btn-secondary" @click="copy(command())">{{template "icon" "copy"}} {{.T "profile.claude.copy_command"}}</button>
            <button type="button" class="btn btn-secondary" @click="copy(created.token)">{{template "icon" "copy"}} {{.T "profile.claude.copy_token"}}</button>
            <button type="button" class="btn" @click="$store.modal.dismiss()">{{.T "profile.claude.done"}}</button>
          </div>
        </div>
      </form>
    </template>
    </div>
  </section>

  <template x-teleport="#modal-root">
    <div class="stack" x-show="$store.modal.name === 'profile-edit'">
      {{- if .Me.HasPassword}}
      <div class="segmented segmented-tabs" role="tablist" aria-label="{{.T "profile.tabs_label"}}"
           @keydown.arrow-right.prevent="focusTab('password')" @keydown.arrow-left.prevent="focusTab('personal')">
        <button type="button" role="tab" id="profile-tab-personal" aria-controls="profile-panel-personal" x-ref="tab-personal"
                :aria-selected="(tab === 'personal').toString()" :tabindex="tab === 'personal' ? 0 : -1"
                @click="tab = 'personal'">{{template "icon" "user"}} {{.T "profile.personal.title"}}</button>
        <button type="button" role="tab" id="profile-tab-password" aria-controls="profile-panel-password" x-ref="tab-password"
                :aria-selected="(tab === 'password').toString()" :tabindex="tab === 'password' ? 0 : -1"
                @click="tab = 'password'">{{template "icon" "key"}} {{.T "profile.password.title"}}</button>
      </div>
      {{- end}}

      <form class="stack" id="profile-panel-personal" {{if .Me.HasPassword}}role="tabpanel" aria-labelledby="profile-tab-personal"{{end}}
            novalidate x-show="tab === 'personal'" @submit.prevent="saveProfile()">
        <div class="field">
          <label for="me-name">{{.T "profile.personal.name"}}</label>
          <input id="me-name" type="text" autocomplete="name" maxlength="{{limit "name"}}" data-field="name" x-model="profile.name" @input="clearField('name')" :aria-invalid="fieldErrors.name ? 'true' : 'false'" data-autofocus>
          {{template "field_error" "name"}}
        </div>
        <div class="field">
          <label for="me-email">{{.T "common.email"}}</label>
          <input id="me-email" type="email" autocomplete="email" maxlength="{{limit "email"}}" data-field="email" x-model="profile.email" @input="clearField('email')" :aria-invalid="fieldErrors.email ? 'true' : 'false'">
          <span class="hint">{{.T "profile.personal.email_hint"}}</span>
          {{template "field_error" "email"}}
        </div>
        {{- if not .Me.HasPassword}}
        {{/* Quem entra só pelo Clerk não tem senha do sistema: não há o que trocar. */}}
        <p class="muted small">{{.T "profile.password.managed"}}</p>
        {{- end}}
        <p class="form-error" x-show="errors.profile" x-text="errors.profile" role="alert"></p>
        <div class="row row-end">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
          <button type="submit" class="btn" :disabled="pending">{{.T "profile.personal.submit"}}</button>
        </div>
      </form>

      {{- if .Me.HasPassword}}
      <form class="stack" id="profile-panel-password" role="tabpanel" aria-labelledby="profile-tab-password"
            novalidate x-cloak x-show="tab === 'password'" @submit.prevent="changePassword()">
        <div class="field">
          <label for="pw-current">{{.T "profile.password.current"}}</label>
          <input id="pw-current" type="password" autocomplete="current-password" data-field="current_password" x-model="password.current" @input="clearField('current_password')" :aria-invalid="fieldErrors.current_password ? 'true' : 'false'">
          {{template "field_error" "current_password"}}
        </div>
        <div class="field">
          <label for="pw-new">{{.T "profile.password.next"}}</label>
          <input id="pw-new" type="password" autocomplete="new-password" data-field="new_password" x-model="password.next" @input="clearField('new_password')" :aria-invalid="fieldErrors.new_password ? 'true' : 'false'">
          <span class="hint">{{.T "profile.password.next_hint"}}</span>
          {{template "field_error" "new_password"}}
        </div>
        <div class="field">
          <label for="pw-confirm">{{.T "auth.signup.confirm_password"}}</label>
          <input id="pw-confirm" type="password" autocomplete="new-password" data-field="confirm_password" x-model="password.confirm" @input="clearField('confirm_password')" :aria-invalid="fieldErrors.confirm_password ? 'true' : 'false'">
          {{template "field_error" "confirm_password"}}
        </div>
        <p class="form-error" x-show="errors.password" x-text="errors.password" role="alert"></p>
        <div class="row row-end">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
          <button type="submit" class="btn" :disabled="pending">{{.T "profile.password.submit"}}</button>
        </div>
      </form>
      {{- end}}
    </div>
  </template>
</main>
{{end}}
