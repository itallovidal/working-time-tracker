{{define "content"}}
{{/* O perfil é para ler: quem eu sou, o que fiz e quando sou pago (o mesmo conteúdo que um admin vê ao abrir um
     colaborador). O nome, o email e a senha se alteram pelo Editar perfil, num modal. */}}
<main class="page" x-data="profileSettings">
  {{template "person_profile" .}}

  {{/* Conector MCP: quem entra no servidor MCP (/mcp) e age como a pessoa. Embaixo do título, o que dá para pedir ao
       Claude. Em cima, tudo o que está conectado, numa lista só: os apps do OAuth (o claude.ai, que vale no Claude
       Desktop e no celular, e o Claude Code) e os tokens pessoais, cada um com o seu Desconectar ou Revogar. Embaixo, os
       dois jeitos de conectar, um de cada vez: o OAuth, que só existe com o OAuth ligado no servidor (o endereço do
       conector, que se cola no claude.ai, e um prompt para colar no Claude Code, que se configura sozinho), e o token
       pessoal, que aparece uma vez só, no modal, junto com o comando pronto (fica de fora de um prompt, para o token não
       ir parar numa conversa). O "?" explica a diferença entre os dois jeitos; sem o OAuth, não há o que comparar, e
       ele não aparece. */}}
  <section class="card stack" aria-labelledby="mcp-title" x-data="mcpConnector">
    <div class="stack stack-tight">
      <div class="row row-tight">
        <h2 id="mcp-title">{{template "icon" "plug"}} {{.T "profile.mcp.title"}}</h2>
        {{- if .Props.oauth}}
        <button type="button" class="btn btn-ghost btn-sm btn-icon" aria-label="{{.T "profile.mcp.help"}}" title="{{.T "profile.mcp.help"}}"
                @click="openHelp()">{{template "icon" "circle-question"}}</button>
        {{- end}}
      </div>
      <p class="muted">{{.T "profile.mcp.intro"}}</p>
      <ul class="icon-list">
        <li>{{template "icon" "clock"}} <span>{{.T "profile.mcp.intro_sessions"}}</span></li>
        <li>{{template "icon" "list-check"}} <span>{{.T "profile.mcp.intro_tasks"}}</span></li>
        <li>{{template "icon" "rotate"}} <span>{{.T "profile.mcp.intro_sync"}}</span></li>
      </ul>
    </div>

    <div class="stack">
      <h3 id="mcp-connected-title">{{.T "profile.mcp.connected_title"}}</h3>
      <p class="muted" x-show="loading && items().length === 0">{{.T "profile.mcp.loading"}}</p>
      <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load" role="alert"></p>
      <p class="form-error" x-cloak x-show="errors.remove" x-text="errors.remove" role="alert"></p>
      <div class="empty" x-cloak x-show="!loading && !errors.load && items().length === 0">
        {{template "icon" "plug"}}
        <strong>{{.T "profile.mcp.empty"}}</strong>
        <span>{{.T "profile.mcp.empty_text"}}</span>
      </div>
      <div class="table-wrap" x-cloak x-show="items().length > 0">
        <table aria-labelledby="mcp-connected-title">
          <thead>
            <tr>
              <th>{{.T "profile.mcp.col_name"}}</th><th>{{.T "profile.mcp.col_kind"}}</th>
              <th>{{.T "profile.mcp.col_connected"}}</th><th>{{.T "profile.mcp.col_last_used"}}</th>
              <th>{{.T "profile.mcp.col_expires"}}</th>
              <th class="actions"><span class="sr-only">{{.T "common.actions"}}</span></th>
            </tr>
          </thead>
          <tbody>
            <template x-for="item in items()" :key="item.key">
              <tr>
                <td class="nowrap">
                  <strong x-text="item.name"></strong>
                  <div class="muted small" x-show="item.prefix"><code x-text="item.prefix + '…'"></code></div>
                </td>
                <td><span class="badge" x-text="item.kind === 'oauth' ? $t('profile.mcp.kind_oauth') : $t('profile.mcp.kind_token')"></span></td>
                <td class="nowrap" x-text="WTT.fmt.date(item.created_at)"></td>
                <td class="nowrap" x-text="item.last_used_at ? WTT.fmt.date(item.last_used_at) : $t('profile.mcp.never_used')"></td>
                <td class="nowrap">
                  <span x-show="!expired(item)" x-text="WTT.fmt.date(item.expires_at)"></span>
                  <span class="badge" x-cloak x-show="expired(item)">{{.T "profile.mcp.expired"}}</span>
                </td>
                <td class="actions">
                  <button type="button" class="btn btn-danger-ghost btn-sm" x-show="confirming !== item.key && item.kind === 'oauth'" @click="confirming = item.key">{{template "icon" "plug-circle-xmark"}} {{.T "profile.mcp.disconnect"}}</button>
                  <button type="button" class="btn btn-danger-ghost btn-sm" x-show="confirming !== item.key && item.kind === 'token'" @click="confirming = item.key">{{template "icon" "ban"}} {{.T "profile.mcp.revoke"}}</button>
                  <span class="confirm" x-cloak x-show="confirming === item.key">
                    <span x-text="item.kind === 'oauth' ? $t('profile.mcp.disconnect_question') : $t('profile.mcp.revoke_question')"></span>
                    <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="remove(item)"
                            x-text="item.kind === 'oauth' ? $t('profile.mcp.disconnect') : $t('profile.mcp.revoke')"></button>
                    <button type="button" class="btn btn-ghost btn-sm" @click="confirming = null">{{.T "common.cancel"}}</button>
                  </span>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <hr class="divider">

    <div class="stack">
      <h3 id="mcp-connect-title">{{.T "profile.mcp.connect_title"}}</h3>
      {{- if .Props.oauth}}
      <div class="segmented self-start" role="tablist" aria-labelledby="mcp-connect-title"
           @keydown.arrow-right.prevent="focusMethod('token')" @keydown.arrow-left.prevent="focusMethod('oauth')">
        <button type="button" role="tab" id="mcp-tab-oauth" aria-controls="mcp-panel-oauth" x-ref="tab-oauth"
                :aria-selected="(method === 'oauth').toString()" :tabindex="method === 'oauth' ? 0 : -1"
                @click="method = 'oauth'">{{template "icon" "right-to-bracket"}} {{.T "profile.mcp.method_oauth"}}</button>
        <button type="button" role="tab" id="mcp-tab-token" aria-controls="mcp-panel-token" x-ref="tab-token"
                :aria-selected="(method === 'token').toString()" :tabindex="method === 'token' ? 0 : -1"
                @click="method = 'token'">{{template "icon" "key"}} {{.T "profile.mcp.method_token"}}</button>
      </div>

      <div class="stack" id="mcp-panel-oauth" role="tabpanel" aria-labelledby="mcp-tab-oauth" x-show="method === 'oauth'">
        <div class="field">
          <label for="mcp-url">{{.T "profile.mcp.app_url"}}</label>
          <div class="row">
            <input id="mcp-url" class="flex-1" type="text" readonly :value="WTT.boot.mcpURL" @focus="$event.target.select()">
            <button type="button" class="btn btn-secondary" aria-label="{{.T "profile.mcp.copy_url"}}" @click="copy(WTT.boot.mcpURL)">{{template "icon" "copy"}} {{.T "profile.mcp.copy"}}</button>
          </div>
          <span class="hint">{{.T "profile.mcp.app_hint"}}</span>
        </div>
        <div class="field">
          <label for="mcp-code-prompt">{{.T "profile.mcp.code_prompt"}}</label>
          <textarea id="mcp-code-prompt" class="textarea-fit" rows="2" readonly :value="oauthPrompt()" @focus="$event.target.select()"
                    x-effect="method === 'oauth' && $nextTick(() => fit($el))" @resize.window.debounce="fit($el)"></textarea>
        </div>
        <div class="row row-end">
          <button type="button" class="btn btn-secondary" @click="copy(oauthPrompt())">{{template "icon" "copy"}} {{.T "profile.mcp.copy_prompt"}}</button>
        </div>
      </div>
      {{- end}}

      <div class="row" id="mcp-panel-token" {{if .Props.oauth}}role="tabpanel" aria-labelledby="mcp-tab-token" x-cloak{{end}} x-show="method === 'token'">
        <p class="muted flex-1">{{.T "profile.mcp.token_text"}}</p>
        <button type="button" class="btn btn-secondary" @click="openNew()">{{template "icon" "plus"}} {{.T "profile.mcp.new"}}</button>
      </div>
    </div>

    {{- if .Props.oauth}}
    <template x-teleport="#modal-root">
      <div class="stack" x-show="$store.modal.name === 'mcp-help'">
        <div class="stack stack-tight">
          <h3>{{template "icon" "right-to-bracket"}} {{.T "profile.mcp.method_oauth"}}</h3>
          <p class="muted">{{.T "profile.mcp.help_oauth"}}</p>
        </div>
        <div class="stack stack-tight">
          <h3>{{template "icon" "key"}} {{.T "profile.mcp.method_token"}}</h3>
          <p class="muted">{{.T "profile.mcp.help_token"}}</p>
        </div>
        <p class="muted small">{{.T "profile.mcp.help_password"}}</p>
        <div class="row row-end">
          <button type="button" class="btn" @click="$store.modal.dismiss()">{{.T "profile.mcp.help_done"}}</button>
        </div>
      </div>
    </template>
    {{- end}}

    <template x-teleport="#modal-root">
      <form class="stack" novalidate x-show="$store.modal.name === 'mcp-token'" @submit.prevent="create()">
        <div class="stack" x-show="!created">
          <div class="field">
            <label for="mcp-token-name">{{.T "profile.mcp.name"}}</label>
            <input id="mcp-token-name" type="text" maxlength="{{limit "name"}}" data-field="name" x-model="draft.name" @input="clearField('name')" :aria-invalid="fieldErrors.name ? 'true' : 'false'" data-autofocus>
            <span class="hint">{{.T "profile.mcp.name_hint"}}</span>
            {{template "field_error" "name"}}
          </div>
          <div class="field">
            <label for="mcp-token-days">{{.T "profile.mcp.days"}}</label>
            <select id="mcp-token-days" data-field="days" x-model.number="draft.days" @change="clearField('days')">
              <option value="30">{{.T "profile.mcp.days_30"}}</option>
              <option value="90">{{.T "profile.mcp.days_90"}}</option>
              <option value="365">{{.T "profile.mcp.days_365"}}</option>
            </select>
            {{template "field_error" "days"}}
          </div>
          <p class="form-error" x-show="errors.create" x-text="errors.create" role="alert"></p>
          <div class="row row-end">
            <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
            <button type="submit" class="btn" :disabled="pending">{{template "icon" "key"}} {{.T "profile.mcp.submit"}}</button>
          </div>
        </div>

        <div class="stack" x-cloak x-show="created" x-transition.opacity>
          <div class="alert" role="status"><p>{{.T "profile.mcp.copy_now"}}</p></div>
          <div class="field">
            <label for="mcp-token-command">{{.T "profile.mcp.code_command"}}</label>
            <textarea id="mcp-token-command" rows="4" readonly :value="tokenCommand()" x-ref="command" @focus="$event.target.select()"></textarea>
            <span class="hint">{{.T "profile.mcp.command_hint"}}</span>
          </div>
          <div class="field">
            <label for="mcp-token-value">{{.T "profile.mcp.token"}}</label>
            <input id="mcp-token-value" type="text" readonly :value="created ? created.token : ''" @focus="$event.target.select()">
            <span class="hint">{{.T "profile.mcp.token_hint"}}</span>
          </div>
          <div class="row row-end">
            <button type="button" class="btn btn-secondary" @click="copy(tokenCommand())">{{template "icon" "copy"}} {{.T "profile.mcp.copy_command"}}</button>
            <button type="button" class="btn btn-secondary" @click="copy(created.token)">{{template "icon" "copy"}} {{.T "profile.mcp.copy_token"}}</button>
            <button type="button" class="btn" @click="$store.modal.dismiss()">{{.T "profile.mcp.done"}}</button>
          </div>
        </div>
      </form>
    </template>
  </section>

  {{/* Contas conectadas: o GitHub e o GitLab da pessoa. Com a conta ligada, a sincronização a põe como responsável
       nas issues das tarefas dela, e as tarefas que exigem a conta passam a poder ser dela. Conectar autoriza na
       plataforma só para ler quem a pessoa é (o token é descartado na volta). Só aparecem as plataformas com o app
       OAuth configurado no servidor; sem nenhuma, a seção some. */}}
  {{if .Props.accountPlatforms}}
  <section class="card stack" aria-labelledby="accounts-title" x-data="connectedAccounts">
    <div class="stack-tight">
      <h2 id="accounts-title">{{template "icon" "link"}} {{.T "profile.accounts.title"}}</h2>
      <p class="muted">{{.T "profile.accounts.intro"}}</p>
    </div>
    <p class="muted" x-show="loading">{{.T "profile.accounts.loading"}}</p>
    <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load" role="alert"></p>
    <p class="form-error" x-cloak x-show="errors.connect" x-text="errors.connect" role="alert"></p>
    <p class="form-error" x-cloak x-show="errors.change" x-text="errors.change" role="alert"></p>
    <ul class="account-list" x-cloak x-show="!loading && !errors.load">
      <template x-for="p in platforms" :key="p">
        <li class="account-row">
          <i class="account-brand" :class="icon(p)" aria-hidden="true"></i>
          <div class="account-who">
            <strong x-text="name(p)"></strong>
            <span class="muted small" x-show="linked(p)" x-text="who(p)"></span>
            <span class="muted small" x-show="linked(p) && origin(p)" x-text="origin(p)"></span>
            <span class="muted small" x-show="noAccount(p)" x-text="$t('profile.accounts.no_account_state', { platform: name(p) })"></span>
            <span class="muted small" x-show="!linked(p) && !noAccount(p)">{{.T "profile.accounts.not_connected"}}</span>
          </div>
          <div class="account-actions">
            <a class="btn btn-secondary btn-sm" x-show="!linked(p)" :href="connectURL(p)">{{template "icon" "plug"}} {{.T "profile.accounts.connect"}}</a>
            <button type="button" class="btn btn-ghost btn-sm" x-show="!linked(p) && !noAccount(p)" :disabled="pending"
                    @click="setNoAccount(p)">{{.T "profile.accounts.no_account"}}</button>
            <button type="button" class="btn btn-danger-ghost btn-sm" x-show="linked(p) && confirming !== p"
                    @click="confirming = p">{{template "icon" "plug-circle-xmark"}} {{.T "profile.accounts.disconnect"}}</button>
            <span class="confirm" x-cloak x-show="linked(p) && confirming === p">
              <span x-text="$t('profile.accounts.disconnect_question', { platform: name(p) })"></span>
              <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="disconnect(p)">{{.T "profile.accounts.disconnect"}}</button>
              <button type="button" class="btn btn-ghost btn-sm" @click="confirming = null">{{.T "common.cancel"}}</button>
            </span>
          </div>
        </li>
      </template>
    </ul>
  </section>
  {{end}}

  <template x-teleport="#modal-root">
    <div class="stack" x-show="$store.modal.name === 'profile-edit'">
      {{- if .Me.HasPassword}}
      <div class="segmented segmented-tabs" role="tablist" aria-label="{{.T "profile.tabs_label"}}"
           @keydown.arrow-right.prevent="focusTab('password')" @keydown.arrow-left.prevent="focusTab('personal')">
        <button type="button" role="tab" id="profile-tab-personal" aria-controls="profile-panel-personal" x-ref="tab-personal"
                :aria-selected="(tab === 'personal').toString()" :tabindex="tab === 'personal' ? 0 : -1"
                @click="tab = 'personal'">{{template "icon" "user"}} {{.T "profile.personal.title"}}</button>
        <button type="button" role="tab" id="profile-tab-password" aria-controls="profile-panel-password" x-ref="tab-password"
                :aria-selected="(tab === 'password').toString()" :tabindex="tab === 'password' ? 0 : -1"
                @click="tab = 'password'">{{template "icon" "key"}} {{.T "profile.password.title"}}</button>
      </div>
      {{- end}}

      <form class="stack" id="profile-panel-personal" {{if .Me.HasPassword}}role="tabpanel" aria-labelledby="profile-tab-personal"{{end}}
            novalidate x-show="tab === 'personal'" @submit.prevent="saveProfile()">
        <div class="field">
          <label for="me-name">{{.T "profile.personal.name"}}</label>
          <input id="me-name" type="text" autocomplete="name" maxlength="{{limit "name"}}" data-field="name" x-model="profile.name" @input="clearField('name')" :aria-invalid="fieldErrors.name ? 'true' : 'false'" data-autofocus>
          {{template "field_error" "name"}}
        </div>
        <div class="field">
          <label for="me-email">{{.T "common.email"}}</label>
          <input id="me-email" type="email" autocomplete="email" maxlength="{{limit "email"}}" data-field="email" x-model="profile.email" @input="clearField('email')" :aria-invalid="fieldErrors.email ? 'true' : 'false'">
          <span class="hint">{{.T "profile.personal.email_hint"}}</span>
          {{template "field_error" "email"}}
        </div>
        {{- if not .Me.HasPassword}}
        {{/* Quem entra só pelo Clerk não tem senha do sistema: não há o que trocar. */}}
        <p class="muted small">{{.T "profile.password.managed"}}</p>
        {{- end}}
        <p class="form-error" x-show="errors.profile" x-text="errors.profile" role="alert"></p>
        <div class="row row-end">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
          <button type="submit" class="btn" :disabled="pending">{{.T "profile.personal.submit"}}</button>
        </div>
      </form>

      {{- if .Me.HasPassword}}
      <form class="stack" id="profile-panel-password" role="tabpanel" aria-labelledby="profile-tab-password"
            novalidate x-cloak x-show="tab === 'password'" @submit.prevent="changePassword()">
        <div class="field">
          <label for="pw-current">{{.T "profile.password.current"}}</label>
          <input id="pw-current" type="password" autocomplete="current-password" data-field="current_password" x-model="password.current" @input="clearField('current_password')" :aria-invalid="fieldErrors.current_password ? 'true' : 'false'">
          {{template "field_error" "current_password"}}
        </div>
        <div class="field">
          <label for="pw-new">{{.T "profile.password.next"}}</label>
          <input id="pw-new" type="password" autocomplete="new-password" data-field="new_password" x-model="password.next" @input="clearField('new_password')" :aria-invalid="fieldErrors.new_password ? 'true' : 'false'">
          <span class="hint">{{.T "profile.password.next_hint"}}</span>
          {{template "field_error" "new_password"}}
        </div>
        <div class="field">
          <label for="pw-confirm">{{.T "auth.signup.confirm_password"}}</label>
          <input id="pw-confirm" type="password" autocomplete="new-password" data-field="confirm_password" x-model="password.confirm" @input="clearField('confirm_password')" :aria-invalid="fieldErrors.confirm_password ? 'true' : 'false'">
          {{template "field_error" "confirm_password"}}
        </div>
        <p class="form-error" x-show="errors.password" x-text="errors.password" role="alert"></p>
        <div class="row row-end">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
          <button type="submit" class="btn" :disabled="pending">{{.T "profile.password.submit"}}</button>
        </div>
      </form>
      {{- end}}
    </div>
  </template>
</main>
{{end}}
