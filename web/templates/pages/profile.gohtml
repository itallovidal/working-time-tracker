{{define "content"}}
<main class="page" x-data="profileSettings">
  <div class="page-head">
    <div>
      <div class="eyebrow">Sua conta</div>
      <h1>Seu perfil</h1>
    </div>
  </div>

  <div class="stack stack-narrow">
    <form class="card" @submit.prevent="saveProfile()">
      <div class="card-head"><h2>Dados pessoais</h2></div>
      <div class="field">
        <label for="me-name">Nome</label>
        <input id="me-name" type="text" autocomplete="name" required x-model="profile.name">
      </div>
      <div class="field">
        <label for="me-email">Email</label>
        <input id="me-email" type="email" autocomplete="email" required x-model="profile.email">
        <span class="hint">É o email que você usa para entrar.</span>
      </div>
      <p class="form-error" x-show="errors.profile" x-text="errors.profile" role="alert"></p>
      <div class="row row-end"><button type="submit" class="btn" :disabled="pending">Salvar perfil</button></div>
    </form>

    <section class="card">
      <div class="card-head"><h2>Meus valores</h2></div>
      <p class="muted small">Quanto você recebe por hora em cada projeto. Só você e os admins veem.</p>
      <p class="form-error" x-cloak x-show="errors.rates" x-text="errors.rates"></p>
      <p class="muted small" x-cloak x-show="ratesLoaded && rates.length === 0">Você ainda não tem valor definido em nenhum projeto.</p>
      <ul class="list" x-cloak x-show="rates.length > 0">
        <template x-for="r in rates" :key="r.project_id">
          <li>
            <a class="grow" :href="'/projects/' + r.project_id + '/time-tracking'" x-text="r.project.name"></a>
            <span class="num"><strong x-text="WTT.fmt.money(r.pay_rate_cents)"></strong> <span class="muted small">por hora</span></span>
          </li>
        </template>
      </ul>
    </section>

    <form class="card" @submit.prevent="changePassword()">
      <div class="card-head"><h2>Senha</h2></div>
      <div class="field">
        <label for="pw-current">Senha atual</label>
        <input id="pw-current" type="password" autocomplete="current-password" required x-model="password.current">
      </div>
      <div class="field">
        <label for="pw-new">Nova senha</label>
        <input id="pw-new" type="password" autocomplete="new-password" minlength="8" required x-model="password.next">
        <span class="hint">Pelo menos 8 caracteres. As suas outras sessões serão encerradas.</span>
      </div>
      <p class="form-error" x-show="errors.password" x-text="errors.password" role="alert"></p>
      <div class="row row-end"><button type="submit" class="btn" :disabled="pending">Trocar senha</button></div>
    </form>
  </div>
</main>
{{end}}
