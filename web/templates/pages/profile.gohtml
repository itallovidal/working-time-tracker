{{define "content"}}
{{/* O perfil é para ler: quem eu sou, o que fiz e quando sou pago (o mesmo conteúdo que um admin vê ao abrir um
     colaborador). O nome, o email e a senha se alteram pelo Editar perfil, num modal. */}}
<main class="page" x-data="profileSettings">
  {{template "person_profile" .}}

  <template x-teleport="#modal-root">
    <div class="stack" x-show="$store.modal.name === 'profile-edit'">
      {{- if .Me.HasPassword}}
      <div class="segmented segmented-tabs" role="tablist" aria-label="{{.T "profile.tabs_label"}}"
           @keydown.arrow-right.prevent="focusTab('password')" @keydown.arrow-left.prevent="focusTab('personal')">
        <button type="button" role="tab" id="profile-tab-personal" aria-controls="profile-panel-personal" x-ref="tab-personal"
                :aria-selected="(tab === 'personal').toString()" :tabindex="tab === 'personal' ? 0 : -1"
                @click="tab = 'personal'">{{template "icon" "user"}} {{.T "profile.personal.title"}}</button>
        <button type="button" role="tab" id="profile-tab-password" aria-controls="profile-panel-password" x-ref="tab-password"
                :aria-selected="(tab === 'password').toString()" :tabindex="tab === 'password' ? 0 : -1"
                @click="tab = 'password'">{{template "icon" "key"}} {{.T "profile.password.title"}}</button>
      </div>
      {{- end}}

      <form class="stack" id="profile-panel-personal" {{if .Me.HasPassword}}role="tabpanel" aria-labelledby="profile-tab-personal"{{end}}
            novalidate x-show="tab === 'personal'" @submit.prevent="saveProfile()">
        <div class="field">
          <label for="me-name">{{.T "profile.personal.name"}}</label>
          <input id="me-name" type="text" autocomplete="name" maxlength="{{limit "name"}}" data-field="name" x-model="profile.name" @input="clearField('name')" :aria-invalid="fieldErrors.name ? 'true' : 'false'" data-autofocus>
          {{template "field_error" "name"}}
        </div>
        <div class="field">
          <label for="me-email">{{.T "common.email"}}</label>
          <input id="me-email" type="email" autocomplete="email" maxlength="{{limit "email"}}" data-field="email" x-model="profile.email" @input="clearField('email')" :aria-invalid="fieldErrors.email ? 'true' : 'false'">
          <span class="hint">{{.T "profile.personal.email_hint"}}</span>
          {{template "field_error" "email"}}
        </div>
        {{- if not .Me.HasPassword}}
        {{/* Quem entra só pelo Clerk não tem senha do sistema: não há o que trocar. */}}
        <p class="muted small">{{.T "profile.password.managed"}}</p>
        {{- end}}
        <p class="form-error" x-show="errors.profile" x-text="errors.profile" role="alert"></p>
        <div class="row row-end">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
          <button type="submit" class="btn" :disabled="pending">{{.T "profile.personal.submit"}}</button>
        </div>
      </form>

      {{- if .Me.HasPassword}}
      <form class="stack" id="profile-panel-password" role="tabpanel" aria-labelledby="profile-tab-password"
            novalidate x-cloak x-show="tab === 'password'" @submit.prevent="changePassword()">
        <div class="field">
          <label for="pw-current">{{.T "profile.password.current"}}</label>
          <input id="pw-current" type="password" autocomplete="current-password" data-field="current_password" x-model="password.current" @input="clearField('current_password')" :aria-invalid="fieldErrors.current_password ? 'true' : 'false'">
          {{template "field_error" "current_password"}}
        </div>
        <div class="field">
          <label for="pw-new">{{.T "profile.password.next"}}</label>
          <input id="pw-new" type="password" autocomplete="new-password" data-field="new_password" x-model="password.next" @input="clearField('new_password')" :aria-invalid="fieldErrors.new_password ? 'true' : 'false'">
          <span class="hint">{{.T "profile.password.next_hint"}}</span>
          {{template "field_error" "new_password"}}
        </div>
        <div class="field">
          <label for="pw-confirm">{{.T "auth.signup.confirm_password"}}</label>
          <input id="pw-confirm" type="password" autocomplete="new-password" data-field="confirm_password" x-model="password.confirm" @input="clearField('confirm_password')" :aria-invalid="fieldErrors.confirm_password ? 'true' : 'false'">
          {{template "field_error" "confirm_password"}}
        </div>
        <p class="form-error" x-show="errors.password" x-text="errors.password" role="alert"></p>
        <div class="row row-end">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
          <button type="submit" class="btn" :disabled="pending">{{.T "profile.password.submit"}}</button>
        </div>
      </form>
      {{- end}}
    </div>
  </template>
</main>
{{end}}
