{{define "content"}}
<main class="page" x-data="profileSettings">
  <div class="page-head">
    <div>
      <div class="eyebrow">{{.T "profile.eyebrow"}}</div>
      <h1>{{.T "profile.title"}}</h1>
    </div>
  </div>

  <div class="stack stack-narrow">
    <form class="card" @submit.prevent="saveProfile()">
      <div class="card-head"><h2>{{.T "profile.personal.title"}}</h2></div>
      <div class="field">
        <label for="me-name">{{.T "profile.personal.name"}}</label>
        <input id="me-name" type="text" autocomplete="name" required x-model="profile.name">
      </div>
      <div class="field">
        <label for="me-email">{{.T "common.email"}}</label>
        <input id="me-email" type="email" autocomplete="email" required x-model="profile.email">
        <span class="hint">{{.T "profile.personal.email_hint"}}</span>
      </div>
      <p class="form-error" x-show="errors.profile" x-text="errors.profile" role="alert"></p>
      <div class="row row-end"><button type="submit" class="btn" :disabled="pending">{{.T "profile.personal.submit"}}</button></div>
    </form>

    <section class="card">
      <div class="card-head"><h2>{{.T "profile.rates.title"}}</h2></div>
      <p class="muted small">{{.T "profile.rates.intro"}}</p>
      <p class="form-error" x-cloak x-show="errors.rates" x-text="errors.rates"></p>
      <p class="muted small" x-cloak x-show="ratesLoaded && rates.length === 0">{{.T "profile.rates.empty"}}</p>
      <ul class="list" x-cloak x-show="rates.length > 0">
        <template x-for="r in rates" :key="r.project_id">
          <li>
            <a class="grow" :href="'/projects/' + r.project_id + '/time-tracking'" x-text="r.project.name"></a>
            <span class="num"><strong x-text="WTT.fmt.money(r.pay_rate_cents)"></strong> <span class="muted small">{{.T "common.per_hour"}}</span></span>
          </li>
        </template>
      </ul>
    </section>

    <form class="card" @submit.prevent="changePassword()">
      <div class="card-head"><h2>{{.T "profile.password.title"}}</h2></div>
      <div class="field">
        <label for="pw-current">{{.T "profile.password.current"}}</label>
        <input id="pw-current" type="password" autocomplete="current-password" required x-model="password.current">
      </div>
      <div class="field">
        <label for="pw-new">{{.T "profile.password.next"}}</label>
        <input id="pw-new" type="password" autocomplete="new-password" minlength="8" required x-model="password.next">
        <span class="hint">{{.T "profile.password.next_hint"}}</span>
      </div>
      <p class="form-error" x-show="errors.password" x-text="errors.password" role="alert"></p>
      <div class="row row-end"><button type="submit" class="btn" :disabled="pending">{{.T "profile.password.submit"}}</button></div>
    </form>
  </div>
</main>
{{end}}
