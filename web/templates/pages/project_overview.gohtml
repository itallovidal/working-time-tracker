{{define "content"}}
<main class="page" x-data="projectOverview">
  {{template "project_head" .}}

  {{/* A tela é uma fotografia: os números valem para a hora em "Atualizado às" e são
       relidos pelo botão ou quando alguém bate o ponto nesta aba. */}}
  <div class="toolbar">
    <p class="muted">{{.T "overview.intro"}}</p>
    <div class="row row-tight" x-cloak x-show="data">
      <span class="muted small" x-text="data ? $t('overview.updated', { time: WTT.fmt.time(data.generated_at) }) : ''"></span>
      <button type="button" class="btn btn-secondary btn-sm" :disabled="pending === 'load'" @click="load()">{{template "icon" "rotate"}} {{.T "overview.refresh"}}</button>
    </div>
  </div>

  <p class="muted" x-show="loading">{{.T "overview.loading"}}</p>
  <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load" role="alert"></p>

  {{/* Cada bloco é um template próprio, para ser filho direto da página e herdar o
       espaçamento dela. Nada é desenhado antes de a resposta chegar. */}}
  <template x-if="data && data.people.without_rate > 0">
    <p class="alert alert-warn">
      <strong x-text="$t('overview.without_rate_count', { count: data.people.without_rate })"></strong>
      <span x-text="$t('overview.without_rate_text', { count: data.people.without_rate })"></span>
      {{.T "overview.set_rate_before"}} <a href="/projects/{{.Project.ID}}/management/teams">{{.T "project.head.teams"}}</a>{{.T "overview.set_rate_after"}}
    </p>
  </template>

  <template x-if="data">
    <div class="grid-2 items-stretch">
      <section class="card">
        <div class="card-head"><h2>{{.T "overview.project_title"}}</h2></div>
        <div class="totals">
          <div class="total">
            <div class="v" x-text="data.people.total"></div>
            <div class="k">
              <span x-text="$t('overview.people', { count: data.people.total })"></span><span x-show="data.people.without_team > 0" x-text="$t('overview.without_team', { count: data.people.without_team })"></span>
            </div>
          </div>
          <div class="total">
            <div class="v" x-text="data.teams.total"></div>
            <div class="k" x-text="$t('overview.teams', { count: data.teams.total })"></div>
          </div>
        </div>
        <div class="totals">
          <div class="total">
            <div class="v" x-text="data.project.age.days"></div>
            <div class="k" x-text="$t('overview.days', { count: data.project.age.days })"></div>
          </div>
          <div class="total">
            <div class="v" x-text="data.project.age.weeks"></div>
            <div class="k" x-text="$t('overview.weeks', { count: data.project.age.weeks })"></div>
          </div>
          <div class="total">
            <div class="v" x-text="data.project.age.months"></div>
            <div class="k" x-text="$t('overview.months', { count: data.project.age.months })"></div>
          </div>
        </div>
        <dl class="facts">
          <div class="fact">
            <dt>{{.T "overview.start"}}</dt>
            <dd x-text="WTT.fmt.date(data.project.created_at)"></dd>
          </div>
          <div class="fact">
            <dt>{{.T "overview.first_session"}}</dt>
            <dd :class="data.time.first_session_at ? '' : 'muted'" x-text="data.time.first_session_at ? WTT.fmt.date(data.time.first_session_at) : $t('overview.nobody_clocked')"></dd>
          </div>
          <div class="fact">
            <dt>{{.T "overview.last_session"}}</dt>
            <dd :class="data.time.last_session_at ? '' : 'muted'" x-text="data.time.last_session_at ? WTT.fmt.date(data.time.last_session_at) : $t('overview.nobody_clocked')"></dd>
          </div>
        </dl>
        <p class="muted small">{{.T "overview.age_note"}}</p>
      </section>

      <section class="card">
        <div class="card-head"><h2>{{.T "overview.activity"}}</h2></div>
        <div class="totals">
          <div class="total">
            <div class="v" x-text="WTT.fmt.hours(data.time.last_7_days_seconds)"></div>
            <div class="k">{{.T "overview.last_7"}}</div>
          </div>
          <div class="total">
            <div class="v" x-text="WTT.fmt.hours(data.time.last_30_days_seconds)"></div>
            <div class="k">{{.T "overview.last_30"}}</div>
          </div>
          <div class="total">
            <div class="v" x-text="data.people.working_now"></div>
            <div class="k">{{.T "overview.working_now"}}</div>
          </div>
        </div>
        <dl class="facts">
          <div class="fact">
            <dt>{{.T "overview.in_progress"}}</dt>
            <dd :class="data.people.working_now > 0 ? '' : 'muted'" x-text="workingNames() || $t('overview.nobody_open')"></dd>
          </div>
          <div class="fact">
            <dt>{{.T "overview.session_count"}}</dt>
            <dd class="num" x-text="data.time.session_count"></dd>
          </div>
        </dl>
      </section>
    </div>
  </template>

  <template x-if="data">
    <div class="grid-2 items-stretch">
      <section class="card">
        <div class="card-head">
          <h2>{{.T "overview.integrations_title"}}</h2>
          <a class="btn btn-ghost btn-sm" href="/projects/{{.Project.ID}}/management/integrations">{{template "icon" "plug"}} {{.T "overview.open_tab"}}</a>
        </div>
        <div class="empty" x-show="data.integrations.total === 0">
          <strong>{{.T "overview.no_integrations"}}</strong>
          <span>{{.T "overview.no_integrations_text"}}</span>
        </div>
        <p class="muted small" x-show="data.integrations.total > 0" x-text="integrationsSummary()"></p>
        <ul class="list" x-show="data.integrations.total > 0">
          <template x-for="it in data.integrations.items" :key="it.id">
            <li>
              <div class="grow stack stack-tight">
                <strong x-text="it.display_name"></strong>
                <div class="row row-tight">
                  <span class="badge badge-accent" x-text="typeLabel(it.type)"></span>
                  <span class="badge" :class="it.enabled ? 'badge-ok' : ''" x-text="it.enabled ? $t('integrations.active') : $t('integrations.disabled')"></span>
                  <span class="badge badge-warn" x-show="!it.has_token">{{.T "overview.no_credential"}}</span>
                </div>
                <p class="muted small" x-cloak x-show="it.sync_issues">
                  <span x-text="$t('integrations.sync_state') + ': ' + $t('integrations.sync_on')"></span> ·
                  <span x-text="it.last_synced_at ? $t('integrations.last_sync') + ' ' + WTT.fmt.dateTime(it.last_synced_at) : $t('integrations.never_synced')"></span>
                  <span x-show="it.sync_unmatched > 0"> · <span x-text="$t('integrations.unmatched', { count: it.sync_unmatched })"></span></span>
                </p>
              </div>
            </li>
          </template>
        </ul>
      </section>

      <section class="card">
        <div class="card-head"><h2>{{.T "overview.tasks_title"}}</h2></div>
        <div class="totals">
          <div class="total">
            <div class="v" x-text="data.tasks.total"></div>
            <div class="k" x-text="$t('overview.tasks', { count: data.tasks.total })"></div>
          </div>
          <div class="total">
            <div class="v" :class="data.tasks.overdue > 0 && 'text-danger'" x-text="data.tasks.overdue"></div>
            <div class="k">
              <span x-text="$t('overview.overdue', { count: data.tasks.overdue })"></span><span x-show="data.tasks.overdue > 0"> · <a href="/projects/{{.Project.ID}}/tasks?due=overdue">{{.T "overview.see"}}</a></span>
            </div>
          </div>
        </div>
        <dl class="facts">
          <div class="fact">
            <dt>{{.T "org.projects.customer"}}</dt>
            <dd :class="data.project.customer ? '' : 'muted'" x-text="data.project.customer ? data.project.customer.name : $t('org.projects.internal')"></dd>
          </div>
          <div class="fact">
            <dt>{{.T "overview.bill_rate"}}</dt>
            <dd class="num" :class="data.project.bill_rate_cents === null && 'muted'" x-text="data.project.bill_rate_cents === null ? $t('overview.no_bill_rate') : WTT.fmt.money(data.project.bill_rate_cents)"></dd>
          </div>
        </dl>
        <p class="muted small">{{.T "overview.tasks_note"}}</p>
      </section>
    </div>
  </template>

  <template x-if="data">
    <section class="stack">
      <div class="stack stack-tight">
        <h2>{{.T "time.sessions"}}</h2>
        <p class="muted">{{.T "time.sessions_intro_admin"}} {{.T "time.totals_follow"}}</p>
      </div>
      <div class="row filters">
        <select x-model="filter.person" aria-label="{{.T "time.person_filter"}}">
          <option value="">{{.T "time.all_people"}}</option>
          <template x-for="p in people()" :key="p.id"><option :value="p.id" x-text="p.name"></option></template>
        </select>
        <input type="date" x-model="filter.date" aria-label="{{.T "time.date_filter"}}" title="{{.T "time.date_filter_title"}}">
        <select x-model="filter.task" aria-label="{{.T "time.task_filter"}}">
          <option value="">{{.T "time.all_tasks"}}</option>
          <template x-for="t in sessionTasks()" :key="t.id"><option :value="t.id" x-text="t.name"></option></template>
        </select>
        <button type="button" class="btn btn-ghost btn-sm" x-cloak x-show="hasFilters()" @click="clearFilters()">{{template "icon" "xmark"}} {{.T "common.clear_filters"}}</button>
      </div>

      {{/* Os totais ficam num cartão próprio, e a tabela, só com a lista das sessões. */}}
      <section class="card" x-cloak x-show="filtered().length > 0">
        <div class="card-head">
          <h3>{{.T "time.totals"}}</h3>
          <span class="muted small" x-text="hasFilters() ? $t('time.count_filtered', { count: filtered().length }) : $t('time.count', { count: filtered().length })"></span>
        </div>
        <div class="totals">
          <div class="total">
            <div class="v" x-text="WTT.fmt.hours(filteredTotal())"></div>
            <div class="k">{{.T "time.time_total"}}</div>
          </div>
          <div class="total">
            <div class="v" x-text="WTT.fmt.money(filteredAmount('pay'))"></div>
            <div class="k">{{.T "time.cost"}}</div>
          </div>
          <div class="total">
            <div class="v" x-text="WTT.fmt.money(filteredAmount('bill'))"></div>
            <div class="k">{{.T "time.revenue"}}</div>
          </div>
          <div class="total">
            <div class="v" :class="filteredMargin() < 0 && 'text-danger'" x-text="WTT.fmt.money(filteredMargin())"></div>
            <div class="k">{{.T "time.margin"}}<span x-show="filteredMarginShare() !== null" x-text="$t('overview.margin_share', { percent: filteredMarginShare() })"></span></div>
          </div>
        </div>
      </section>

      <div class="empty" x-cloak x-show="filtered().length === 0">
        <strong>{{.T "time.empty"}}</strong>
        <span x-text="hasFilters() ? $t('time.empty_filtered') : $t('time.empty_text')"></span>
      </div>
      <div class="table-wrap" x-show="filtered().length > 0">
        <table>
          <thead>
            <tr>
              <th>{{.T "time.col_person"}}</th><th>{{.T "time.col_tasks"}}</th><th>{{.T "time.col_start"}}</th><th>{{.T "time.col_end"}}</th><th class="actions">{{.T "time.col_duration"}}</th><th class="actions">{{.T "time.cost"}}</th><th class="actions">{{.T "time.revenue"}}</th><th class="actions"><span class="sr-only">{{.T "time.col_details"}}</span></th>
            </tr>
          </thead>
          <tbody>
            <template x-for="s in sessionRows()" :key="s.id">
              <tr>
                <td x-text="s.person ? s.person.name : ''"></td>
                <td>
                  <div class="task-chips">
                    <template x-for="t in firstTasks(s)" :key="t.id"><a :href="'/tasks/' + t.id" x-text="t.name"></a></template>
                    <span class="badge" x-show="moreTasks(s) > 0" x-text="'+' + moreTasks(s)"></span>
                    <span class="muted small" x-show="s.tasks.length === 0">{{.T "session.deleted_tasks"}}</span>
                  </div>
                </td>
                <td class="num" x-text="WTT.fmt.dateTime(s.start_at)"></td>
                <td class="num">
                  <span x-show="s.end_at" x-text="WTT.fmt.dateTime(s.end_at)"></span>
                  <span class="badge badge-ok" x-show="!s.end_at">{{.T "time.open"}}</span>
                </td>
                <td class="actions mono num" x-text="WTT.fmt.clock(seconds(s))"></td>
                <td class="actions num" x-text="WTT.fmt.money(amount(s, 'pay'))"></td>
                <td class="actions num" x-text="WTT.fmt.money(amount(s, 'bill'))"></td>
                <td class="actions"><button type="button" class="btn btn-ghost btn-sm" aria-label="{{.T "session.details"}}" title="{{.T "session.details"}}" @click="openSession(s)">{{template "icon" "eye"}}</button></td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
      <nav class="pager" aria-label="{{.T "time.pager"}}" x-cloak x-show="filtered().length > 0">
        <span class="muted small" x-text="sessionSummary()"></span>
        <div class="row row-tight" x-show="sessionPages() > 1">
          <button type="button" class="btn btn-secondary btn-sm" :disabled="page <= 1" @click="page = Math.min(page, sessionPages()) - 1">{{template "icon" "chevron-left"}} {{.T "time.prev"}}</button>
          <button type="button" class="btn btn-secondary btn-sm" :disabled="page >= sessionPages()" @click="page = Math.min(page, sessionPages()) + 1">{{.T "time.next"}} {{template "icon" "chevron-right"}}</button>
        </div>
      </nav>
    </section>
  </template>
</main>
{{end}}
