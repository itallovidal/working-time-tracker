{{define "content"}}
<main class="page" x-data="orgSettings">
  {{/* A tela de edição abre pelo botão Editar das Configurações e volta para elas, na mesma largura. */}}
  <div class="page-head">
    <div>
      <div class="eyebrow" data-org-name>{{.Me.OrganizationName}}</div>
      <h1>{{.T "org.settings.title"}}</h1>
    </div>
    <a class="btn btn-ghost btn-sm" href="/orgs/{{.OrgID}}/about">{{template "icon" "arrow-left"}} {{.T "common.back"}}</a>
  </div>

  <div class="stack">
    <form class="stack" novalidate @submit.prevent="saveOrg()">
      <section class="card">
        <div class="card-head"><h2>{{.T "org.settings.identity"}}</h2></div>
        <div class="field">
          <label for="org-name">{{.T "common.name"}}</label>
          <input id="org-name" type="text" data-field="name" maxlength="{{limit "name"}}" x-model="form.name" @input="clearField('name')" :aria-invalid="fieldErrors.name ? 'true' : 'false'">
          {{template "field_error" "name"}}
        </div>
        <div class="field">
          {{template "field_label" (dict "D" . "For" "org-summary" "Key" "org.settings.summary" "Optional" true)}}
          <input id="org-summary" type="text" data-field="summary" maxlength="{{limit "summary"}}" x-model="form.summary" @input="clearField('summary')" :aria-invalid="fieldErrors.summary ? 'true' : 'false'">
          {{template "field_error" "summary"}}
          <span class="hint">{{.T "org.settings.summary_hint"}} <span class="num" x-text="summaryLength() + '/{{limit "summary"}}'"></span></span>
        </div>
        <div class="field">
          {{template "field_label" (dict "D" . "For" "org-description" "Key" "common.description_label" "Optional" true)}}
          <textarea id="org-description" rows="5" data-field="description" maxlength="{{limit "description"}}" x-model="form.description" @input="clearField('description')" :aria-invalid="fieldErrors.description ? 'true' : 'false'"></textarea>
          {{template "field_error" "description"}}
          <span class="hint">{{.T "org.settings.description_hint"}}</span>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2>{{.T "org.settings.contact"}}</h2></div>
        <div class="fields">
          <div class="field">
            {{template "field_label" (dict "D" . "For" "org-website" "Key" "org.fields.website" "Optional" true)}}
            <input id="org-website" type="text" inputmode="url" data-field="website" maxlength="{{limit "url"}}" placeholder="{{.T "org.settings.website_placeholder"}}" x-model="form.website" @input="clearField('website')" :aria-invalid="fieldErrors.website ? 'true' : 'false'">
            {{template "field_error" "website"}}
          </div>
          <div class="field">
            {{template "field_label" (dict "D" . "For" "org-email" "Key" "org.settings.contact_email" "Optional" true)}}
            <input id="org-email" type="email" data-field="contact_email" maxlength="{{limit "email"}}" x-model="form.contact_email" @input="clearField('contact_email')" :aria-invalid="fieldErrors.contact_email ? 'true' : 'false'">
            {{template "field_error" "contact_email"}}
          </div>
          <div class="field">
            {{template "field_label" (dict "D" . "For" "org-linkedin" "Key" "org.fields.linkedin" "Optional" true)}}
            <input id="org-linkedin" type="text" inputmode="url" data-field="linkedin_url" maxlength="{{limit "url"}}" placeholder="{{.T "org.settings.linkedin_placeholder"}}" x-model="form.linkedin_url" @input="clearField('linkedin_url')" :aria-invalid="fieldErrors.linkedin_url ? 'true' : 'false'">
            {{template "field_error" "linkedin_url"}}
          </div>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2>{{.T "org.settings.legal"}}</h2></div>
        {{/* O país decide o documento fiscal e o texto do endereço: os rótulos e as máscaras vêm do cadastro de países
             (BOOT.countries), e o documento do outro país fica guardado, escondido. */}}
        <div class="fields">
          <div class="field">
            {{template "field_label" (dict "D" . "For" "org-legal-name" "Key" "org.fields.legal_name" "Optional" true)}}
            <input id="org-legal-name" type="text" data-field="legal_name" maxlength="{{limit "legal_name"}}" x-model="form.legal_name" @input="clearField('legal_name')" :aria-invalid="fieldErrors.legal_name ? 'true' : 'false'">
            {{template "field_error" "legal_name"}}
          </div>
          <div class="field">
            <label for="org-country">{{.T "org.settings.country"}}</label>
            <select id="org-country" x-model="form.country">
              <template x-for="c in countryOptions" :key="c.code">
                <option :value="c.code" x-text="c.name" :selected="c.code === form.country"></option>
              </template>
            </select>
            <span class="hint">{{.T "org.settings.country_hint"}}</span>
          </div>
        </div>
        <div class="fields">
          <div class="field">
            <label for="org-legal-id"><span x-text="profile.legal_id.label"></span> <span class="optional">{{.T "common.optional_label"}}</span></label>
            <input id="org-legal-id" type="text" class="mono" :data-field="profile.legal_id.field" :maxlength="profile.legal_id.mask.length" :placeholder="profile.legal_id.placeholder" x-model="form[profile.legal_id.field]" @input="maskLegal(); clearField(profile.legal_id.field)" :aria-invalid="fieldErrors[profile.legal_id.field] ? 'true' : 'false'">
            <p class="form-error" x-cloak x-show="fieldErrors[profile.legal_id.field]" x-text="fieldErrors[profile.legal_id.field]" role="alert"></p>
          </div>
        </div>
        <div class="fields">
          <div class="field">
            {{template "field_label" (dict "D" . "For" "org-address1" "Key" "org.fields.address" "Optional" true)}}
            <input id="org-address1" type="text" data-field="address_line1" maxlength="{{limit "address"}}" :placeholder="profile.address.line1_placeholder" x-model="form.address_line1" @input="clearField('address_line1')" :aria-invalid="fieldErrors.address_line1 ? 'true' : 'false'">
            {{template "field_error" "address_line1"}}
          </div>
          <div class="field">
            <label for="org-address2"><span x-text="profile.address.line2_label"></span> <span class="optional">{{.T "common.optional_label"}}</span></label>
            <input id="org-address2" type="text" data-field="address_line2" maxlength="{{limit "address"}}" x-model="form.address_line2" @input="clearField('address_line2')" :aria-invalid="fieldErrors.address_line2 ? 'true' : 'false'">
            {{template "field_error" "address_line2"}}
          </div>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2>{{.T "org.settings.how_we_work"}}</h2></div>
        <div class="fields">
          <div class="field">
            {{template "field_label" (dict "D" . "For" "org-work-mode" "Key" "org.settings.work_mode" "Optional" true)}}
            <select id="org-work-mode" x-model="form.work_mode">
              <option value="">{{.T "labels.not_informed"}}</option>
              <template x-for="m in WTT.workModes" :key="m.value">
                <option :value="m.value" x-text="m.label" :selected="m.value === form.work_mode"></option>
              </template>
            </select>
          </div>
          <div class="field">
            <label for="org-timezone">{{.T "org.fields.timezone"}}</label>
            <select id="org-timezone" x-model="form.timezone">
              <template x-for="tz in timezones" :key="tz">
                <option :value="tz" x-text="tz" :selected="tz === form.timezone"></option>
              </template>
            </select>
          </div>
          <div class="field">
            <label for="org-currency">{{.T "org.fields.currency"}}</label>
            <select id="org-currency" x-model="form.currency">
              <template x-for="c in WTT.currencies" :key="c.value">
                <option :value="c.value" x-text="c.label" :selected="c.value === form.currency"></option>
              </template>
            </select>
          </div>
        </div>
        <p class="muted small">{{.T "org.settings.hours_note"}}</p>
      </section>

      <p class="form-error" x-show="errors.org" x-text="errors.org" role="alert"></p>
      <div class="row row-end">
        <a class="btn btn-secondary" href="/orgs/{{.OrgID}}/about">{{.T "common.cancel"}}</a>
        <button type="submit" class="btn" :disabled="pending">{{.T "common.save"}}</button>
      </div>
    </form>

    {{/* Só o dono exclui a organização (o servidor recusa o resto). */}}
    {{if .IsOwner}}
    <section class="card">
      <div class="card-head"><h2>{{.T "org.settings.delete_title"}}</h2></div>
      <p class="muted small">{{.T "org.settings.delete_warning"}}</p>
      <p class="form-error" x-show="errors.delete" x-text="errors.delete" role="alert"></p>
      <div class="row" x-show="!confirmDelete">
        <button type="button" class="btn btn-danger-ghost" @click="confirmDelete = true">{{template "icon" "trash"}} {{.T "org.settings.delete_title"}}</button>
      </div>
      <div class="confirm" x-cloak x-show="confirmDelete">
        <span>{{.T "org.settings.delete_confirm"}}</span>
        <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="deleteOrg()">{{.T "common.delete"}}</button>
        <button type="button" class="btn btn-ghost btn-sm" @click="confirmDelete = false">{{.T "common.cancel"}}</button>
      </div>
    </section>
    {{end}}
  </div>
</main>
{{end}}
