{{define "content"}}
<main class="page" x-data="orgSettings">
  {{template "org_head" .}}

  <div class="stack stack-form">
    <form class="stack" @submit.prevent="saveOrg()">
      <section class="card">
        <div class="card-head"><h2>Identidade</h2></div>
        <div class="field">
          <label for="org-name">Nome</label>
          <input id="org-name" type="text" required maxlength="120" x-model="form.name">
        </div>
        <div class="field">
          <label for="org-summary">Resumo</label>
          <input id="org-summary" type="text" maxlength="160" x-model="form.summary">
          <span class="hint">Uma linha que aparece no cabeçalho da organização. <span class="num" x-text="form.summary.length + '/160'"></span></span>
        </div>
        <div class="field">
          <label for="org-description">Descrição</label>
          <textarea id="org-description" rows="5" maxlength="2000" x-model="form.description"></textarea>
          <span class="hint">O que a organização faz e para quem. Todos os membros leem na aba Sobre.</span>
        </div>
        <div class="fields">
          <div class="field">
            <label for="org-industry">Segmento</label>
            <input id="org-industry" type="text" maxlength="100" placeholder="Ex.: logística, saúde, tecnologia" x-model="form.industry">
          </div>
          <div class="field">
            <label for="org-founded">Ano de fundação</label>
            <input id="org-founded" type="number" min="1900" :max="thisYear" x-model="form.founded_year">
          </div>
          <div class="field">
            <label for="org-size">Porte</label>
            <select id="org-size" x-model="form.size">
              <option value="">Não informado</option>
              <template x-for="s in WTT.orgSizes" :key="s.value">
                <option :value="s.value" x-text="s.label" :selected="s.value === form.size"></option>
              </template>
            </select>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2>Contato</h2></div>
        <div class="fields">
          <div class="field">
            <label for="org-website">Site</label>
            <input id="org-website" type="text" inputmode="url" maxlength="255" placeholder="https://exemplo.com.br" x-model="form.website">
          </div>
          <div class="field">
            <label for="org-email">Email de contato</label>
            <input id="org-email" type="email" maxlength="255" x-model="form.contact_email">
          </div>
          <div class="field">
            <label for="org-phone">Telefone</label>
            <input id="org-phone" type="tel" maxlength="32" placeholder="+55 (11) 4002-8922" x-model="form.phone">
          </div>
        </div>
        <div class="fields">
          <div class="field">
            <label for="org-linkedin">LinkedIn</label>
            <input id="org-linkedin" type="text" inputmode="url" maxlength="255" placeholder="https://www.linkedin.com/company/…" x-model="form.linkedin_url">
          </div>
          <div class="field">
            <label for="org-instagram">Instagram</label>
            <input id="org-instagram" type="text" inputmode="url" maxlength="255" placeholder="https://www.instagram.com/…" x-model="form.instagram_url">
          </div>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2>Dados jurídicos</h2></div>
        <div class="fields">
          <div class="field">
            <label for="org-legal-name">Razão social</label>
            <input id="org-legal-name" type="text" maxlength="200" x-model="form.legal_name">
          </div>
          <div class="field">
            <label for="org-cnpj">CNPJ</label>
            <input id="org-cnpj" type="text" class="mono" maxlength="18" placeholder="00.000.000/0000-00" x-model="form.cnpj">
          </div>
        </div>
        <div class="fields">
          <div class="field">
            <label for="org-address1">Endereço</label>
            <input id="org-address1" type="text" maxlength="200" placeholder="Rua e número" x-model="form.address_line1">
          </div>
          <div class="field">
            <label for="org-address2">Complemento e bairro</label>
            <input id="org-address2" type="text" maxlength="200" x-model="form.address_line2">
          </div>
        </div>
        <div class="fields">
          <div class="field">
            <label for="org-city">Cidade</label>
            <input id="org-city" type="text" maxlength="100" x-model="form.city">
          </div>
          <div class="field">
            <label for="org-state">Estado</label>
            <input id="org-state" type="text" maxlength="100" x-model="form.state">
          </div>
          <div class="field">
            <label for="org-postal">CEP</label>
            <input id="org-postal" type="text" maxlength="16" x-model="form.postal_code">
          </div>
          <div class="field">
            <label for="org-country">País</label>
            <input id="org-country" type="text" maxlength="100" x-model="form.country">
          </div>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2>Padrões</h2></div>
        <div class="fields">
          <div class="field">
            <label for="org-timezone">Fuso horário</label>
            <select id="org-timezone" x-model="form.timezone">
              <template x-for="tz in timezones" :key="tz">
                <option :value="tz" x-text="tz" :selected="tz === form.timezone"></option>
              </template>
            </select>
          </div>
          <div class="field">
            <label for="org-currency">Moeda</label>
            <select id="org-currency" x-model="form.currency">
              <template x-for="c in WTT.currencies" :key="c.value">
                <option :value="c.value" x-text="c.label" :selected="c.value === form.currency"></option>
              </template>
            </select>
          </div>
        </div>
        <div class="fields">
          <div class="field">
            <label for="org-weekly-hours">Jornada semanal (horas)</label>
            <input id="org-weekly-hours" type="number" min="1" max="168" x-model="form.weekly_hours">
          </div>
          <div class="field">
            <label for="org-sprint">Sprint padrão (dias)</label>
            <input id="org-sprint" type="number" min="1" max="90" placeholder="14" x-model="form.default_sprint_days">
            <span class="hint">Vale para os projetos novos.</span>
          </div>
        </div>
      </section>

      <p class="form-error" x-show="errors.org" x-text="errors.org" role="alert"></p>
      <div class="row row-end"><button type="submit" class="btn" :disabled="pending">Salvar</button></div>
    </form>

    <section class="card">
      <div class="card-head"><h2>Excluir organização</h2></div>
      <p class="muted small">Apaga a organização, todas as pessoas e os convites. Só é possível depois de excluir todos os projetos.</p>
      <p class="form-error" x-show="errors.delete" x-text="errors.delete" role="alert"></p>
      <div class="row" x-show="!confirmDelete">
        <button type="button" class="btn btn-danger-ghost" @click="confirmDelete = true">Excluir organização</button>
      </div>
      <div class="confirm" x-cloak x-show="confirmDelete">
        <span>Excluir de vez? Isso não pode ser desfeito.</span>
        <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="deleteOrg()">Excluir</button>
        <button type="button" class="btn btn-ghost btn-sm" @click="confirmDelete = false">Cancelar</button>
      </div>
    </section>
  </div>
</main>
{{end}}
