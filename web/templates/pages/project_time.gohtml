{{define "content"}}
<main class="page" x-data="timeTracking">
  {{template "project_head" .}}

  {{/* O aviso fica acima dos cartões: dentro do relógio ele deixava um cartão mais alto que o outro. */}}
  <p class="alert alert-warn" x-cloak x-show="!loading && !errors.load && myRate === null">
    {{.T "time.no_rate"}}
    {{if .IsAdmin}}
    {{.T "time.set_rate_before"}} <a href="/projects/{{.Project.ID}}/teams">{{.T "project.head.teams"}}</a>{{.T "time.set_rate_after"}}
    {{else}}
    {{.T "time.ask_admin"}}
    {{end}}
  </p>

  <div class="grid-aside items-stretch">
    <section class="clock" aria-live="polite">
      <p class="muted" x-show="!$store.clock.ready">{{.T "common.loading"}}</p>

      <template x-if="$store.clock.ready && $store.clock.session">
        <div class="stack">
          <div class="clock-status"><span class="pulse" aria-hidden="true"></span> {{.T "time.running"}}</div>
          <div class="clock-face running" x-text="WTT.fmt.clock($store.clock.elapsed())"></div>
          <div>
            <a :href="'/tasks/' + $store.clock.session.task.id" x-text="$store.clock.session.task.name"></a>
            <span class="muted" x-text="$t('time.since', { time: WTT.fmt.time($store.clock.session.start_at) })"></span>
          </div>
          <p class="alert alert-warn" x-show="$store.clock.session.task.project_id !== project.id">
            {{.T "time.other_project"}}
          </p>
          <div class="row"><button type="button" class="btn btn-danger" :disabled="pending" @click="stop()">{{.T "time.stop"}}</button></div>
        </div>
      </template>

      <template x-if="$store.clock.ready && !$store.clock.session">
        <form class="stack" @submit.prevent="start()">
          <div class="clock-status muted">{{.T "time.stopped"}}</div>
          <div class="clock-face">00:00:00</div>
          <p class="muted" x-show="tasks.length === 0 && !loading">
            {{.T "time.no_tasks"}} <a href="/projects/{{.Project.ID}}/tasks">{{.T "time.create_task"}}</a>
          </p>
          <div class="row" x-show="tasks.length > 0">
            <select class="flex-1" x-model="taskId" aria-label="{{.T "time.task"}}">
              <template x-for="t in tasks" :key="t.id">
                <option :value="t.id" x-text="t.name" :selected="t.id === taskId"></option>
              </template>
            </select>
            <button type="submit" class="btn" :disabled="pending || !taskId || myRate === null">{{.T "time.start"}}</button>
          </div>
        </form>
      </template>
      <p class="form-error" x-cloak x-show="errors.clock" x-text="errors.clock" role="alert"></p>
    </section>

    <section class="card">
      <div class="card-head"><h2>{{.T "time.yours"}}</h2></div>
      <div class="totals">
        <div class="total">
          <div class="v" x-text="WTT.fmt.hours(mine('today'))"></div>
          <div class="k">{{.T "time.today"}}<span x-show="myRate !== null"> · <span class="num" x-text="WTT.fmt.money(earned('today'))"></span></span></div>
        </div>
        <div class="total">
          <div class="v" x-text="WTT.fmt.hours(mine('week'))"></div>
          <div class="k">{{.T "time.this_week"}}<span x-show="myRate !== null"> · <span class="num" x-text="WTT.fmt.money(earned('week'))"></span></span></div>
        </div>
      </div>
      <p class="muted small" x-cloak x-show="myRate !== null">
        {{.T "time.your_rate_before"}} <strong class="num" x-text="WTT.fmt.money(myRate)"></strong> {{.T "time.your_rate_after"}}
      </p>
    </section>
  </div>

  <section class="stack">
    <div class="stack stack-tight">
      <h2>{{.T "time.sessions"}}</h2>
      <p class="muted">{{if .IsAdmin}}{{.T "time.sessions_intro_admin"}}{{else}}{{.T "time.sessions_intro_member"}}{{end}} {{.T "time.totals_follow"}}</p>
    </div>
    <div class="row filters">
      <select x-model="filter.person" aria-label="{{.T "time.person_filter"}}">
        <option value="">{{.T "time.all_people"}}</option>
        <template x-for="p in people()" :key="p.id"><option :value="p.id" x-text="p.name"></option></template>
      </select>
      <input type="date" x-model="filter.date" aria-label="{{.T "time.date_filter"}}" title="{{.T "time.date_filter_title"}}">
      <select x-model="filter.task" aria-label="{{.T "time.task_filter"}}">
        <option value="">{{.T "time.all_tasks"}}</option>
        <template x-for="t in tasks" :key="t.id"><option :value="t.id" x-text="t.name"></option></template>
      </select>
      <button type="button" class="btn btn-ghost btn-sm" x-cloak x-show="hasFilters()" @click="clearFilters()">{{template "icon" "xmark"}} {{.T "common.clear_filters"}}</button>
    </div>
    <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load"></p>

    {{/* Os totais ficam num cartão próprio, e a tabela, só com a lista das sessões. */}}
    <section class="card" x-cloak x-show="filtered().length > 0">
      <div class="card-head">
        <h3>{{.T "time.totals"}}</h3>
        <span class="muted small" x-text="hasFilters() ? $t('time.count_filtered', { count: filtered().length }) : $t('time.count', { count: filtered().length })"></span>
      </div>
      <div class="totals">
        <div class="total">
          <div class="v" x-text="WTT.fmt.hours(filteredTotal())"></div>
          <div class="k">{{.T "time.time_total"}}</div>
        </div>
        {{if .IsAdmin}}
        <div class="total">
          <div class="v" x-text="WTT.fmt.money(filteredAmount('pay'))"></div>
          <div class="k">{{.T "time.cost"}}</div>
        </div>
        <div class="total">
          <div class="v" x-text="WTT.fmt.money(filteredAmount('bill'))"></div>
          <div class="k">{{.T "time.revenue"}}</div>
        </div>
        <div class="total">
          <div class="v" :class="filteredMargin() < 0 && 'text-danger'" x-text="WTT.fmt.money(filteredMargin())"></div>
          <div class="k">{{.T "time.margin"}}</div>
        </div>
        {{else}}
        <div class="total">
          <div class="v" x-text="WTT.fmt.money(filteredAmount('pay'))"></div>
          <div class="k">{{.T "time.your_value"}}</div>
        </div>
        {{end}}
      </div>
    </section>

    <div class="empty" x-cloak x-show="!loading && filtered().length === 0">
      <strong>{{.T "time.empty"}}</strong>
      <span x-text="hasFilters() ? $t('time.empty_filtered') : $t('time.empty_text')"></span>
    </div>
    <div class="table-wrap" x-show="filtered().length > 0">
      <table>
        <thead>
          <tr>
            <th>{{.T "time.col_person"}}</th><th>{{.T "time.col_task"}}</th><th>{{.T "time.col_start"}}</th><th>{{.T "time.col_end"}}</th><th class="actions">{{.T "time.col_duration"}}</th>
            {{if .IsAdmin}}<th class="actions">{{.T "time.cost"}}</th><th class="actions">{{.T "time.revenue"}}</th>{{else}}<th class="actions">{{.T "time.your_value"}}</th>{{end}}
          </tr>
        </thead>
        <tbody>
          <template x-for="s in filtered()" :key="s.id">
            <tr>
              <td x-text="s.person ? s.person.name : ''"></td>
              <td><a :href="'/tasks/' + s.task_id" x-text="s.task ? s.task.name : ''"></a></td>
              <td class="num" x-text="WTT.fmt.dateTime(s.start_at)"></td>
              <td class="num">
                <span x-show="s.end_at" x-text="WTT.fmt.dateTime(s.end_at)"></span>
                <span class="badge badge-ok" x-show="!s.end_at">{{.T "time.open"}}</span>
              </td>
              <td class="actions mono num" x-text="WTT.fmt.clock($store.clock.elapsed(s))"></td>
              <td class="actions num" x-text="WTT.fmt.money(amount(s, 'pay'))"></td>
              {{if .IsAdmin}}<td class="actions num" x-text="WTT.fmt.money(amount(s, 'bill'))"></td>{{end}}
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </section>
</main>
{{end}}
