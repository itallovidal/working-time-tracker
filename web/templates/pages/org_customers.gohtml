{{define "content"}}
<main class="page" x-data="orgCustomers">
  <div class="page-head">
    <div>
      <div class="eyebrow" data-org-name>{{.Me.OrganizationName}}</div>
      <h1>{{.T "nav.customers"}}</h1>
      <p class="lede">{{.T "org.customers.intro"}}</p>
    </div>
    <button type="button" class="btn" @click="openForm()">{{template "icon" "plus"}} {{.T "org.customers.new"}}</button>
  </div>

  <section class="stack">
    <p class="muted" x-show="loading">{{.T "org.customers.loading"}}</p>
    <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load"></p>
    <p class="form-error" x-cloak x-show="errors.remove" x-text="errors.remove" role="alert"></p>

    <div class="empty" x-cloak x-show="!loading && !errors.load && customers.length === 0">
      {{template "icon" "handshake"}}
      <strong>{{.T "org.customers.empty"}}</strong>
      <span>{{.T "org.customers.empty_text"}}</span>
    </div>

    <div class="table-wrap" x-show="customers.length > 0">
      <table>
        <thead>
          <tr><th>{{.T "org.customers.customer"}}</th><th>{{.T "countries.generic.legal_id.label"}}</th><th>{{.T "org.customers.contact"}}</th>{{if .Me.OrganizationSolo}}<th>{{.T "customer.billing.column"}}</th>{{end}}<th>{{.T "org.customers.projects"}}</th><th class="actions"><span class="sr-only">{{.T "common.actions"}}</span></th></tr>
        </thead>
        <tbody>
          <template x-for="c in customers" :key="c.id">
            <tr>
              <td class="nowrap">
                <div x-text="c.name"></div>
                <div class="muted small" x-text="WTT.countries.name(c.country)"></div>
              </td>
              <td class="nowrap">
                <span class="muted small" x-show="c.document && WTT.countries.legalId(c.country).field" x-text="WTT.countries.legalId(c.country).label"></span>
                <span class="mono num" x-show="c.document" x-text="WTT.fmt.taxId(c.document, c.country)"></span>
                <span class="muted" x-show="!c.document" x-text="WTT.notInformed"></span>
              </td>
              <td>
                <div x-show="c.contact_name" x-text="c.contact_name"></div>
                <div class="muted small" x-show="c.contact_email || c.contact_phone" x-text="[c.contact_email, c.contact_phone].filter(Boolean).join(' · ')"></div>
                <span class="muted" x-show="!c.contact_name && !c.contact_email && !c.contact_phone" x-text="WTT.notInformed"></span>
              </td>
              {{if .Me.OrganizationSolo}}
              <td>
                <div x-text="billingLabel(c)"></div>
                <div class="muted small" x-text="billingTerms(c)"></div>
              </td>
              {{end}}
              <td class="num" x-text="c.project_count"></td>
              <td class="actions">
                <span x-show="confirming !== c.id">
                  <button type="button" class="btn btn-ghost btn-sm" @click="openForm(c)">{{template "icon" "pen"}} {{.T "common.edit"}}</button>
                  <button type="button" class="btn btn-danger-ghost btn-sm" @click="confirming = c.id">{{template "icon" "trash"}} {{.T "common.delete"}}</button>
                </span>
                <span class="confirm" x-cloak x-show="confirming === c.id">
                  <span>{{.T "org.customers.delete_question"}}</span>
                  <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="remove(c)">{{.T "common.delete"}}</button>
                  <button type="button" class="btn btn-ghost btn-sm" @click="confirming = null">{{.T "common.cancel"}}</button>
                </span>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </section>

  {{/* O formulário aparece no modal do layout base, mas continua no escopo de orgCustomers. */}}
  <template x-teleport="#modal-root">
    <form class="stack" novalidate x-show="$store.modal.name === 'customer'" @submit.prevent="save()">
      <div class="field">
        <label for="customer-name">{{.T "common.name"}}</label>
        <input id="customer-name" type="text" data-field="name" maxlength="{{limit "name"}}" x-model="draft.name" @input="clearField('name')" :aria-invalid="fieldErrors.name ? 'true' : 'false'" data-autofocus>
        {{template "field_error" "name"}}
      </div>
      {{template "customer_document" (dict "Data" . "Model" "draft" "Id" "customer" "Country" true)}}
      <div class="field">
        {{template "field_label" (dict "D" . "For" "customer-contact" "Key" "org.customers.contact_person" "Optional" true)}}
        <input id="customer-contact" type="text" data-field="contact_name" maxlength="{{limit "name"}}" x-model="draft.contact_name" @input="clearField('contact_name')" :aria-invalid="fieldErrors.contact_name ? 'true' : 'false'">
        {{template "field_error" "contact_name"}}
      </div>
      <div class="field">
        {{template "field_label" (dict "D" . "For" "customer-email" "Key" "common.email" "Optional" true)}}
        <input id="customer-email" type="email" data-field="contact_email" maxlength="{{limit "email"}}" x-model="draft.contact_email" @input="clearField('contact_email')" :aria-invalid="fieldErrors.contact_email ? 'true' : 'false'">
        {{template "field_error" "contact_email"}}
      </div>
      <div class="field">
        {{template "field_label" (dict "D" . "For" "customer-phone" "Key" "common.phone" "Optional" true)}}
        <input id="customer-phone" type="tel" data-field="contact_phone" maxlength="{{limit "phone"}}" x-model="draft.contact_phone" @input="clearField('contact_phone')" :aria-invalid="fieldErrors.contact_phone ? 'true' : 'false'">
        {{template "field_error" "contact_phone"}}
      </div>
      {{/* Os termos comerciais só existem no modo solo: o cliente por hora tem o valor padrão, e o mensal, o contrato. */}}
      {{if .Me.OrganizationSolo}}
      <fieldset class="form-group">
        <legend>{{.T "customer.billing.title"}}</legend>
        <div class="field">
          <label for="customer-billing-mode">{{.T "customer.billing.mode"}}</label>
          <select id="customer-billing-mode" data-field="billing_mode" x-model="draft.billing_mode" :disabled="modeLocked" @change="clearField('billing_mode')" :aria-invalid="fieldErrors.billing_mode ? 'true' : 'false'">
            <option value="hourly">{{.T "customer.billing.hourly"}}</option>
            <option value="monthly">{{.T "customer.billing.monthly"}}</option>
          </select>
          {{template "field_error" "billing_mode"}}
          <span class="hint" x-show="modeLocked">{{.T "customer.billing.mode_locked"}}</span>
          <span class="hint" x-show="!modeLocked">{{.T "customer.billing.mode_hint"}}</span>
        </div>

        <div class="field" x-show="draft.billing_mode === 'hourly'">
          <label for="customer-default-rate"><span x-text="$t('customer.billing.default_rate', { unit: WTT.fmt.moneyUnit() })"></span> <span class="optional">{{.T "common.optional_label"}}</span></label>
          <input id="customer-default-rate" type="text" inputmode="decimal" class="num" placeholder="{{.T "project_settings.rate_placeholder"}}" data-field="default_rate_cents" x-model="draft.default_rate" @input="clearField('default_rate_cents')" :aria-invalid="fieldErrors.default_rate_cents ? 'true' : 'false'">
          {{template "field_error" "default_rate_cents"}}
          <span class="hint">{{.T "customer.billing.default_rate_hint"}}</span>
        </div>

        <div class="stack" x-show="draft.billing_mode === 'monthly'">
          <div class="field">
            <label for="customer-monthly-fee"><span x-text="$t('customer.billing.monthly_fee', { unit: WTT.fmt.moneyUnit() })"></span></label>
            <input id="customer-monthly-fee" type="text" inputmode="decimal" class="num" data-field="monthly_fee_cents" x-model="draft.monthly_fee" @input="clearField('monthly_fee_cents')" :aria-invalid="fieldErrors.monthly_fee_cents ? 'true' : 'false'">
            {{template "field_error" "monthly_fee_cents"}}
          </div>
          <div class="fields">
            <div class="field">
              <label for="customer-contract-start">{{.T "customer.billing.contract_start"}}</label>
              <input id="customer-contract-start" type="date" data-field="contract_start" x-model="draft.contract_start" @input="clearField('contract_start')" :aria-invalid="fieldErrors.contract_start ? 'true' : 'false'">
              {{template "field_error" "contract_start"}}
            </div>
            <div class="field">
              {{template "field_label" (dict "D" . "For" "customer-contract-end" "Key" "customer.billing.contract_end" "Optional" true)}}
              <input id="customer-contract-end" type="date" data-field="contract_end" x-model="draft.contract_end" @input="clearField('contract_end')" :aria-invalid="fieldErrors.contract_end ? 'true' : 'false'">
              {{template "field_error" "contract_end"}}
            </div>
          </div>
          <span class="hint">{{.T "customer.billing.contract_end_hint"}}</span>
        </div>

        <div class="fields">
          <div class="field">
            <label for="customer-closing-day">{{.T "customer.billing.closing_day"}}</label>
            <input id="customer-closing-day" type="number" min="1" max="31" step="1" class="num" data-field="closing_day" x-model="draft.closing_day" @input="clearField('closing_day')" :aria-invalid="fieldErrors.closing_day ? 'true' : 'false'">
            {{template "field_error" "closing_day"}}
          </div>
          <div class="field">
            <label for="customer-payment-days">{{.T "customer.billing.payment_days"}}</label>
            <input id="customer-payment-days" type="number" min="0" max="{{limit "term_days"}}" step="1" class="num" data-field="payment_days" x-model="draft.payment_days" @input="clearField('payment_days')" :aria-invalid="fieldErrors.payment_days ? 'true' : 'false'">
            {{template "field_error" "payment_days"}}
          </div>
        </div>
        <span class="hint">{{.T "customer.billing.closing_day_hint"}} {{.T "customer.billing.payment_days_hint"}}</span>

        {{/* Multa, juros e tolerância ficam recolhidos: quase todo cliente é cobrado sem eles. */}}
        <details class="form-fold" x-show="draft.billing_mode === 'monthly'" :open="lateOpen" @toggle="lateOpen = $event.target.open">
          <summary>{{.T "customer.billing.late_title"}}</summary>
          <div class="stack">
            <span class="hint">{{.T "customer.billing.late_hint"}}</span>
            <div class="fields">
              <div class="field">
                {{template "field_label" (dict "D" . "For" "customer-late-fee" "Key" "customer.billing.late_fee" "Optional" true)}}
                <input id="customer-late-fee" type="text" inputmode="decimal" class="num" placeholder="0" data-field="late_fee_bp" x-model="draft.late_fee" @input="clearField('late_fee_bp')" :aria-invalid="fieldErrors.late_fee_bp ? 'true' : 'false'">
                {{template "field_error" "late_fee_bp"}}
              </div>
              <div class="field">
                {{template "field_label" (dict "D" . "For" "customer-late-interest" "Key" "customer.billing.late_interest" "Optional" true)}}
                <input id="customer-late-interest" type="text" inputmode="decimal" class="num" placeholder="0" data-field="late_interest_bp_month" x-model="draft.late_interest" @input="clearField('late_interest_bp_month')" :aria-invalid="fieldErrors.late_interest_bp_month ? 'true' : 'false'">
                {{template "field_error" "late_interest_bp_month"}}
              </div>
              <div class="field">
                {{template "field_label" (dict "D" . "For" "customer-grace-days" "Key" "customer.billing.grace_days" "Optional" true)}}
                <input id="customer-grace-days" type="number" min="0" max="{{limit "term_days"}}" step="1" class="num" placeholder="0" data-field="grace_days" x-model="draft.grace_days" @input="clearField('grace_days')" :aria-invalid="fieldErrors.grace_days ? 'true' : 'false'">
                {{template "field_error" "grace_days"}}
              </div>
            </div>
          </div>
        </details>
      </fieldset>
      {{end}}
      <p class="form-error" x-show="errors.save" x-text="errors.save" role="alert"></p>
      <div class="row row-end">
        <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
        <button type="submit" class="btn" :disabled="pending" x-text="editing ? $t('common.save') : $t('org.customers.create')">{{.T "org.customers.create"}}</button>
      </div>
    </form>
  </template>
</main>
{{end}}
