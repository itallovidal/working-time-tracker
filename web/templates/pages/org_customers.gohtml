{{define "content"}}
<main class="page" x-data="orgCustomers">
  <div class="page-head">
    <div>
      <div class="eyebrow" data-org-name>{{.Me.OrganizationName}}</div>
      <h1>{{.T "nav.customers"}}</h1>
      <p class="lede">{{.T "org.customers.intro"}}</p>
    </div>
    <button type="button" class="btn" @click="openForm()">{{template "icon" "plus"}} {{.T "org.customers.new"}}</button>
  </div>

  <section class="stack">
    <p class="muted" x-show="loading">{{.T "org.customers.loading"}}</p>
    <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load"></p>

    <div class="empty" x-cloak x-show="!loading && !errors.load && customers.length === 0">
      {{template "icon" "handshake"}}
      <strong>{{.T "org.customers.empty"}}</strong>
      <span>{{.T "org.customers.empty_text"}}</span>
    </div>

    <div class="table-wrap" x-show="customers.length > 0">
      <table>
        <thead>
          {{/* A cobrança mora no cliente (Decisão 21): uma coluna por informação. O modo, o fechamento e o vencimento são
               do modo solo; na equipe todo cliente é por hora, e fica só o valor por hora. O documento fiscal, o contrato
               e as ações ficam nos detalhes, que a linha abre. */}}
          <tr>
            <th>{{.T "org.customers.customer"}}</th>
            {{if .Me.OrganizationSolo}}<th>{{.T "customer.billing.col_mode"}}</th>{{end}}
            <th>{{if .Me.OrganizationSolo}}{{.T "customer.billing.col_amount"}}{{else}}{{.T "customer.billing.col_rate"}}{{end}}</th>
            {{if .Me.OrganizationSolo}}<th>{{.T "customer.billing.col_closing"}}</th><th>{{.T "customer.billing.col_due"}}</th>{{end}}
            <th>{{.T "org.customers.contact"}}</th>
            <th>{{.T "org.customers.projects"}}</th>
          </tr>
        </thead>
        <tbody>
          <template x-for="c in customers" :key="c.id">
            {{/* A linha inteira abre os detalhes; o nome é um botão, para o teclado. */}}
            <tr class="row-link" @click="if (!$event.target.closest('a, button')) openDetails(c)">
              <td class="nowrap">
                <button type="button" class="row-open" aria-haspopup="dialog" @click="openDetails(c)" x-text="c.name"></button>
                <div class="muted small" x-text="WTT.countries.name(c.country)"></div>
              </td>
              {{if .Me.OrganizationSolo}}<td class="nowrap" x-text="billingMode(c)"></td>{{end}}
              <td class="nowrap num" :class="WTT.billing.withoutRate(c) && 'muted'" x-text="billingAmount(c)"></td>
              {{if .Me.OrganizationSolo}}<td class="nowrap" x-text="billingClosing(c)"></td><td class="nowrap" x-text="billingDue(c)"></td>{{end}}
              <td>
                <div x-show="c.contact_name" x-text="c.contact_name"></div>
                <div class="muted small" x-show="c.contact_email || c.contact_phone" x-text="[c.contact_email, c.contact_phone].filter(Boolean).join(' · ')"></div>
                <span class="muted" x-show="!c.contact_name && !c.contact_email && !c.contact_phone" x-text="WTT.notInformed"></span>
              </td>
              <td class="num" x-text="c.project_count"></td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </section>

  {{/* Os detalhes do cliente: o cliente, o contato e a cobrança, só para ler. Editar troca para o formulário, que volta
       para cá ao cancelar ou salvar; Excluir pede confirmação, e o erro do servidor (cliente com projetos) aparece aqui. */}}
  <template x-teleport="#modal-root">
    <div class="stack" x-show="$store.modal.name === 'customer-details'">
      <template x-for="block in customerFacts(viewing())" :key="block.title">
        <section class="stack stack-tight">
          <h3 class="eyebrow" x-text="block.title"></h3>
          <dl class="facts facts-wide">
            <template x-for="f in block.rows" :key="f.label">
              <div class="fact">
                <dt x-text="f.label"></dt>
                <dd>
                  <a x-show="f.href && !f.empty" :href="f.href" x-text="f.value"></a>
                  <span x-show="!f.href || f.empty" :class="{ mono: f.mono && !f.empty, muted: f.empty }" x-text="f.value"></span>
                </dd>
              </div>
            </template>
          </dl>
        </section>
      </template>
      <p class="form-error" x-show="errors.remove" x-text="errors.remove" role="alert"></p>
      <div class="confirm" x-cloak x-show="confirming">
        <span>{{.T "org.customers.delete_question"}}</span>
        <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="remove()">{{.T "common.delete"}}</button>
        <button type="button" class="btn btn-ghost btn-sm" @click="confirming = false">{{.T "common.cancel"}}</button>
      </div>
      <div class="toolbar" x-show="!confirming">
        <button type="button" class="btn btn-danger-ghost" @click="confirming = true; errors.remove = ''">{{template "icon" "trash"}} {{.T "common.delete"}}</button>
        <div class="row">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.close"}}</button>
          <button type="button" class="btn" data-autofocus @click="openForm(viewing())">{{template "icon" "pen"}} {{.T "common.edit"}}</button>
        </div>
      </div>
    </div>
  </template>

  {{/* O formulário aparece no modal do layout base, mas continua no escopo de orgCustomers. */}}
  <template x-teleport="#modal-root">
    <form class="stack" novalidate x-show="$store.modal.name === 'customer'" @submit.prevent="save()">
      <div class="field">
        <label for="customer-name">{{.T "common.name"}}</label>
        <input id="customer-name" type="text" data-field="name" maxlength="{{limit "name"}}" x-model="draft.name" @input="clearField('name')" :aria-invalid="fieldErrors.name ? 'true' : 'false'" data-autofocus>
        {{template "field_error" "name"}}
      </div>
      {{template "customer_document" (dict "Data" . "Model" "draft" "Id" "customer" "Country" true)}}
      <div class="field">
        {{template "field_label" (dict "D" . "For" "customer-contact" "Key" "org.customers.contact_person" "Optional" true)}}
        <input id="customer-contact" type="text" data-field="contact_name" maxlength="{{limit "name"}}" x-model="draft.contact_name" @input="clearField('contact_name')" :aria-invalid="fieldErrors.contact_name ? 'true' : 'false'">
        {{template "field_error" "contact_name"}}
      </div>
      <div class="field">
        {{template "field_label" (dict "D" . "For" "customer-email" "Key" "common.email" "Optional" true)}}
        <input id="customer-email" type="email" data-field="contact_email" maxlength="{{limit "email"}}" x-model="draft.contact_email" @input="clearField('contact_email')" :aria-invalid="fieldErrors.contact_email ? 'true' : 'false'">
        {{template "field_error" "contact_email"}}
      </div>
      <div class="field">
        {{template "field_label" (dict "D" . "For" "customer-phone" "Key" "common.phone" "Optional" true)}}
        <input id="customer-phone" type="tel" data-field="contact_phone" maxlength="{{limit "phone"}}" x-model="draft.contact_phone" @input="clearField('contact_phone')" :aria-invalid="fieldErrors.contact_phone ? 'true' : 'false'">
        {{template "field_error" "contact_phone"}}
      </div>
      {{/* A cobrança mora no cliente (Decisão 21): o valor por hora vale para todos os projetos dele, e cada projeto só
           soma um acréscimo. O modo, o contrato mensal e os prazos só existem no modo solo; na equipe todo cliente é
           por hora, e o modal pede só o valor. */}}
      <fieldset class="form-group">
        <legend>{{.T "customer.billing.title"}}</legend>
        {{if .Me.OrganizationSolo}}
        <div class="field">
          <label for="customer-billing-mode">{{.T "customer.billing.mode"}}</label>
          <select id="customer-billing-mode" data-field="billing_mode" x-model="draft.billing_mode" :disabled="modeLocked" @change="clearField('billing_mode')" :aria-invalid="fieldErrors.billing_mode ? 'true' : 'false'">
            <option value="hourly">{{.T "customer.billing.hourly"}}</option>
            <option value="monthly">{{.T "customer.billing.monthly"}}</option>
          </select>
          {{template "field_error" "billing_mode"}}
          <span class="hint" x-show="modeLocked">{{.T "customer.billing.mode_locked"}}</span>
          <span class="hint" x-show="!modeLocked">{{.T "customer.billing.mode_hint"}}</span>
        </div>
        {{end}}

        <div class="field" x-show="draft.billing_mode === 'hourly'">
          <label for="customer-hourly-rate" x-text="$t('customer.billing.hourly_rate', { unit: WTT.fmt.moneyUnit() })"></label>
          <input id="customer-hourly-rate" type="text" inputmode="decimal" class="num" placeholder="{{.T "project_settings.rate_placeholder"}}" data-field="hourly_rate_cents" x-model="draft.hourly_rate" @input="clearField('hourly_rate_cents')" :aria-invalid="fieldErrors.hourly_rate_cents ? 'true' : 'false'">
          {{template "field_error" "hourly_rate_cents"}}
          <span class="hint">{{.T "customer.billing.hourly_rate_hint"}}</span>
        </div>

        {{if .Me.OrganizationSolo}}
        {{/* O contrato, o fechamento, o prazo e a multa. */}}
        {{template "customer_contract" (dict "Data" . "Model" "draft" "Id" "customer")}}
        {{end}}
      </fieldset>
      <p class="form-error" x-show="errors.save" x-text="errors.save" role="alert"></p>
      <div class="row row-end">
        <button type="button" class="btn btn-secondary" @click="cancelForm()">{{.T "common.cancel"}}</button>
        <button type="submit" class="btn" :disabled="pending" x-text="editing ? $t('common.save') : $t('org.customers.create')">{{.T "org.customers.create"}}</button>
      </div>
    </form>
  </template>
</main>
{{end}}
