{{define "content"}}
<main class="page" x-data="projectTasks">
  {{template "project_head" .}}

  <div class="toolbar">
    <div class="stack">
      <div class="row filters">
        <input type="search" placeholder="{{.T "tasks.search_placeholder"}}" aria-label="{{.T "tasks.search_label"}}"
               x-model="filters.q" @input.debounce.300ms="apply()" :disabled="filters.mine">
        <select aria-label="{{.T "tasks.assignee_filter"}}" x-model="filters.assignee" @change="apply()" :disabled="filters.mine">
          <option value="">{{.T "tasks.all_assignees"}}</option>
          <option value="none" :selected="filters.assignee === 'none'">{{.T "tasks.unassigned"}}</option>
          <template x-for="p in assigneeOptions()" :key="p.id">
            <option :value="p.id" x-text="p.name" :selected="p.id === filters.assignee"></option>
          </template>
        </select>
        <select aria-label="{{.T "tasks.due_filter"}}" x-model="filters.due" @change="apply()">
          <option value="">{{.T "tasks.any_due"}}</option>
          <template x-for="o in dueOptions" :key="o.value">
            <option :value="o.value" x-text="o.label" :selected="o.value === filters.due"></option>
          </template>
        </select>
        <input type="date" aria-label="{{.T "tasks.due_date"}}" x-cloak x-show="filters.due === 'date'"
               x-model="filters.date" @change="apply()">
      </div>
      {{/* Prioridade e etiqueta aceitam várias: a tarefa passa se tem qualquer uma das marcadas. */}}
      <div class="row filter-chips" role="group" aria-label="{{.T "tasks.priority_filter"}}">
        <span class="muted small">{{.T "tasks.col_priority"}}</span>
        <template x-for="p in WTT.priorities" :key="p.value">
          <button type="button" class="chip" :aria-pressed="filters.priority.includes(p.value)" @click="toggleFilter('priority', p.value)" x-text="p.label"></button>
        </template>
      </div>
      <div class="row filter-chips" x-cloak x-show="labels.length > 0" role="group" aria-label="{{.T "tasks.labels_filter"}}">
        <span class="muted small">{{.T "tasks.labels"}}</span>
        <template x-for="l in labels" :key="l.id">
          <button type="button" class="chip" :aria-pressed="filters.label.includes(l.id)" @click="toggleFilter('label', l.id)" x-text="l.name"></button>
        </template>
      </div>
      {{/* Marcada, a caixa desliga a busca e o filtro de responsável: só o prazo continua valendo. */}}
      <div>
        <label class="check">
          <input type="checkbox" :checked="filters.mine" @change="toggleMine($event.target.checked)"> {{.T "tasks.only_mine"}}
        </label>
      </div>
    </div>
    <button type="button" class="btn self-start" @click="openCreate()">{{template "icon" "plus"}} {{.T "tasks.new"}}</button>
  </div>

  <p class="muted" x-show="loading">{{.T "tasks.loading"}}</p>
  <p class="form-error" x-cloak x-show="errors.load || errors.members" x-text="errors.load || errors.members"></p>
  <p class="form-error" x-cloak x-show="errors.clock" x-text="errors.clock" role="alert"></p>

  <div class="empty" x-cloak x-show="!loading && !errors.load && total === 0 && hasFilters()">
    <strong>{{.T "tasks.none_filtered"}}</strong>
    <button type="button" class="btn btn-secondary btn-sm" @click="clear()">{{.T "common.clear_filters"}}</button>
  </div>
  <div class="empty" x-cloak x-show="!loading && !errors.load && total === 0 && !hasFilters()">
    <strong>{{.T "tasks.none"}}</strong>
    <span>{{.T "tasks.none_text"}}</span>
  </div>

  <div class="table-wrap" x-show="tasks.length > 0">
    <table>
      <thead>
        <tr><th>{{.T "tasks.col_task"}}</th><th>{{.T "tasks.col_priority"}}</th><th>{{.T "tasks.col_assignee"}}</th><th>{{.T "tasks.col_deadline"}}</th><th>{{.T "tasks.col_external"}}</th><th class="actions"><span class="sr-only">{{.T "tasks.col_details"}}</span></th></tr>
      </thead>
      <tbody>
        <template x-for="t in tasks" :key="t.id">
          <tr>
            <td>
              <a :href="'/tasks/' + t.id" x-text="t.name"></a>
              <div class="label-list" x-show="t.labels && t.labels.length > 0">
                <template x-for="l in t.labels" :key="l.id"><span class="badge" x-text="l.name"></span></template>
              </div>
            </td>
            <td>
              <span class="badge" :class="priorityClass(t.priority)" x-show="t.priority !== 'none'" x-text="WTT.fmt.priority(t.priority)"></span>
              <span class="muted" x-show="t.priority === 'none'">—</span>
            </td>
            <td>
              <span x-show="t.assignee" x-text="t.assignee ? t.assignee.name : ''"></span>
              <span class="badge" x-show="!t.assignee">{{.T "tasks.unassigned"}}</span>
            </td>
            <td>
              <span class="badge num" :class="deadlineClass(t)" x-text="deadlineLabel(t)"></span>
            </td>
            <td>
              <template x-if="t.external_item_id">
                <a class="badge badge-accent" :href="t.external_item_url" target="_blank" rel="noopener"
                   x-text="externalLabel(t)"></a>
              </template>
              <span class="muted" x-show="!t.external_item_id">—</span>
            </td>
            <td class="actions">
              <span class="badge badge-ok" x-show="isRunning(t)">{{.T "tasks.running"}}</span>
              <a class="btn btn-secondary btn-sm" :href="'/tasks/' + t.id">{{.T "tasks.details"}} {{template "icon" "arrow-right"}}</a>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>

  <nav class="pager" aria-label="{{.T "tasks.pager"}}" x-cloak x-show="total > 0">
    <span class="muted small" x-text="summary()"></span>
    <div class="row row-tight" x-show="pages() > 1">
      <button type="button" class="btn btn-secondary btn-sm" :disabled="page <= 1" @click="go(page - 1)">{{template "icon" "chevron-left"}} {{.T "tasks.prev"}}</button>
      <button type="button" class="btn btn-secondary btn-sm" :disabled="page >= pages()" @click="go(page + 1)">{{.T "tasks.next"}} {{template "icon" "chevron-right"}}</button>
    </div>
  </nav>

  {{/* O formulário aparece no modal do layout base e continua no escopo de projectTasks. */}}
  <template x-teleport="#modal-root">
    {{/* novalidate: a etapa que não está à vista tem campos escondidos, e o navegador não os valida; quem confere é submitStep. */}}
    <form class="stack" novalidate x-show="$store.modal.name === 'task-new'" @submit.prevent="submitStep('create')">
      {{template "task_fields" .}}
      <p class="form-error" x-show="errors.create" x-text="errors.create" role="alert"></p>
      <div class="row row-end">
        <button type="button" class="btn btn-secondary" x-show="step === 1" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
        <button type="button" class="btn btn-secondary" x-show="step === 2" @click="back()">{{template "icon" "arrow-left"}} {{.T "tasks.wizard.back"}}</button>
        <button type="submit" class="btn" x-show="step === 1">{{.T "tasks.wizard.next"}} {{template "icon" "arrow-right"}}</button>
        <button type="submit" class="btn" x-show="step === 2" :disabled="pending">{{.T "tasks.create"}}</button>
      </div>
    </form>
  </template>
</main>
{{end}}
