{{define "content"}}
<main class="page" x-data="projectIntegrations">
  {{template "project_head" .}}

  <div class="toolbar">
    <p class="muted">{{.T "integrations.intro"}}</p>
    {{if .CanDo "integrations.manage"}}
    <button type="button" class="btn" @click="openCreate()">{{template "icon" "plus"}} {{.T "integrations.new"}}</button>
    {{end}}
  </div>

  <p class="muted" x-show="loading">{{.T "integrations.loading"}}</p>
  <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load"></p>

  <div class="empty" x-cloak x-show="!loading && !errors.load && items.length === 0">
    <strong>{{.T "integrations.none"}}</strong>
    {{if .CanDo "integrations.manage"}}
    <span>{{.T "integrations.none_admin"}}</span>
    {{else}}
    <span>{{.T "integrations.none_member"}}</span>
    {{end}}
  </div>

  {{/* O cartão só mostra a integração. O lápis abre o modal, onde ficam a edição, o
       ativar/desativar e a exclusão. */}}
  <div class="grid-2" x-show="items.length > 0">
    <template x-for="it in items" :key="it.id">
      <section class="card">
        <div class="card-head">
          <div class="stack stack-tight">
            <h2 x-text="it.display_name"></h2>
            <div class="row row-tight">
              <span class="badge badge-accent" x-text="typeOf(it.type).label"></span>
              <span class="badge" :class="it.enabled ? 'badge-ok' : ''" x-text="it.enabled ? $t('integrations.active') : $t('integrations.disabled')"></span>
            </div>
          </div>
          {{if .CanDo "integrations.manage"}}
          <button type="button" class="btn btn-ghost btn-sm btn-icon" title="{{.T "integrations.edit_title"}}"
                  :aria-label="$t('integrations.edit_label', { name: it.display_name })" @click="openEdit(it)">{{template "icon" "pen"}}</button>
          {{end}}
        </div>

        <dl class="facts">
          <template x-for="f in facts(it)" :key="f.key">
            <div class="fact">
              <dt x-text="f.label"></dt>
              <dd :class="f.value ? '' : 'muted'" x-text="f.value || WTT.notInformed"></dd>
            </div>
          </template>
          <dt>{{.T "integrations.token"}}</dt>
          <dd :class="it.has_token ? 'mono' : 'muted'" x-text="it.has_token ? '••••••••••••' : WTT.notInformed"></dd>
          <dt>{{.T "integrations.created_at"}}</dt>
          <dd x-text="WTT.fmt.date(it.created_at)"></dd>
        </dl>

        <p class="alert alert-warn" x-cloak x-show="incomplete(it)">
          {{.T "integrations.incomplete"}}
          {{if .CanDo "integrations.manage"}}{{.T "integrations.complete_admin"}}{{else}}{{.T "integrations.complete_member"}}{{end}}
        </p>
      </section>
    </template>
  </div>

  {{if .CanDo "integrations.manage"}}
  {{/* Criar e editar no mesmo modal. O corpo enviado é igual para todas as plataformas:
       nome, token e, em metadata, os campos que o tipo declara. */}}
  <template x-teleport="#modal-root">
    <form class="stack" x-show="$store.modal.name === 'integration-form'" @submit.prevent="save()">
      <template x-if="!draft.id">
        <ul class="list picker" role="radiogroup" aria-label="{{.T "integrations.platform"}}">
          <template x-for="t in types" :key="t.type">
            <li>
              <label class="pick">
                <input type="radio" name="int-type" :value="t.type" x-model="draft.type" @change="pickType()" :disabled="t.coming_soon">
                <span class="grow">
                  <span x-text="t.label"></span>
                  <span class="muted small" x-text="t.description"></span>
                </span>
                <span class="badge" x-show="t.coming_soon">{{.T "integrations.coming_soon"}}</span>
              </label>
            </li>
          </template>
        </ul>
      </template>
      <p class="muted small" x-show="draft.id">
        {{.T "integrations.platform"}}: <span class="badge badge-accent" x-text="typeOf(draft.type).label"></span>
      </p>

      <div class="field">
        <label for="int-name">{{.T "common.name"}}</label>
        <input id="int-name" type="text" required placeholder="{{.T "integrations.name_placeholder"}}" x-model="draft.display_name" data-autofocus>
      </div>
      <div class="field">
        <label for="int-token">{{.T "integrations.token_label"}}</label>
        {{/* new-password: com "off" o navegador ainda oferece a senha salva do site. */}}
        <input id="int-token" type="password" autocomplete="new-password" :required="!draft.id"
               :placeholder="draft.id && draft.has_token ? $t('integrations.keep_token') : ''" x-model="draft.token">
        <span class="hint" x-show="typeOf(draft.type).token_hint" x-text="typeOf(draft.type).token_hint"></span>
      </div>
      <template x-for="f in typeOf(draft.type).metadata" :key="draft.type + '-' + f.key">
        <div class="field">
          <label :for="'int-meta-' + f.key" x-text="f.label"></label>
          <input :id="'int-meta-' + f.key" type="text" autocomplete="off" spellcheck="false" :required="f.required"
                 :placeholder="f.placeholder || ''" x-model="draft.metadata[f.key]">
          <span class="hint" x-show="f.hint" x-text="f.hint"></span>
        </div>
      </template>
      {{/* Uma integração nasce ativa; desativar é coisa de quem edita. */}}
      <div class="stack stack-tight" x-show="draft.id">
        <label class="check"><input type="checkbox" x-model="draft.enabled"> {{.T "integrations.active"}}</label>
        <span class="muted small">{{.T "integrations.enabled_hint"}}</span>
      </div>

      <p class="form-error" x-show="errors.save || errors.remove" x-text="errors.save || errors.remove" role="alert"></p>

      <div class="confirm" x-cloak x-show="confirming">
        <span>{{.T "integrations.delete_question"}}</span>
        <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="remove()">{{.T "common.delete"}}</button>
        <button type="button" class="btn btn-ghost btn-sm" @click="confirming = false">{{.T "common.cancel"}}</button>
      </div>
      <div class="toolbar" x-show="!confirming">
        <span>
          <button type="button" class="btn btn-danger-ghost" x-show="draft.id" @click="confirming = true">{{template "icon" "trash"}} {{.T "integrations.delete"}}</button>
        </span>
        <div class="row">
          <button type="button" class="btn btn-secondary" @click="$store.modal.dismiss()">{{.T "common.cancel"}}</button>
          <button type="submit" class="btn" :disabled="pending">
            <span x-text="draft.id ? (pending === 'save' ? $t('integrations.saving') : $t('common.save')) : (pending === 'save' ? $t('integrations.validating') : $t('integrations.create'))">{{.T "integrations.create"}}</span>
          </button>
        </div>
      </div>
    </form>
  </template>
  {{end}}
</main>
{{end}}
