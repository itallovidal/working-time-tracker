{{define "content"}}
<main class="page" x-data="projectIntegrations">
  {{template "project_head" .}}

  <div class="toolbar">
    <p class="muted">Ligue tarefas a issues do GitHub ou do GitLab. As credenciais são validadas na plataforma e guardadas criptografadas.</p>
    {{if .IsAdmin}}
    <button type="button" class="btn" x-show="!creating" @click="openCreate()">Nova integração</button>
    {{end}}
  </div>

  {{if .IsAdmin}}
  <form class="card" x-cloak x-show="creating" @submit.prevent="create()">
    <div class="card-head"><h2>Nova integração</h2></div>
    <div class="fields">
      <div class="field">
        <label for="int-type">Plataforma</label>
        <select id="int-type" x-model="draft.type" @change="draft.config = {}">
          <template x-for="t in types" :key="t.value">
            <option :value="t.value" x-text="t.label" :selected="t.value === draft.type"></option>
          </template>
        </select>
      </div>
      <div class="field">
        <label for="int-name">Nome</label>
        <input id="int-name" type="text" required placeholder="Ex.: Repositório do app" x-model="draft.display_name" x-ref="name">
      </div>
    </div>
    <div class="fields">
      <template x-for="f in fieldsFor(draft.type)" :key="draft.type + f.key">
        <div class="field">
          <label :for="'int-' + f.key" x-text="f.label"></label>
          <input :id="'int-' + f.key" :type="f.type" required autocomplete="off" :placeholder="f.placeholder || ''" x-model="draft.config[f.key]">
          <span class="hint" x-show="f.hint" x-text="f.hint"></span>
        </div>
      </template>
    </div>
    <p class="form-error" x-show="errors.create" x-text="errors.create" role="alert"></p>
    <div class="row row-end">
      <button type="button" class="btn btn-secondary" @click="creating = false">Cancelar</button>
      <button type="submit" class="btn" :disabled="pending">
        <span x-text="pending === 'create' ? 'Validando credenciais…' : 'Criar integração'">Criar integração</span>
      </button>
    </div>
  </form>
  {{end}}

  <p class="muted" x-show="loading">Carregando integrações…</p>
  <p class="form-error" x-cloak x-show="errors.load" x-text="errors.load"></p>

  <div class="empty" x-cloak x-show="!loading && !errors.load && items.length === 0">
    <strong>Nenhuma integração</strong>
    {{if .IsAdmin}}
    <span>Crie uma para vincular tarefas a issues e ver o estado delas aqui.</span>
    {{else}}
    <span>Um admin pode configurar o GitHub ou o GitLab deste projeto.</span>
    {{end}}
  </div>

  <div class="grid-2" x-show="items.length > 0">
    <template x-for="it in items" :key="it.id">
      <section class="card">
        <div class="card-head">
          <div class="stack stack-tight">
            <h2 x-text="it.display_name"></h2>
            <div class="row row-tight">
              <span class="badge badge-accent" x-text="typeLabel(it.type)"></span>
              <span class="badge" :class="it.enabled ? 'badge-ok' : ''" x-text="it.enabled ? 'Ativa' : 'Desativada'"></span>
            </div>
          </div>
          {{if .IsAdmin}}
          <div class="row" x-show="editing !== it.id && confirming !== it.id">
            <button type="button" class="btn btn-ghost btn-sm" :disabled="pending" @click="toggle(it)" x-text="it.enabled ? 'Desativar' : 'Ativar'"></button>
            <button type="button" class="btn btn-ghost btn-sm" @click="startEdit(it)">Editar</button>
            <button type="button" class="btn btn-danger-ghost btn-sm" @click="confirming = it.id">Excluir</button>
          </div>
          {{end}}
        </div>

        <dl class="facts">
          <dt>Credencial</dt>
          <dd class="mono" x-text="it.has_config ? '••••••••••••' : 'não configurada'"></dd>
          <dt>Criada em</dt>
          <dd x-text="WTT.fmt.date(it.created_at)"></dd>
        </dl>

        {{if .IsAdmin}}
        <div class="confirm" x-cloak x-show="confirming === it.id">
          <span>Excluir? As tarefas vinculadas perdem o vínculo.</span>
          <button type="button" class="btn btn-danger btn-sm" :disabled="pending" @click="remove(it)">Excluir</button>
          <button type="button" class="btn btn-ghost btn-sm" @click="confirming = null">Cancelar</button>
        </div>

        <form class="stack" x-cloak x-show="editing === it.id" @submit.prevent="saveEdit(it)">
          <hr class="divider">
          <div class="field">
            <label :for="'edit-name-' + it.id">Nome</label>
            <input :id="'edit-name-' + it.id" type="text" required x-model="editDraft.display_name">
          </div>
          <p class="muted small">Para trocar a credencial, preencha todos os campos abaixo. Vazios mantêm a atual.</p>
          <template x-for="f in fieldsFor(it.type)" :key="it.id + f.key">
            <div class="field">
              <label :for="'edit-' + it.id + f.key" x-text="f.label"></label>
              <input :id="'edit-' + it.id + f.key" :type="f.type" autocomplete="off" :placeholder="f.placeholder || ''" x-model="editDraft.config[f.key]">
            </div>
          </template>
          <div class="row row-end">
            <button type="button" class="btn btn-secondary btn-sm" @click="editing = null">Cancelar</button>
            <button type="submit" class="btn btn-sm" :disabled="pending">Salvar</button>
          </div>
        </form>
        {{end}}
        <p class="form-error" x-show="errors['item-' + it.id]" x-text="errors['item-' + it.id]" role="alert"></p>
      </section>
    </template>
  </div>
</main>
{{end}}
