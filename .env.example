# Porta HTTP do servidor
API_PORT=8080

# Banco de desenvolvimento (o docker-compose.yml sobe este Postgres)
DATABASE_URL=postgres://wtt:wtt@localhost:5432/working_time_tracker?sslmode=disable

# Banco usado por `go test` (criado pelo docker-compose.yml). O nome precisa terminar
# em _test: cada pacote de teste apaga o schema dele e aplica as migrações de novo.
TEST_DATABASE_URL=postgres://wtt:wtt@localhost:5432/working_time_tracker_test?sslmode=disable

# Chave usada para criptografar as credenciais das integrações (AES-GCM).
# Gere uma com: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria

# Marca o cookie de sessão como Secure. Use true em produção (HTTPS).
COOKIE_SECURE=false

# Conectar com o GitHub (opcional): o OAuth App cadastrado em github.com/settings/developers.
# PUBLIC_URL é o endereço em que as pessoas abrem o sistema, sem barra no fim; no GitHub, a
# "Authorization callback URL" do app é PUBLIC_URL + /integrations/github/callback.
# Sem estas três, o botão "Conectar com o GitHub" avisa que não está configurado.
PUBLIC_URL=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Só para um GitHub Enterprise (ou um servidor fake). Os padrões são github.com e api.github.com.
# GITHUB_URL=https://github.com
# GITHUB_API_URL=https://api.github.com
