# Porta HTTP do servidor
API_PORT=8080

# Banco de desenvolvimento (o docker-compose.yml sobe este Postgres)
DATABASE_URL=postgres://wtt:wtt@localhost:5432/working_time_tracker?sslmode=disable

# Banco usado por `go test` (criado pelo docker-compose.yml). O nome precisa terminar
# em _test: cada pacote de teste apaga o schema dele e aplica as migrações de novo.
TEST_DATABASE_URL=postgres://wtt:wtt@localhost:5432/working_time_tracker_test?sslmode=disable

# Chave usada para criptografar as credenciais das integrações (AES-GCM).
# Gere uma com: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria

# Marca o cookie de sessão como Secure. Use true em produção (HTTPS).
COOKIE_SECURE=false

# Conectar com o GitHub (opcional): o OAuth App cadastrado em github.com/settings/developers.
# PUBLIC_URL é o endereço em que as pessoas abrem o sistema, sem barra no fim; no GitHub, a
# "Authorization callback URL" do app é PUBLIC_URL + /integrations/github/callback.
# Sem estas três, o botão "Conectar com o GitHub" avisa que não está configurado.
PUBLIC_URL=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Só para um GitHub Enterprise (ou um servidor fake). Os padrões são github.com e api.github.com.
# GITHUB_URL=https://github.com
# GITHUB_API_URL=https://api.github.com
# Conectar com o Trello (opcional): a chave de API do app, criada em trello.com/power-ups/admin (aba API key).
# Usa o mesmo PUBLIC_URL; se o Trello recusar o endereço de retorno, acrescente PUBLIC_URL em "Allowed origins"
# da chave. Sem a chave, o botão "Conectar com o Trello" avisa que não está configurado.
TRELLO_API_KEY=
# O nome que a tela de autorização do Trello mostra (o padrão é Working Time Tracker).
# TRELLO_APP_NAME=Working Time Tracker
# Só para um servidor fake. Os padrões são trello.com e api.trello.com/1.
# TRELLO_URL=https://trello.com
# TRELLO_API_URL=https://api.trello.com/1

# De quanto em quanto tempo o servidor olha as integrações com a sincronização ligada (5m, 30s...). O padrão é
# 5m; 0 desliga a rotina (o botão Sincronizar agora e o aviso das tarefas seguem valendo). SYNC_INTERVAL vale
# para todas as plataformas; GITHUB_SYNC_INTERVAL e TRELLO_SYNC_INTERVAL valem só para a delas, sobre o comum.
# SYNC_INTERVAL=5m
# GITHUB_SYNC_INTERVAL=5m
# TRELLO_SYNC_INTERVAL=5m

# Entrar pelo Clerk (opcional): as duas chaves do app, em dashboard.clerk.com (API keys) ou com `clerk env pull`.
# Sem elas o login é só por email e senha. Com elas o PUBLIC_URL é obrigatório: o Clerk volta para ele.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# As origens cujas sessões do Clerk o servidor aceita, separadas por vírgula (esquema, endereço e porta, sem
# barra). O padrão é a origem do PUBLIC_URL; liste mais de uma se o sistema sobe em mais de uma porta.
# CLERK_AUTHORIZED_PARTIES=http://localhost:8080
# O convite com email sai pelo Clerk (email, o padrão). Em desenvolvimento, terminal não manda o email e escreve o
# link do convite no log do servidor. Sem o Clerk o convite é só o link e isto não vale nada.
# INVITE_DELIVERY=terminal
# Só para um servidor fake: a Backend API do Clerk, sem o /v1. O padrão é https://api.clerk.com.
# CLERK_API_URL=
